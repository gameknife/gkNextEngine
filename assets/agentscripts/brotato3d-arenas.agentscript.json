{
  "name": "brotato3d-arenas",
  "target": "Brotato3D",
  "defaults": { "waitFrames": 2, "stepTimeoutMs": 60000 },
  "steps": [
    { "type": "wait-until", "query": "engine.status", "op": "eq", "value": "Running", "timeoutMs": 30000 },
    { "type": "wait-until", "query": "game.sceneReady", "op": "eq", "value": true, "timeoutMs": 60000 },
    { "type": "cvar", "name": "brotato3d.validation.god", "set": true },
    { "type": "cvar", "name": "brotato3d.validation.pauseWaves", "set": true },
    { "type": "cvar", "name": "brotato3d.validation.autoUpgrade", "set": true },

    { "type": "log", "message": "town: the street at the spawn, in daylight" },
    { "type": "cvar", "name": "brotato3d.validation.start", "set": true },
    { "type": "wait-until", "query": "game.state", "op": "eq", "value": "playing", "timeoutMs": 10000 },
    { "type": "cvar", "name": "brotato3d.validation.horde", "set": true },
    { "type": "key", "code": "W", "action": "down" },
    { "type": "wait-ms", "ms": 2500 },
    { "type": "key", "code": "W", "action": "up" },
    { "type": "wait-ms", "ms": 1500 },
    { "type": "screenshot", "out": "screenshots/brotato3d_arena_town", "ui": true },

    { "type": "log", "message": "outskirts" },
    { "type": "cvar", "name": "brotato3d.validation.arena", "set": "deadly_outskirts" },
    { "type": "wait-ms", "ms": 800 },
    { "type": "wait-until", "query": "game.sceneReady", "op": "eq", "value": true, "timeoutMs": 60000 },
    { "type": "assert", "query": "game.arena", "op": "eq", "value": "deadly_outskirts" },
    { "type": "cvar", "name": "brotato3d.validation.start", "set": true },
    { "type": "wait-until", "query": "game.state", "op": "eq", "value": "playing", "timeoutMs": 10000 },
    { "type": "cvar", "name": "brotato3d.validation.horde", "set": true },
    { "type": "key", "code": "D", "action": "down" },
    { "type": "wait-ms", "ms": 2500 },
    { "type": "key", "code": "D", "action": "up" },
    { "type": "wait-ms", "ms": 1500 },
    { "type": "screenshot", "out": "screenshots/brotato3d_arena_outskirts", "ui": true },
    { "type": "assert", "query": "game.zombieBodies", "op": "ge", "value": 30 },

    { "type": "log", "message": "desert" },
    { "type": "cvar", "name": "brotato3d.validation.arena", "set": "deadly_desert" },
    { "type": "wait-ms", "ms": 800 },
    { "type": "wait-until", "query": "game.sceneReady", "op": "eq", "value": true, "timeoutMs": 60000 },
    { "type": "assert", "query": "game.arena", "op": "eq", "value": "deadly_desert" },
    { "type": "cvar", "name": "brotato3d.validation.start", "set": true },
    { "type": "wait-until", "query": "game.state", "op": "eq", "value": "playing", "timeoutMs": 10000 },
    { "type": "cvar", "name": "brotato3d.validation.horde", "set": true },
    { "type": "key", "code": "A", "action": "down" },
    { "type": "wait-ms", "ms": 2500 },
    { "type": "key", "code": "A", "action": "up" },
    { "type": "wait-ms", "ms": 1500 },
    { "type": "screenshot", "out": "screenshots/brotato3d_arena_desert", "ui": true },
    { "type": "assert", "query": "game.zombieBodies", "op": "ge", "value": 30 },
    { "type": "quit" }
  ]
}

{
  "name": "brotato3d-zombies",
  "target": "Brotato3D",
  "defaults": { "waitFrames": 2, "stepTimeoutMs": 30000 },
  "steps": [
    { "type": "wait-until", "query": "engine.status", "op": "eq", "value": "Running", "timeoutMs": 30000 },
    { "type": "wait-until", "query": "game.sceneReady", "op": "eq", "value": true, "timeoutMs": 60000 },
    { "type": "cvar", "name": "brotato3d.validation.god", "set": true },
    { "type": "cvar", "name": "brotato3d.validation.pauseWaves", "set": true },
    { "type": "cvar", "name": "brotato3d.validation.autoUpgrade", "set": true },
    { "type": "cvar", "name": "brotato3d.validation.holdFire", "set": true },
    { "type": "cvar", "name": "brotato3d.validation.freeze", "set": true },
    { "type": "cvar", "name": "brotato3d.validation.start", "set": true },
    { "type": "wait-until", "query": "game.state", "op": "eq", "value": "playing", "timeoutMs": 10000 },

    { "type": "log", "message": "the hero, close up" },
    { "type": "cvar", "name": "brotato3d.validation.cameraHeight", "set": 1.4 },
    { "type": "cvar", "name": "brotato3d.validation.cameraBack", "set": 3.6 },
    { "type": "wait-ms", "ms": 600 },
    { "type": "screenshot", "out": "screenshots/brotato3d_hero" },

    { "type": "log", "message": "every zombie type, close up" },
    { "type": "cvar", "name": "brotato3d.validation.lineup", "set": true },
    { "type": "wait-until", "query": "game.enemiesAlive", "op": "ge", "value": 9 },
    { "type": "assert", "query": "game.zombieBodies", "op": "ge", "value": 9 },
    { "type": "cvar", "name": "brotato3d.validation.cameraHeight", "set": 3.6 },
    { "type": "cvar", "name": "brotato3d.validation.cameraBack", "set": 8.5 },
    { "type": "wait-ms", "ms": 900 },
    { "type": "screenshot", "out": "screenshots/brotato3d_zombie_lineup" },

    { "type": "log", "message": "dismemberment: a limb off each, legless ones crawl" },
    { "type": "cvar", "name": "brotato3d.validation.sever", "set": true },
    { "type": "wait-ms", "ms": 350 },
    { "type": "screenshot", "out": "screenshots/brotato3d_zombie_sever_air" },
    { "type": "assert", "query": "game.severedLimbs", "op": "ge", "value": 5 },
    { "type": "assert", "query": "game.crawlers", "op": "ge", "value": 1 },
    { "type": "wait-ms", "ms": 1200 },
    { "type": "screenshot", "out": "screenshots/brotato3d_zombie_severed" },

    { "type": "log", "message": "a fight under the gameplay camera" },
    { "type": "cvar", "name": "brotato3d.validation.clear", "set": true },
    { "type": "cvar", "name": "brotato3d.validation.cameraHeight", "set": 0 },
    { "type": "cvar", "name": "brotato3d.validation.freeze", "set": false },
    { "type": "cvar", "name": "brotato3d.validation.holdFire", "set": false },
    { "type": "cvar", "name": "brotato3d.validation.horde", "set": true },
    { "type": "key", "code": "D", "action": "down" },
    { "type": "wait-ms", "ms": 1600 },
    { "type": "screenshot", "out": "screenshots/brotato3d_fight", "ui": true },
    { "type": "assert", "query": "game.playerSpeed", "op": "ge", "value": 2.0 },
    { "type": "key", "code": "D", "action": "up" },
    { "type": "wait-ms", "ms": 4500 },
    { "type": "screenshot", "out": "screenshots/brotato3d_fight_later" },
    { "type": "assert", "query": "game.kills", "op": "ge", "value": 1 },

    { "type": "log", "message": "the three deaths: shot, headshot, blown apart" },
    { "type": "cvar", "name": "brotato3d.validation.holdFire", "set": true },
    { "type": "cvar", "name": "brotato3d.validation.horde", "set": true },
    { "type": "wait-ms", "ms": 400 },
    { "type": "cvar", "name": "brotato3d.validation.killAll", "set": true },
    { "type": "wait-ms", "ms": 500 },
    { "type": "screenshot", "out": "screenshots/brotato3d_deaths" },
    { "type": "assert", "query": "game.enemiesAlive", "op": "eq", "value": 0 },
    { "type": "assert", "query": "game.corpses", "op": "ge", "value": 10 },
    { "type": "quit" }
  ]
}

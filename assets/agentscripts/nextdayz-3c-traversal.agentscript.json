{
  "name": "nextdayz-3c-traversal",
  "target": "NextDayz",
  "scene": "assets/agentscripts/fixtures/nextdayz-traversal.scad",
  "defaults": { "waitFrames": 2, "stepTimeoutMs": 20000 },
  "viewport": { "width": 1600, "height": 900 },
  "steps": [
    { "type": "wait-until", "query": "engine.status", "op": "eq", "value": "Running", "timeoutMs": 20000 },
    { "type": "wait-until", "query": "game.sceneReady", "op": "eq", "value": true, "timeoutMs": 30000 },
    { "type": "cvar", "name": "nextdayz.validation.loadout", "set": true },
    { "type": "cvar", "name": "nextdayz.debug.freezeNeeds", "set": true },
    { "type": "cvar", "name": "nextdayz.debug.zombieTimeScale", "set": 0 },
    { "type": "cvar", "name": "nextdayz.validation.thirdPerson", "set": true },
    { "type": "cvar", "name": "nextdayz.validation.lookYaw", "set": 0 },
    { "type": "cvar", "name": "nextdayz.validation.lookPitch", "set": 0 },
    { "type": "cvar", "name": "nextdayz.debug.orbitDistance", "set": 3.6 },
    { "type": "cvar", "name": "nextdayz.debug.orbitHeight", "set": 1.2 },
    { "type": "wait-frames", "n": 30 },

    { "type": "log", "message": "Vault: a waist-high thin wall is vaulted on the run, the run carries on" },
    { "type": "cvar", "name": "nextdayz.validation.teleport", "set": "0,-1.6" },
    { "type": "wait-ms", "ms": 1000 },
    { "type": "key", "code": "W", "action": "down" },
    { "type": "wait-ms", "ms": 300 },
    { "type": "key", "code": "SPACE", "action": "press" },
    { "type": "wait-until", "query": "game.traversalAction", "op": "eq", "value": "vault", "timeoutMs": 3000 },
    { "type": "assert", "query": "game.traversalProbe", "op": "contains", "value": "accepted:vault" },
    { "type": "assert", "query": "game.baseAnim", "op": "eq", "value": "vault" },
    { "type": "wait-until", "query": "game.traversalTime", "op": "gt", "value": 0.42, "timeoutMs": 1500 },
    { "type": "cvar", "name": "nextdayz.debug.freeze", "set": true },
    { "type": "cvar", "name": "nextdayz.debug.orbit", "set": true },
    { "type": "cvar", "name": "nextdayz.debug.orbitYaw", "set": 70 },
    { "type": "wait-frames", "n": 4 },
    { "type": "screenshot", "out": "screenshots/nextdayz_traversal_vault" },
    { "type": "cvar", "name": "nextdayz.debug.orbit", "set": false },
    { "type": "cvar", "name": "nextdayz.debug.freeze", "set": false },
    { "type": "wait-until", "query": "game.traversalAction", "op": "eq", "value": "none", "timeoutMs": 5000 },
    { "type": "assert", "query": "game.horizontalSpeed", "op": "gt", "value": 1.5 },
    { "type": "key", "code": "W", "action": "up" },
    { "type": "assert", "query": "game.posZ", "op": "gt", "value": 4.6 },
    { "type": "assert", "query": "game.posY", "op": "lt", "value": 0.3 },

    { "type": "log", "message": "Mantle: palm and fist on a chest-high top, press, knee over, stand" },
    { "type": "cvar", "name": "nextdayz.validation.teleport", "set": "4.75,-2.6" },
    { "type": "wait-ms", "ms": 1000 },
    { "type": "key", "code": "W", "action": "down" },
    { "type": "wait-ms", "ms": 300 },
    { "type": "key", "code": "SPACE", "action": "press" },
    { "type": "wait-until", "query": "game.traversalAction", "op": "eq", "value": "mantle", "timeoutMs": 3000 },
    { "type": "key", "code": "W", "action": "up" },
    { "type": "assert", "query": "game.traversalProbe", "op": "contains", "value": "accepted:mantle" },
    { "type": "wait-until", "query": "game.traversalTime", "op": "gt", "value": 0.46, "timeoutMs": 1500 },
    { "type": "cvar", "name": "nextdayz.debug.freeze", "set": true },
    { "type": "assert", "query": "game.plantError", "op": "lt", "value": 0.05 },
    { "type": "cvar", "name": "nextdayz.debug.orbit", "set": true },
    { "type": "cvar", "name": "nextdayz.debug.orbitYaw", "set": 70 },
    { "type": "wait-frames", "n": 4 },
    { "type": "screenshot", "out": "screenshots/nextdayz_traversal_mantle" },
    { "type": "cvar", "name": "nextdayz.debug.orbit", "set": false },
    { "type": "cvar", "name": "nextdayz.debug.freeze", "set": false },
    { "type": "wait-until", "query": "game.traversalAction", "op": "eq", "value": "none", "timeoutMs": 5000 },
    { "type": "assert", "query": "game.posY", "op": "gt", "value": 1.2 },
    { "type": "assert", "query": "game.stance", "op": "eq", "value": "standing" },

    { "type": "log", "message": "Climb: a 2.2 m top is caught overhead and hauled over" },
    { "type": "cvar", "name": "nextdayz.validation.teleport", "set": "9.5,-2.6" },
    { "type": "wait-ms", "ms": 1000 },
    { "type": "key", "code": "W", "action": "down" },
    { "type": "wait-ms", "ms": 300 },
    { "type": "key", "code": "SPACE", "action": "press" },
    { "type": "wait-until", "query": "game.traversalAction", "op": "eq", "value": "climb", "timeoutMs": 3000 },
    { "type": "key", "code": "W", "action": "up" },
    { "type": "assert", "query": "game.traversalProbe", "op": "contains", "value": "accepted:climb" },
    { "type": "wait-until", "query": "game.traversalTime", "op": "gt", "value": 0.40, "timeoutMs": 2000 },
    { "type": "cvar", "name": "nextdayz.debug.freeze", "set": true },
    { "type": "assert", "query": "game.plantError", "op": "lt", "value": 0.05 },
    { "type": "cvar", "name": "nextdayz.debug.orbit", "set": true },
    { "type": "cvar", "name": "nextdayz.debug.orbitYaw", "set": 65 },
    { "type": "wait-frames", "n": 4 },
    { "type": "screenshot", "out": "screenshots/nextdayz_traversal_climb_hang" },
    { "type": "cvar", "name": "nextdayz.debug.freeze", "set": false },
    { "type": "wait-until", "query": "game.traversalTime", "op": "gt", "value": 0.74, "timeoutMs": 2000 },
    { "type": "cvar", "name": "nextdayz.debug.freeze", "set": true },
    { "type": "wait-frames", "n": 4 },
    { "type": "screenshot", "out": "screenshots/nextdayz_traversal_climb_press" },
    { "type": "cvar", "name": "nextdayz.debug.orbit", "set": false },
    { "type": "cvar", "name": "nextdayz.debug.freeze", "set": false },
    { "type": "wait-until", "query": "game.traversalAction", "op": "eq", "value": "none", "timeoutMs": 5000 },
    { "type": "assert", "query": "game.posY", "op": "gt", "value": 2.1 },

    { "type": "log", "message": "Climb over: a 2 m fence is crossed, dropping to the far side" },
    { "type": "cvar", "name": "nextdayz.validation.teleport", "set": "16,-2.6" },
    { "type": "wait-ms", "ms": 1000 },
    { "type": "key", "code": "W", "action": "down" },
    { "type": "wait-ms", "ms": 300 },
    { "type": "key", "code": "SPACE", "action": "press" },
    { "type": "wait-until", "query": "game.traversalAction", "op": "eq", "value": "climb_over", "timeoutMs": 3000 },
    { "type": "key", "code": "W", "action": "up" },
    { "type": "assert", "query": "game.traversalProbe", "op": "contains", "value": "accepted:climb_over" },
    { "type": "wait-until", "query": "game.traversalTime", "op": "gt", "value": 0.74, "timeoutMs": 2000 },
    { "type": "cvar", "name": "nextdayz.debug.freeze", "set": true },
    { "type": "cvar", "name": "nextdayz.debug.orbit", "set": true },
    { "type": "cvar", "name": "nextdayz.debug.orbitYaw", "set": 65 },
    { "type": "wait-frames", "n": 4 },
    { "type": "screenshot", "out": "screenshots/nextdayz_traversal_climb_over" },
    { "type": "cvar", "name": "nextdayz.debug.orbit", "set": false },
    { "type": "cvar", "name": "nextdayz.debug.freeze", "set": false },
    { "type": "wait-until", "query": "game.traversalAction", "op": "eq", "value": "none", "timeoutMs": 5000 },
    { "type": "wait-until", "query": "game.onGround", "op": "eq", "value": true, "timeoutMs": 3000 },
    { "type": "assert", "query": "game.posZ", "op": "gt", "value": 4.4 },
    { "type": "assert", "query": "game.posY", "op": "lt", "value": 0.3 },

    { "type": "log", "message": "Climb over: a 1.4 m wall, too high to vault, is hopped and swung over" },
    { "type": "cvar", "name": "nextdayz.validation.teleport", "set": "21,-2.6" },
    { "type": "wait-ms", "ms": 1000 },
    { "type": "key", "code": "W", "action": "down" },
    { "type": "wait-ms", "ms": 300 },
    { "type": "key", "code": "SPACE", "action": "press" },
    { "type": "wait-until", "query": "game.traversalAction", "op": "eq", "value": "climb_over", "timeoutMs": 3000 },
    { "type": "key", "code": "W", "action": "up" },
    { "type": "wait-until", "query": "game.traversalAction", "op": "eq", "value": "none", "timeoutMs": 5000 },
    { "type": "wait-until", "query": "game.onGround", "op": "eq", "value": true, "timeoutMs": 3000 },
    { "type": "assert", "query": "game.posZ", "op": "gt", "value": 4.4 },

    { "type": "log", "message": "Eave: the roof lip overhangs the wall by 0.5 m; it is caught and climbed onto" },
    { "type": "cvar", "name": "nextdayz.validation.teleport", "set": "-7,-2.3" },
    { "type": "wait-ms", "ms": 1000 },
    { "type": "key", "code": "W", "action": "down" },
    { "type": "wait-ms", "ms": 250 },
    { "type": "key", "code": "SPACE", "action": "press" },
    { "type": "wait-until", "query": "game.traversalAction", "op": "eq", "value": "climb", "timeoutMs": 3000 },
    { "type": "key", "code": "W", "action": "up" },
    { "type": "assert", "query": "game.traversalProbe", "op": "contains", "value": "accepted:climb" },
    { "type": "assert", "query": "game.traversalHeight", "op": "gt", "value": 2.4 },
    { "type": "wait-until", "query": "game.traversalTime", "op": "gt", "value": 0.42, "timeoutMs": 2000 },
    { "type": "cvar", "name": "nextdayz.debug.freeze", "set": true },
    { "type": "assert", "query": "game.plantError", "op": "lt", "value": 0.05 },
    { "type": "cvar", "name": "nextdayz.debug.orbit", "set": true },
    { "type": "cvar", "name": "nextdayz.debug.orbitYaw", "set": 60 },
    { "type": "wait-frames", "n": 4 },
    { "type": "screenshot", "out": "screenshots/nextdayz_traversal_eave" },
    { "type": "cvar", "name": "nextdayz.debug.orbit", "set": false },
    { "type": "cvar", "name": "nextdayz.debug.freeze", "set": false },
    { "type": "wait-until", "query": "game.traversalAction", "op": "eq", "value": "none", "timeoutMs": 5000 },
    { "type": "assert", "query": "game.posY", "op": "gt", "value": 2.5 },

    { "type": "log", "message": "Eave from underneath: walked up to the wall, the lip is over the head; still climbed" },
    { "type": "cvar", "name": "nextdayz.validation.teleport", "set": "-6,-2.9" },
    { "type": "wait-ms", "ms": 1000 },
    { "type": "key", "code": "W", "action": "down" },
    { "type": "wait-ms", "ms": 700 },
    { "type": "key", "code": "W", "action": "up" },
    { "type": "wait-ms", "ms": 400 },
    { "type": "assert", "query": "game.posZ", "op": "gt", "value": 3.55 },
    { "type": "key", "code": "SPACE", "action": "press" },
    { "type": "wait-until", "query": "game.traversalAction", "op": "eq", "value": "climb", "timeoutMs": 3000 },
    { "type": "assert", "query": "game.traversalProbe", "op": "contains", "value": "accepted:climb" },
    { "type": "wait-until", "query": "game.traversalTime", "op": "gt", "value": 0.40, "timeoutMs": 2000 },
    { "type": "cvar", "name": "nextdayz.debug.freeze", "set": true },
    { "type": "assert", "query": "game.plantError", "op": "lt", "value": 0.05 },
    { "type": "cvar", "name": "nextdayz.debug.orbit", "set": true },
    { "type": "cvar", "name": "nextdayz.debug.orbitYaw", "set": 75 },
    { "type": "wait-frames", "n": 4 },
    { "type": "screenshot", "out": "screenshots/nextdayz_traversal_eave_under" },
    { "type": "cvar", "name": "nextdayz.debug.orbit", "set": false },
    { "type": "cvar", "name": "nextdayz.debug.freeze", "set": false },
    { "type": "wait-until", "query": "game.traversalAction", "op": "eq", "value": "none", "timeoutMs": 5000 },
    { "type": "assert", "query": "game.posY", "op": "gt", "value": 2.5 },

    { "type": "log", "message": "Out of reach: a 3.6 m wall stays a plain jump" },
    { "type": "cvar", "name": "nextdayz.validation.teleport", "set": "-12,-9.9" },
    { "type": "wait-ms", "ms": 1000 },
    { "type": "key", "code": "W", "action": "down" },
    { "type": "wait-ms", "ms": 200 },
    { "type": "key", "code": "SPACE", "action": "down" },
    { "type": "wait-ms", "ms": 900 },
    { "type": "key", "code": "SPACE", "action": "up" },
    { "type": "key", "code": "W", "action": "up" },
    { "type": "assert", "query": "game.traversalAction", "op": "eq", "value": "none" },
    { "type": "assert", "query": "game.traversalProbe", "op": "contains", "value": "rejected" },
    { "type": "wait-until", "query": "game.onGround", "op": "eq", "value": true, "timeoutMs": 3000 },
    { "type": "assert", "query": "game.posY", "op": "lt", "value": 0.3 },

    { "type": "log", "message": "Air catch: jump pressed too far from a 1.9 m ledge still grabs it on the way" },
    { "type": "cvar", "name": "nextdayz.validation.teleport", "set": "9.5,-7.4" },
    { "type": "wait-ms", "ms": 1000 },
    { "type": "key", "code": "W", "action": "down" },
    { "type": "wait-ms", "ms": 250 },
    { "type": "key", "code": "SPACE", "action": "down" },
    { "type": "wait-until", "query": "game.traversalProbe", "op": "contains", "value": "air:accepted", "timeoutMs": 3000 },
    { "type": "key", "code": "SPACE", "action": "up" },
    { "type": "key", "code": "W", "action": "up" },
    { "type": "wait-until", "query": "game.traversalAction", "op": "eq", "value": "none", "timeoutMs": 5000 },
    { "type": "assert", "query": "game.posY", "op": "gt", "value": 1.8 },

    { "type": "log", "message": "Crawl space: a top with 1.5 m of headroom is mantled into a crouch" },
    { "type": "cvar", "name": "nextdayz.validation.teleport", "set": "15.5,-9.6" },
    { "type": "wait-ms", "ms": 1000 },
    { "type": "key", "code": "W", "action": "down" },
    { "type": "wait-ms", "ms": 300 },
    { "type": "key", "code": "SPACE", "action": "press" },
    { "type": "wait-until", "query": "game.traversalAction", "op": "eq", "value": "mantle", "timeoutMs": 3000 },
    { "type": "key", "code": "W", "action": "up" },
    { "type": "wait-until", "query": "game.traversalAction", "op": "eq", "value": "none", "timeoutMs": 5000 },
    { "type": "assert", "query": "game.posY", "op": "gt", "value": 1.1 },
    { "type": "assert", "query": "game.stance", "op": "eq", "value": "crouched" },

    { "type": "log", "message": "First person: the camera follows the body over a mantle with the weapon tucked" },
    { "type": "cvar", "name": "nextdayz.validation.thirdPerson", "set": false },
    { "type": "cvar", "name": "nextdayz.validation.teleport", "set": "4.75,-2.6" },
    { "type": "wait-ms", "ms": 1000 },
    { "type": "key", "code": "W", "action": "down" },
    { "type": "wait-ms", "ms": 300 },
    { "type": "key", "code": "SPACE", "action": "press" },
    { "type": "wait-until", "query": "game.traversalAction", "op": "eq", "value": "mantle", "timeoutMs": 3000 },
    { "type": "key", "code": "W", "action": "up" },
    { "type": "wait-until", "query": "game.traversalTime", "op": "gt", "value": 0.46, "timeoutMs": 1500 },
    { "type": "cvar", "name": "nextdayz.debug.freeze", "set": true },
    { "type": "wait-frames", "n": 4 },
    { "type": "screenshot", "out": "screenshots/nextdayz_traversal_mantle_fps" },
    { "type": "cvar", "name": "nextdayz.debug.freeze", "set": false },
    { "type": "wait-until", "query": "game.traversalAction", "op": "eq", "value": "none", "timeoutMs": 5000 },

    { "type": "quit" }
  ]
}

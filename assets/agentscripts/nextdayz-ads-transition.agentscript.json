{
  "name": "nextdayz-ads-transition",
  "target": "NextDayz",
  "scene": "assets/scad/tests/nextdayz_ads.scad",
  "viewport": {"width": 1920, "height": 1080},
  "defaults": {"waitFrames": 2, "stepTimeoutMs": 20000},
  "args": ["--system-dpi-scaling"],
  "steps": [
    {"type":"wait-until","query":"game.sceneReady","op":"eq","value":true,"timeoutMs":30000},
    {"type":"cvar","name":"nextdayz.debug.freezeNeeds","set":true},
    {"type":"cvar","name":"nextdayz.validation.teleport","set":"0,0"},
    {"type":"cvar","name":"nextdayz.validation.lookYaw","set":0},
    {"type":"cvar","name":"nextdayz.validation.lookPitch","set":0},
    {"type":"cvar","name":"nextdayz.validation.loadout","set":true},
    {"type":"cvar","name":"nextdayz.validation.thirdPerson","set":true},
    {"type":"cvar","name":"nextdayz.debug.freeze","set":true},
    {"type":"cvar","name":"nextdayz.validation.use","set":""},
    {"type":"cvar","name":"nextdayz.validation.use","set":"ak"},
    {"type":"cvar","name":"nextdayz.debug.step","set":0},
    {"type":"cvar","name":"nextdayz.debug.step","set":60},
    {"type":"wait-frames","n":63},
    {"type":"assert","query":"game.viewBlend","op":"eq","value":0},
    {"type":"assert","query":"game.fpsArmParts","op":"eq","value":0},
    {"type":"assert","query":"game.playerRigVisible","op":"eq","value":true},
    {"type":"log","message":"A tapped ADS flies the shoulder camera into the eye on the AK's 0.20 s raise; the body hands over halfway"},
    {"type":"mouse-button","button":"right","action":"press"},
    {"type":"cvar","name":"nextdayz.debug.step","set":0},
    {"type":"cvar","name":"nextdayz.debug.step","set":3},
    {"type":"wait-frames","n":6},
    {"type":"assert","query":"game.firstPerson","op":"eq","value":true},
    {"type":"assert","query":"game.presentationFirstPerson","op":"eq","value":false},
    {"type":"assert","query":"game.playerRigVisible","op":"eq","value":true},
    {"type":"assert","query":"game.aimProgress","op":"gt","value":0.2},
    {"type":"assert","query":"game.aimProgress","op":"lt","value":0.3},
    {"type":"assert","query":"game.viewBlend","op":"gt","value":0.2},
    {"type":"assert","query":"game.viewBlend","op":"lt","value":0.3},
    {"type":"assert","query":"game.cameraFov","op":"lt","value":75},
    {"type":"assert","query":"game.cameraFov","op":"gt","value":64.5},
    {"type":"screenshot","out":"screenshots/nextdayz_ads_transition_flight_quarter"},
    {"type":"cvar","name":"nextdayz.debug.step","set":0},
    {"type":"cvar","name":"nextdayz.debug.step","set":6},
    {"type":"wait-frames","n":9},
    {"type":"assert","query":"game.presentationFirstPerson","op":"eq","value":true},
    {"type":"assert","query":"game.playerRigVisible","op":"eq","value":false},
    {"type":"assert","query":"game.viewModelVisible","op":"eq","value":true},
    {"type":"assert","query":"game.fpsArmParts","op":"ge","value":3},
    {"type":"assert","query":"game.fpsArmGripError","op":"lt","value":0.01},
    {"type":"assert","query":"game.aimProgress","op":"lt","value":1},
    {"type":"screenshot","out":"screenshots/nextdayz_ads_transition_flight_three_quarters"},
    {"type":"cvar","name":"nextdayz.debug.step","set":0},
    {"type":"cvar","name":"nextdayz.debug.step","set":30},
    {"type":"wait-frames","n":33},
    {"type":"assert","query":"game.aimProgress","op":"eq","value":1},
    {"type":"assert","query":"game.viewBlend","op":"eq","value":1},
    {"type":"assert","query":"game.cameraFov","op":"gt","value":63.9},
    {"type":"assert","query":"game.cameraFov","op":"lt","value":64.1},
    {"type":"assert","query":"game.adsSightCenterError","op":"lt","value":0.1},
    {"type":"assert","query":"game.adsSightAxisError","op":"lt","value":0.1},
    {"type":"assert","query":"game.fpsArmParts","op":"ge","value":3},
    {"type":"assert","query":"game.fpsArmGripError","op":"lt","value":0.01},
    {"type":"assert","query":"game.fpsArmRenderedError","op":"lt","value":0.001},
    {"type":"screenshot","out":"screenshots/nextdayz_ads_transition_ak_iron"},
    {"type":"log","message":"A second tap flies back out to the shoulder in the shared 0.15 s lowering time"},
    {"type":"mouse-button","button":"right","action":"press"},
    {"type":"cvar","name":"nextdayz.debug.step","set":0},
    {"type":"cvar","name":"nextdayz.debug.step","set":3},
    {"type":"wait-frames","n":6},
    {"type":"assert","query":"game.firstPerson","op":"eq","value":false},
    {"type":"assert","query":"game.viewBlend","op":"gt","value":0},
    {"type":"assert","query":"game.viewBlend","op":"lt","value":1},
    {"type":"cvar","name":"nextdayz.debug.step","set":0},
    {"type":"cvar","name":"nextdayz.debug.step","set":30},
    {"type":"wait-frames","n":33},
    {"type":"assert","query":"game.viewBlend","op":"eq","value":0},
    {"type":"assert","query":"game.aimProgress","op":"eq","value":0},
    {"type":"assert","query":"game.playerRigVisible","op":"eq","value":true},
    {"type":"assert","query":"game.fpsArmParts","op":"eq","value":0},
    {"type":"assert","query":"game.cameraFov","op":"gt","value":74.9},
    {"type":"log","message":"Held shoulder aim tightens the third-person camera and zooms modestly"},
    {"type":"assert","query":"game.cameraArmLength","op":"gt","value":1.7},
    {"type":"mouse-button","button":"right","action":"down"},
    {"type":"wait-ms","ms":300},
    {"type":"cvar","name":"nextdayz.debug.step","set":0},
    {"type":"cvar","name":"nextdayz.debug.step","set":30},
    {"type":"wait-frames","n":33},
    {"type":"assert","query":"game.adsMode","op":"eq","value":false},
    {"type":"assert","query":"game.firstPerson","op":"eq","value":false},
    {"type":"assert","query":"game.isAiming","op":"eq","value":true},
    {"type":"assert","query":"game.cameraArmLength","op":"lt","value":1.55},
    {"type":"assert","query":"game.cameraFov","op":"gt","value":61.9},
    {"type":"assert","query":"game.cameraFov","op":"lt","value":62.1},
    {"type":"screenshot","out":"screenshots/nextdayz_ads_transition_shoulder_aim"},
    {"type":"mouse-button","button":"right","action":"up"},
    {"type":"cvar","name":"nextdayz.debug.step","set":0},
    {"type":"cvar","name":"nextdayz.debug.step","set":30},
    {"type":"wait-frames","n":33},
    {"type":"assert","query":"game.cameraArmLength","op":"gt","value":1.7},
    {"type":"assert","query":"game.cameraFov","op":"gt","value":74.9},
    {"type":"log","message":"First-person hip fire: both hands on the gun"},
    {"type":"key","code":"v","action":"press"},
    {"type":"cvar","name":"nextdayz.debug.step","set":0},
    {"type":"cvar","name":"nextdayz.debug.step","set":30},
    {"type":"wait-frames","n":33},
    {"type":"assert","query":"game.firstPerson","op":"eq","value":true},
    {"type":"assert","query":"game.viewModelVisible","op":"eq","value":true},
    {"type":"assert","query":"game.fpsArmParts","op":"ge","value":3},
    {"type":"assert","query":"game.fpsArmGripError","op":"lt","value":0.01},
    {"type":"assert","query":"game.fpsArmRenderedError","op":"lt","value":0.001},
    {"type":"screenshot","out":"screenshots/nextdayz_ads_transition_fps_hip"},
    {"type":"cvar","name":"nextdayz.validation.give","set":""},
    {"type":"cvar","name":"nextdayz.validation.give","set":"pistol"},
    {"type":"cvar","name":"nextdayz.validation.use","set":""},
    {"type":"cvar","name":"nextdayz.validation.use","set":"pistol"},
    {"type":"cvar","name":"nextdayz.debug.step","set":0},
    {"type":"cvar","name":"nextdayz.debug.step","set":60},
    {"type":"wait-frames","n":63},
    {"type":"assert","query":"game.fpsArmParts","op":"ge","value":3},
    {"type":"assert","query":"game.fpsArmGripError","op":"lt","value":0.01},
    {"type":"mouse-button","button":"right","action":"press"},
    {"type":"cvar","name":"nextdayz.debug.step","set":0},
    {"type":"cvar","name":"nextdayz.debug.step","set":40},
    {"type":"wait-frames","n":43},
    {"type":"assert","query":"game.adsMode","op":"eq","value":true},
    {"type":"assert","query":"game.adsSightCenterError","op":"lt","value":0.1},
    {"type":"assert","query":"game.fpsArmGripError","op":"lt","value":0.01},
    {"type":"screenshot","out":"screenshots/nextdayz_ads_transition_pistol_ads"},
    {"type":"mouse-button","button":"right","action":"press"},
    {"type":"cvar","name":"nextdayz.debug.step","set":0},
    {"type":"cvar","name":"nextdayz.debug.step","set":30},
    {"type":"wait-frames","n":33},
    {"type":"cvar","name":"nextdayz.validation.give","set":""},
    {"type":"cvar","name":"nextdayz.validation.give","set":"shotgun"},
    {"type":"cvar","name":"nextdayz.validation.use","set":""},
    {"type":"cvar","name":"nextdayz.validation.use","set":"shotgun"},
    {"type":"cvar","name":"nextdayz.debug.step","set":0},
    {"type":"cvar","name":"nextdayz.debug.step","set":60},
    {"type":"wait-frames","n":63},
    {"type":"assert","query":"game.fpsArmParts","op":"ge","value":3},
    {"type":"assert","query":"game.fpsArmGripError","op":"lt","value":0.01},
    {"type":"mouse-button","button":"right","action":"press"},
    {"type":"cvar","name":"nextdayz.debug.step","set":0},
    {"type":"cvar","name":"nextdayz.debug.step","set":40},
    {"type":"wait-frames","n":43},
    {"type":"assert","query":"game.adsMode","op":"eq","value":true},
    {"type":"assert","query":"game.adsSightCenterError","op":"lt","value":0.1},
    {"type":"assert","query":"game.fpsArmGripError","op":"lt","value":0.01},
    {"type":"screenshot","out":"screenshots/nextdayz_ads_transition_shotgun_ads"},
    {"type":"mouse-button","button":"right","action":"press"},
    {"type":"cvar","name":"nextdayz.debug.step","set":0},
    {"type":"cvar","name":"nextdayz.debug.step","set":30},
    {"type":"wait-frames","n":33},
    {"type":"cvar","name":"nextdayz.validation.give","set":""},
    {"type":"cvar","name":"nextdayz.validation.give","set":"mosin"},
    {"type":"cvar","name":"nextdayz.validation.use","set":""},
    {"type":"cvar","name":"nextdayz.validation.use","set":"mosin"},
    {"type":"cvar","name":"nextdayz.debug.step","set":0},
    {"type":"cvar","name":"nextdayz.debug.step","set":60},
    {"type":"wait-frames","n":63},
    {"type":"assert","query":"game.fpsArmParts","op":"ge","value":3},
    {"type":"assert","query":"game.fpsArmGripError","op":"lt","value":0.01},
    {"type":"mouse-button","button":"right","action":"press"},
    {"type":"cvar","name":"nextdayz.debug.step","set":0},
    {"type":"cvar","name":"nextdayz.debug.step","set":40},
    {"type":"wait-frames","n":43},
    {"type":"assert","query":"game.adsMode","op":"eq","value":true},
    {"type":"assert","query":"game.adsSightCenterError","op":"lt","value":0.1},
    {"type":"assert","query":"game.fpsArmGripError","op":"lt","value":0.01},
    {"type":"screenshot","out":"screenshots/nextdayz_ads_transition_mosin_ads"},
    {"type":"mouse-button","button":"right","action":"press"},
    {"type":"cvar","name":"nextdayz.debug.step","set":0},
    {"type":"cvar","name":"nextdayz.debug.step","set":30},
    {"type":"wait-frames","n":33},
    {"type":"log","message":"A magnified optic: the housing closes in as the eye reaches the eyepiece, then the lens view replaces the tube"},
    {"type":"cvar","name":"nextdayz.validation.use","set":""},
    {"type":"cvar","name":"nextdayz.validation.use","set":"ak"},
    {"type":"cvar","name":"nextdayz.debug.step","set":0},
    {"type":"cvar","name":"nextdayz.debug.step","set":60},
    {"type":"wait-frames","n":63},
    {"type":"cvar","name":"nextdayz.validation.give","set":""},
    {"type":"cvar","name":"nextdayz.validation.give","set":"optic_4x"},
    {"type":"cvar","name":"nextdayz.validation.attachment","set":""},
    {"type":"cvar","name":"nextdayz.validation.attachment","set":"1:optic_4x"},
    {"type":"cvar","name":"nextdayz.debug.step","set":0},
    {"type":"cvar","name":"nextdayz.debug.step","set":30},
    {"type":"wait-frames","n":33},
    {"type":"mouse-button","button":"right","action":"press"},
    {"type":"cvar","name":"nextdayz.debug.step","set":0},
    {"type":"cvar","name":"nextdayz.debug.step","set":11},
    {"type":"wait-frames","n":14},
    {"type":"assert","query":"game.scopeBlend","op":"gt","value":0},
    {"type":"assert","query":"game.scopeBlend","op":"lt","value":1},
    {"type":"screenshot","out":"screenshots/nextdayz_ads_transition_scope_closing"},
    {"type":"cvar","name":"nextdayz.debug.step","set":0},
    {"type":"cvar","name":"nextdayz.debug.step","set":30},
    {"type":"wait-frames","n":33},
    {"type":"assert","query":"game.scopeBlend","op":"eq","value":1},
    {"type":"assert","query":"game.scopeView","op":"eq","value":true},
    {"type":"assert","query":"game.viewModelVisible","op":"eq","value":false},
    {"type":"assert","query":"game.fpsArmParts","op":"eq","value":0},
    {"type":"assert","query":"game.cameraFov","op":"gt","value":21.9},
    {"type":"assert","query":"game.cameraFov","op":"lt","value":22.1},
    {"type":"screenshot","out":"screenshots/nextdayz_ads_transition_scope_4x"},
    {"type":"mouse-button","button":"right","action":"press"},
    {"type":"cvar","name":"nextdayz.debug.step","set":0},
    {"type":"cvar","name":"nextdayz.debug.step","set":30},
    {"type":"wait-frames","n":33},
    {"type":"assert","query":"game.scopeBlend","op":"eq","value":0},
    {"type":"assert","query":"game.scopeView","op":"eq","value":false},
    {"type":"assert","query":"game.fpsArmParts","op":"ge","value":3},
    {"type":"quit"}
  ]
}

{
  "name": "nextdayz-ambience",
  "target": "NextDayz",
  "scene": "assets/scad/proc/coldwar/riverland_1km.scad",
  "viewport": { "width": 960, "height": 540 },
  "defaults": { "waitFrames": 2, "stepTimeoutMs": 30000 },
  "steps": [
    { "type": "wait-until", "query": "engine.status", "op": "eq", "value": "Running", "timeoutMs": 30000 },
    { "type": "wait-until", "query": "game.sceneReady", "op": "eq", "value": true, "timeoutMs": 60000 },
    { "type": "cvar", "name": "nextdayz.validation.invulnerable", "set": true },

    { "type": "log", "message": "Clear noon: rural day bed and birds, with quiet wind and no owls" },
    { "type": "cvar", "name": "nextdayz.debug.hour", "set": 12 },
    { "type": "wait-frames", "n": 3 },
    { "type": "cvar", "name": "nextdayz.debug.weather", "set": -1 },
    { "type": "cvar", "name": "nextdayz.debug.weather", "set": 0 },
    { "type": "wait-frames", "n": 3 },
    { "type": "assert", "query": "game.ambienceDay", "op": "gt", "value": 0.19 },
    { "type": "assert", "query": "game.ambienceBirds", "op": "gt", "value": 0.21 },
    { "type": "assert", "query": "game.ambienceNight", "op": "lt", "value": 0.001 },
    { "type": "assert", "query": "game.ambienceOwls", "op": "lt", "value": 0.001 },
    { "type": "assert", "query": "game.ambienceWind", "op": "lt", "value": 0.06 },
    { "type": "wait-ms", "ms": 6500 },

    { "type": "log", "message": "Dawn: birds become more prominent than at noon" },
    { "type": "cvar", "name": "nextdayz.debug.hour", "set": 7 },
    { "type": "wait-frames", "n": 3 },
    { "type": "cvar", "name": "nextdayz.debug.weather", "set": -1 },
    { "type": "cvar", "name": "nextdayz.debug.weather", "set": 0 },
    { "type": "wait-frames", "n": 3 },
    { "type": "assert", "query": "game.ambienceBirds", "op": "gt", "value": 0.30 },
    { "type": "wait-ms", "ms": 6500 },

    { "type": "log", "message": "Dusk: evening crickets, fading day bed and emerging night bed" },
    { "type": "cvar", "name": "nextdayz.debug.hour", "set": 18.5 },
    { "type": "wait-frames", "n": 3 },
    { "type": "cvar", "name": "nextdayz.debug.weather", "set": -1 },
    { "type": "cvar", "name": "nextdayz.debug.weather", "set": 0 },
    { "type": "wait-frames", "n": 3 },
    { "type": "assert", "query": "game.ambienceEvening", "op": "gt", "value": 0.17 },
    { "type": "assert", "query": "game.ambienceNight", "op": "gt", "value": 0.06 },
    { "type": "assert", "query": "game.ambienceBirds", "op": "lt", "value": 0.02 },
    { "type": "wait-ms", "ms": 6500 },

    { "type": "log", "message": "Night: night bed, insects and owls, without daytime birds" },
    { "type": "cvar", "name": "nextdayz.debug.hour", "set": 23 },
    { "type": "wait-frames", "n": 3 },
    { "type": "cvar", "name": "nextdayz.debug.weather", "set": -1 },
    { "type": "cvar", "name": "nextdayz.debug.weather", "set": 0 },
    { "type": "wait-frames", "n": 3 },
    { "type": "assert", "query": "game.ambienceDay", "op": "lt", "value": 0.001 },
    { "type": "assert", "query": "game.ambienceNight", "op": "gt", "value": 0.17 },
    { "type": "assert", "query": "game.ambienceOwls", "op": "gt", "value": 0.17 },
    { "type": "assert", "query": "game.ambienceBirds", "op": "lt", "value": 0.001 },
    { "type": "wait-ms", "ms": 6500 },

    { "type": "log", "message": "Overcast: fewer birds and more foliage/gusts, without any rain track" },
    { "type": "cvar", "name": "nextdayz.debug.hour", "set": 12 },
    { "type": "wait-frames", "n": 3 },
    { "type": "cvar", "name": "nextdayz.debug.weather", "set": -1 },
    { "type": "cvar", "name": "nextdayz.debug.weather", "set": 1 },
    { "type": "wait-frames", "n": 3 },
    { "type": "assert", "query": "game.weather", "op": "eq", "value": "Overcast" },
    { "type": "assert", "query": "game.ambienceWind", "op": "gt", "value": 0.10 },
    { "type": "assert", "query": "game.ambienceDay", "op": "lt", "value": 0.12 },
    { "type": "assert", "query": "game.ambienceBirds", "op": "lt", "value": 0.13 },
    { "type": "wait-ms", "ms": 6500 },

    { "type": "log", "message": "Fog: quiet wind and sparse wildlife, despite a higher Storm scalar" },
    { "type": "cvar", "name": "nextdayz.debug.weather", "set": -1 },
    { "type": "cvar", "name": "nextdayz.debug.weather", "set": 2 },
    { "type": "wait-frames", "n": 3 },
    { "type": "assert", "query": "game.weather", "op": "eq", "value": "Fog" },
    { "type": "assert", "query": "game.ambienceWind", "op": "lt", "value": 0.025 },
    { "type": "assert", "query": "game.ambienceDay", "op": "lt", "value": 0.08 },
    { "type": "assert", "query": "game.ambienceBirds", "op": "lt", "value": 0.09 },
    { "type": "wait-ms", "ms": 6500 },

    { "type": "log", "message": "Returning to clear noon restores the day mix and wildlife" },
    { "type": "cvar", "name": "nextdayz.debug.hour", "set": 12 },
    { "type": "wait-frames", "n": 3 },
    { "type": "cvar", "name": "nextdayz.debug.weather", "set": -1 },
    { "type": "cvar", "name": "nextdayz.debug.weather", "set": 0 },
    { "type": "wait-frames", "n": 3 },
    { "type": "assert", "query": "game.ambienceDay", "op": "gt", "value": 0.19 },
    { "type": "assert", "query": "game.ambienceBirds", "op": "gt", "value": 0.21 },
    { "type": "assert", "query": "game.ambienceWind", "op": "lt", "value": 0.06 },
    { "type": "assert", "query": "game.audioPlayed", "op": "ge", "value": 15 },
    { "type": "quit" }
  ]
}

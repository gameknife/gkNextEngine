{
  "name": "nextdayz-camera-arm",
  "target": "NextDayz",
  "scene": "assets/agentscripts/fixtures/nextdayz-camera-arm.scad",
  "defaults": { "waitFrames": 2, "stepTimeoutMs": 20000 },
  "viewport": { "width": 1600, "height": 900 },
  "steps": [
    { "type": "wait-until", "query": "engine.status", "op": "eq", "value": "Running", "timeoutMs": 20000 },
    { "type": "wait-until", "query": "game.sceneReady", "op": "eq", "value": true, "timeoutMs": 30000 },
    { "type": "cvar", "name": "nextdayz.validation.teleport", "set": "0,0" },
    { "type": "wait-ms", "ms": 1000 },

    { "type": "log", "message": "Wall retracts below minimum zoom on entering third person" },
    { "type": "cvar", "name": "nextdayz.validation.thirdPerson", "set": true },
    { "type": "assert", "query": "game.firstPerson", "op": "eq", "value": false },
    { "type": "assert", "query": "game.cameraArmLength", "op": "lt", "value": 1.0 },
    { "type": "assert", "query": "game.cameraPosZ", "op": "gt", "value": -0.8 },
    { "type": "assert", "query": "game.playerRigVisible", "op": "eq", "value": true },
    { "type": "assert", "query": "game.playerRigOpacity", "op": "gt", "value": 0.0 },
    { "type": "assert", "query": "game.playerRigOpacity", "op": "lt", "value": 0.9 },
    { "type": "screenshot", "out": "screenshots/nextdayz_camera_wall" },

    { "type": "log", "message": "Zoom preference survives collision, and clear space restores the arm gradually" },
    { "type": "scroll", "y": 2 },
    { "type": "assert", "query": "game.cameraArmLength", "op": "lt", "value": 1.0 },
    { "type": "cvar", "name": "nextdayz.validation.lookYaw", "set": 180 },
    { "type": "assert", "query": "game.cameraArmFraction", "op": "lt", "value": 0.9 },
    { "type": "wait-ms", "ms": 1000 },
    { "type": "assert", "query": "game.cameraArmFraction", "op": "eq", "value": 1.0 },
    { "type": "assert", "query": "game.cameraArmLength", "op": "gt", "value": 2.7 },
    { "type": "assert", "query": "game.cameraArmLength", "op": "lt", "value": 2.8 },
    { "type": "scroll", "y": -2 },
    { "type": "wait-ms", "ms": 500 },
    { "type": "assert", "query": "game.cameraArmLength", "op": "gt", "value": 3.9 },
    { "type": "assert", "query": "game.playerRigVisible", "op": "eq", "value": true },
    { "type": "assert", "query": "game.playerRigOpacity", "op": "eq", "value": 1.0 },
    { "type": "screenshot", "out": "screenshots/nextdayz_camera_clear" },

    { "type": "log", "message": "Rotating into the wall and toggling view retract immediately" },
    { "type": "cvar", "name": "nextdayz.validation.lookYaw", "set": 0 },
    { "type": "assert", "query": "game.cameraArmLength", "op": "lt", "value": 1.0 },
    { "type": "cvar", "name": "nextdayz.validation.thirdPerson", "set": false },
    { "type": "assert", "query": "game.cameraArmLength", "op": "eq", "value": 0.0 },
    { "type": "assert", "query": "game.playerRigVisible", "op": "eq", "value": false },
    { "type": "cvar", "name": "nextdayz.validation.thirdPerson", "set": true },
    { "type": "assert", "query": "game.cameraArmLength", "op": "lt", "value": 1.0 },

    { "type": "log", "message": "Shoulder offset cannot put the camera through a side wall" },
    { "type": "cvar", "name": "nextdayz.validation.teleport", "set": "10,0" },
    { "type": "wait-ms", "ms": 1000 },
    { "type": "assert", "query": "game.cameraArmFraction", "op": "lt", "value": 0.5 },
    { "type": "assert", "query": "game.cameraPosX", "op": "gt", "value": 9.75 },

    { "type": "log", "message": "Near-plane edge detects a post that the centre ray misses" },
    { "type": "cvar", "name": "nextdayz.validation.teleport", "set": "20,0" },
    { "type": "wait-ms", "ms": 1000 },
    { "type": "assert", "query": "game.cameraArmFraction", "op": "lt", "value": 0.6 },
    { "type": "assert", "query": "game.cameraPosZ", "op": "gt", "value": -1.5 },

    { "type": "log", "message": "Obstacle just beyond the lens still reserves clearance" },
    { "type": "cvar", "name": "nextdayz.validation.teleport", "set": "30,0" },
    { "type": "wait-ms", "ms": 1000 },
    { "type": "assert", "query": "game.cameraArmFraction", "op": "lt", "value": 0.999 },
    { "type": "assert", "query": "game.cameraPosZ", "op": "gt", "value": -3.72 },

    { "type": "log", "message": "Looking up cannot move the camera below the ground" },
    { "type": "cvar", "name": "nextdayz.validation.teleport", "set": "40,0" },
    { "type": "wait-ms", "ms": 1000 },
    { "type": "cvar", "name": "nextdayz.validation.lookPitch", "set": -60 },
    { "type": "assert", "query": "game.cameraArmFraction", "op": "lt", "value": 0.5 },
    { "type": "assert", "query": "game.cameraPosY", "op": "gt", "value": 0.2 },
    { "type": "assert", "query": "game.playerRigVisible", "op": "eq", "value": true },
    { "type": "assert", "query": "game.playerRigOpacity", "op": "lt", "value": 1.0 },
    { "type": "screenshot", "out": "screenshots/nextdayz_camera_ground" },
    { "type": "quit" }
  ]
}

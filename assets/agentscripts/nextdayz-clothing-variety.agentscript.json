{
  "name": "nextdayz-clothing-variety",
  "target": "NextDayz",
  "scene": "assets/scad/tests/nextdayz_melee.scad",
  "defaults": {
    "waitFrames": 3,
    "stepTimeoutMs": 20000
  },
  "viewport": {
    "width": 1600,
    "height": 1000
  },
  "steps": [
    {"type": "wait-until", "query": "game.sceneReady", "op": "eq", "value": true, "timeoutMs": 30000},
    {"type": "cvar", "name": "nextdayz.debug.freezeNeeds", "set": true},
    {"type": "cvar", "name": "nextdayz.debug.orbit", "set": true},
    {"type": "cvar", "name": "nextdayz.debug.orbitDistance", "set": 2.4},
    {"type": "cvar", "name": "nextdayz.debug.orbitHeight", "set": 0.95},
    {"type": "log", "message": "All five slots: field"},
    {"type": "wait-until", "query": "game.onGround", "op": "eq", "value": true, "timeoutMs": 10000},
    {"type": "wait-until", "query": "game.baseAnim", "op": "eq", "value": "stand_idle", "timeoutMs": 10000},
    {"type": "wait-frames", "n": 30},
    {"type": "cvar", "name": "nextdayz.debug.orbitYaw", "set": 160},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "jacket"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "jacket"},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "backpack_small"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "backpack_small"},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "work_pants"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "work_pants"},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "helmet"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "helmet"},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "vest_military"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "vest_military"},
    {"type": "assert", "query": "game.clothingVisuals", "op": "eq", "value": "helmet:1;jacket:5;vest_military:1;work_pants:7;backpack_small:2;"},
    {"type": "assert", "query": "game.bareTorsoVisible", "op": "eq", "value": false},
    {"type": "assert", "query": "game.shortsVisible", "op": "eq", "value": false},
    {"type": "wait-frames", "n": 40},
    {"type": "screenshot", "out": "screenshots/nextdayz_variety_field_front"},
    {"type": "cvar", "name": "nextdayz.debug.orbitYaw", "set": 20},
    {"type": "wait-frames", "n": 30},
    {"type": "screenshot", "out": "screenshots/nextdayz_variety_field_back"},
    {"type": "log", "message": "All five slots: urban"},
    {"type": "cvar", "name": "nextdayz.validation.restart", "set": false},
    {"type": "cvar", "name": "nextdayz.validation.restart", "set": true},
    {"type": "assert", "query": "game.clothingVisuals", "op": "eq", "value": ""},
    {"type": "wait-until", "query": "game.onGround", "op": "eq", "value": true, "timeoutMs": 10000},
    {"type": "wait-until", "query": "game.baseAnim", "op": "eq", "value": "stand_idle", "timeoutMs": 10000},
    {"type": "wait-frames", "n": 30},
    {"type": "cvar", "name": "nextdayz.debug.orbitYaw", "set": 160},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "hoodie"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "hoodie"},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "backpack"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "backpack"},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "cargo_pants"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "cargo_pants"},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "hat_beanie"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "hat_beanie"},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "vest_police"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "vest_police"},
    {"type": "assert", "query": "game.clothingVisuals", "op": "eq", "value": "hoodie:5;cargo_pants:7;backpack:2;hat_beanie:1;vest_police:1;"},
    {"type": "assert", "query": "game.bareTorsoVisible", "op": "eq", "value": false},
    {"type": "assert", "query": "game.shortsVisible", "op": "eq", "value": false},
    {"type": "wait-frames", "n": 40},
    {"type": "screenshot", "out": "screenshots/nextdayz_variety_urban_front"},
    {"type": "cvar", "name": "nextdayz.debug.orbitYaw", "set": 20},
    {"type": "wait-frames", "n": 30},
    {"type": "screenshot", "out": "screenshots/nextdayz_variety_urban_back"},
    {"type": "log", "message": "All five slots: winter"},
    {"type": "cvar", "name": "nextdayz.validation.restart", "set": false},
    {"type": "cvar", "name": "nextdayz.validation.restart", "set": true},
    {"type": "assert", "query": "game.clothingVisuals", "op": "eq", "value": ""},
    {"type": "wait-until", "query": "game.onGround", "op": "eq", "value": true, "timeoutMs": 10000},
    {"type": "wait-until", "query": "game.baseAnim", "op": "eq", "value": "stand_idle", "timeoutMs": 10000},
    {"type": "wait-frames", "n": 30},
    {"type": "cvar", "name": "nextdayz.debug.orbitYaw", "set": 160},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "jacket_puffer"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "jacket_puffer"},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "backpack_military"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "backpack_military"},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "jeans"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "jeans"},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "cap_baseball"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "cap_baseball"},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "vest_chest_rig"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "vest_chest_rig"},
    {"type": "assert", "query": "game.clothingVisuals", "op": "eq", "value": "backpack_military:2;cap_baseball:1;jacket_puffer:5;vest_chest_rig:1;jeans:7;"},
    {"type": "assert", "query": "game.bareTorsoVisible", "op": "eq", "value": false},
    {"type": "assert", "query": "game.shortsVisible", "op": "eq", "value": false},
    {"type": "wait-frames", "n": 40},
    {"type": "screenshot", "out": "screenshots/nextdayz_variety_winter_front"},
    {"type": "cvar", "name": "nextdayz.debug.orbitYaw", "set": 20},
    {"type": "wait-frames", "n": 30},
    {"type": "screenshot", "out": "screenshots/nextdayz_variety_winter_back"},
    {"type": "key", "code": "C", "action": "press"},
    {"type": "cvar", "name": "nextdayz.debug.orbitYaw", "set": 90},
    {"type": "wait-frames", "n": 35},
    {"type": "screenshot", "out": "screenshots/nextdayz_variety_winter_crouch"},
    {"type": "key", "code": "C", "action": "press"},
    {"type": "log", "message": "All five slots: ranger"},
    {"type": "cvar", "name": "nextdayz.validation.restart", "set": false},
    {"type": "cvar", "name": "nextdayz.validation.restart", "set": true},
    {"type": "assert", "query": "game.clothingVisuals", "op": "eq", "value": ""},
    {"type": "wait-until", "query": "game.onGround", "op": "eq", "value": true, "timeoutMs": 10000},
    {"type": "wait-until", "query": "game.baseAnim", "op": "eq", "value": "stand_idle", "timeoutMs": 10000},
    {"type": "wait-frames", "n": 30},
    {"type": "cvar", "name": "nextdayz.debug.orbitYaw", "set": 160},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "jacket_rain"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "jacket_rain"},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "backpack_messenger"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "backpack_messenger"},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "pants_tactical"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "pants_tactical"},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "hat_boonie"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "hat_boonie"},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "vest_hunting"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "vest_hunting"},
    {"type": "assert", "query": "game.clothingVisuals", "op": "eq", "value": "hat_boonie:1;jacket_rain:5;vest_hunting:1;pants_tactical:7;backpack_messenger:2;"},
    {"type": "assert", "query": "game.bareTorsoVisible", "op": "eq", "value": false},
    {"type": "assert", "query": "game.shortsVisible", "op": "eq", "value": false},
    {"type": "wait-frames", "n": 40},
    {"type": "screenshot", "out": "screenshots/nextdayz_variety_ranger_front"},
    {"type": "cvar", "name": "nextdayz.debug.orbitYaw", "set": 20},
    {"type": "wait-frames", "n": 30},
    {"type": "screenshot", "out": "screenshots/nextdayz_variety_ranger_back"},
    {"type": "log", "message": "All five slots: utility"},
    {"type": "cvar", "name": "nextdayz.validation.restart", "set": false},
    {"type": "cvar", "name": "nextdayz.validation.restart", "set": true},
    {"type": "assert", "query": "game.clothingVisuals", "op": "eq", "value": ""},
    {"type": "wait-until", "query": "game.onGround", "op": "eq", "value": true, "timeoutMs": 10000},
    {"type": "wait-until", "query": "game.baseAnim", "op": "eq", "value": "stand_idle", "timeoutMs": 10000},
    {"type": "wait-frames", "n": 30},
    {"type": "cvar", "name": "nextdayz.debug.orbitYaw", "set": 160},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "jacket_denim"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "jacket_denim"},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "backpack_medical"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "backpack_medical"},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "pants_rain"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "pants_rain"},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "helmet_tactical"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "helmet_tactical"},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "vest_utility"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "vest_utility"},
    {"type": "assert", "query": "game.clothingVisuals", "op": "eq", "value": "helmet_tactical:1;jacket_denim:5;vest_utility:1;pants_rain:7;backpack_medical:2;"},
    {"type": "assert", "query": "game.bareTorsoVisible", "op": "eq", "value": false},
    {"type": "assert", "query": "game.shortsVisible", "op": "eq", "value": false},
    {"type": "wait-frames", "n": 40},
    {"type": "screenshot", "out": "screenshots/nextdayz_variety_utility_front"},
    {"type": "cvar", "name": "nextdayz.debug.orbitYaw", "set": 20},
    {"type": "wait-frames", "n": 30},
    {"type": "screenshot", "out": "screenshots/nextdayz_variety_utility_back"},
    {"type": "cvar", "name": "nextdayz.validation.drop", "set": "jacket_denim"},
    {"type": "assert", "query": "game.bareTorsoVisible", "op": "eq", "value": true},
    {"type": "cvar", "name": "nextdayz.debug.orbitYaw", "set": 145},
    {"type": "wait-frames", "n": 20},
    {"type": "screenshot", "out": "screenshots/nextdayz_variety_utility_drop"},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "jacket_denim"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "jacket_denim"},
    {"type": "assert", "query": "game.clothingVisuals", "op": "eq", "value": "helmet_tactical:1;jacket_denim:5;vest_utility:1;pants_rain:7;backpack_medical:2;"},
    {"type": "log", "message": "All five slots: rescue"},
    {"type": "cvar", "name": "nextdayz.validation.restart", "set": false},
    {"type": "cvar", "name": "nextdayz.validation.restart", "set": true},
    {"type": "assert", "query": "game.clothingVisuals", "op": "eq", "value": ""},
    {"type": "wait-until", "query": "game.onGround", "op": "eq", "value": true, "timeoutMs": 10000},
    {"type": "wait-until", "query": "game.baseAnim", "op": "eq", "value": "stand_idle", "timeoutMs": 10000},
    {"type": "wait-frames", "n": 30},
    {"type": "cvar", "name": "nextdayz.debug.orbitYaw", "set": 160},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "jacket_rescue"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "jacket_rescue"},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "backpack_rolltop"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "backpack_rolltop"},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "pants_snow"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "pants_snow"},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "hat_ushanka"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "hat_ushanka"},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "vest_rescue"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "vest_rescue"},
    {"type": "assert", "query": "game.clothingVisuals", "op": "eq", "value": "hat_ushanka:1;jacket_rescue:5;vest_rescue:1;pants_snow:7;backpack_rolltop:2;"},
    {"type": "assert", "query": "game.bareTorsoVisible", "op": "eq", "value": false},
    {"type": "assert", "query": "game.shortsVisible", "op": "eq", "value": false},
    {"type": "wait-frames", "n": 40},
    {"type": "screenshot", "out": "screenshots/nextdayz_variety_rescue_front"},
    {"type": "cvar", "name": "nextdayz.debug.orbitYaw", "set": 20},
    {"type": "wait-frames", "n": 30},
    {"type": "screenshot", "out": "screenshots/nextdayz_variety_rescue_back"},
    {"type": "key", "code": "V", "action": "press"},
    {"type": "cvar", "name": "nextdayz.validation.loadout", "set": true},
    {"type": "cvar", "name": "nextdayz.debug.orbitYaw", "set": 145},
    {"type": "mouse-button", "button": "right", "action": "down"},
    {"type": "wait-frames", "n": 60},
    {"type": "assert", "query": "game.gripError", "op": "lt", "value": 0.01},
    {"type": "screenshot", "out": "screenshots/nextdayz_variety_rescue_aim"},
    {"type": "mouse-button", "button": "right", "action": "up"},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "pistol"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "pistol"},
    {"type": "cvar", "name": "nextdayz.debug.orbitYaw", "set": 30},
    {"type": "wait-ms", "ms": 1100},
    {"type": "screenshot", "out": "screenshots/nextdayz_variety_rescue_stowed"},
    {"type": "cvar", "name": "nextdayz.validation.loadout", "set": false},
    {"type": "cvar", "name": "nextdayz.validation.restart", "set": false},
    {"type": "cvar", "name": "nextdayz.validation.restart", "set": true},
    {"type": "assert", "query": "game.clothingVisuals", "op": "eq", "value": ""},
    {"type": "assert", "query": "game.bareTorsoVisible", "op": "eq", "value": true},
    {"type": "assert", "query": "game.shortsVisible", "op": "eq", "value": true},
    {"type": "quit"}
  ]
}

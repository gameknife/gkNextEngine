{
  "name": "nextdayz-clothing",
  "target": "NextDayz",
  "scene": "assets/scad/tests/nextdayz_melee.scad",
  "defaults": {"waitFrames": 3, "stepTimeoutMs": 20000},
  "viewport": {"width": 1600, "height": 1000},
  "steps": [
    {"type": "wait-until", "query": "game.sceneReady", "op": "eq", "value": true, "timeoutMs": 30000},
    {"type": "cvar", "name": "nextdayz.debug.freezeNeeds", "set": true},
    {"type": "cvar", "name": "nextdayz.debug.orbit", "set": true},
    {"type": "cvar", "name": "nextdayz.debug.orbitDistance", "set": 2.4},
    {"type": "cvar", "name": "nextdayz.debug.orbitHeight", "set": 0.95},
    {"type": "cvar", "name": "nextdayz.debug.orbitYaw", "set": 160},
    {"type": "assert", "query": "game.clothingVisuals", "op": "eq", "value": ""},
    {"type": "assert", "query": "game.bareTorsoVisible", "op": "eq", "value": true},
    {"type": "assert", "query": "game.shortsVisible", "op": "eq", "value": true},
    {"type": "wait-frames", "n": 30},
    {"type": "screenshot", "out": "screenshots/nextdayz_clothing_bare"},

    {"type": "log", "message": "Equip each clothing slot; covered skin is hidden, bones remain animated"},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "backpack_small"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "backpack_small"},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "jacket"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "jacket"},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "cargo_pants"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "cargo_pants"},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "helmet"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "helmet"},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "vest_military"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "vest_military"},
    {"type": "assert", "query": "game.clothingVisuals", "op": "contains", "value": "backpack_small:2;"},
    {"type": "assert", "query": "game.clothingVisuals", "op": "contains", "value": "jacket:5;"},
    {"type": "assert", "query": "game.clothingVisuals", "op": "contains", "value": "cargo_pants:7;"},
    {"type": "assert", "query": "game.clothingVisuals", "op": "contains", "value": "helmet:1;"},
    {"type": "assert", "query": "game.clothingVisuals", "op": "contains", "value": "vest_military:1;"},
    {"type": "assert", "query": "game.bareTorsoVisible", "op": "eq", "value": false},
    {"type": "assert", "query": "game.shortsVisible", "op": "eq", "value": false},
    {"type": "wait-frames", "n": 15},
    {"type": "screenshot", "out": "screenshots/nextdayz_clothing_field_front"},
    {"type": "cvar", "name": "nextdayz.debug.orbitYaw", "set": 20},
    {"type": "wait-frames", "n": 15},
    {"type": "screenshot", "out": "screenshots/nextdayz_clothing_small_pack"},

    {"type": "log", "message": "Swap pack styles and outerwear, including a smaller-capacity garment"},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "backpack"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "backpack"},
    {"type": "assert", "query": "game.clothingVisuals", "op": "contains", "value": "backpack:2;"},
    {"type": "assert", "query": "game.clothingVisuals", "op": "eq", "value": "helmet:1;jacket:5;vest_military:1;cargo_pants:7;backpack:2;"},
    {"type": "wait-frames", "n": 15},
    {"type": "screenshot", "out": "screenshots/nextdayz_clothing_hiking_pack"},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "backpack_military"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "backpack_military"},
    {"type": "assert", "query": "game.clothingVisuals", "op": "contains", "value": "backpack_military:2;"},
    {"type": "assert", "query": "game.clothingVisuals", "op": "eq", "value": "helmet:1;jacket:5;vest_military:1;cargo_pants:7;backpack_military:2;"},
    {"type": "wait-frames", "n": 15},
    {"type": "screenshot", "out": "screenshots/nextdayz_clothing_assault_pack"},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "hoodie"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "hoodie"},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "work_pants"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "work_pants"},
    {"type": "assert", "query": "game.clothingVisuals", "op": "contains", "value": "hoodie:5;"},
    {"type": "assert", "query": "game.clothingVisuals", "op": "contains", "value": "work_pants:7;"},
    {"type": "assert", "query": "game.clothingVisuals", "op": "eq", "value": "helmet:1;hoodie:5;vest_military:1;work_pants:7;backpack_military:2;"},
    {"type": "cvar", "name": "nextdayz.debug.orbitYaw", "set": 160},
    {"type": "wait-frames", "n": 15},
    {"type": "screenshot", "out": "screenshots/nextdayz_clothing_hoodie_front"},
    {"type": "key", "code": "C", "action": "press"},
    {"type": "wait-frames", "n": 30},
    {"type": "assert", "query": "game.stance", "op": "eq", "value": "crouched"},
    {"type": "cvar", "name": "nextdayz.debug.orbitYaw", "set": 90},
    {"type": "screenshot", "out": "screenshots/nextdayz_clothing_crouch"},
    {"type": "key", "code": "C", "action": "press"},
    {"type": "key", "code": "W", "action": "down"},
    {"type": "wait-frames", "n": 20},
    {"type": "screenshot", "out": "screenshots/nextdayz_clothing_run"},
    {"type": "key", "code": "W", "action": "up"},

    {"type": "log", "message": "Rifle hold, aim and back-mounted rifle with the largest pack"},
    {"type": "key", "code": "V", "action": "press"},
    {"type": "cvar", "name": "nextdayz.validation.loadout", "set": true},
    {"type": "cvar", "name": "nextdayz.debug.orbitYaw", "set": 145},
    {"type": "wait-frames", "n": 50},
    {"type": "screenshot", "out": "screenshots/nextdayz_clothing_rifle"},
    {"type": "mouse-button", "button": "right", "action": "down"},
    {"type": "wait-frames", "n": 50},
    {"type": "assert", "query": "game.gripError", "op": "lt", "value": 0.01},
    {"type": "screenshot", "out": "screenshots/nextdayz_clothing_aim"},
    {"type": "mouse-button", "button": "right", "action": "up"},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "pistol"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "pistol"},
    {"type": "cvar", "name": "nextdayz.debug.orbitYaw", "set": 30},
    {"type": "wait-ms", "ms": 1100},
    {"type": "screenshot", "out": "screenshots/nextdayz_clothing_stowed_rifle"},

    {"type": "log", "message": "Removing outerwear restores skin and shorts while retaining the vest and pack"},
    {"type": "cvar", "name": "nextdayz.validation.drop", "set": "hoodie"},
    {"type": "cvar", "name": "nextdayz.validation.drop", "set": "work_pants"},
    {"type": "assert", "query": "game.bareTorsoVisible", "op": "eq", "value": true},
    {"type": "assert", "query": "game.shortsVisible", "op": "eq", "value": true},
    {"type": "assert", "query": "game.clothingVisuals", "op": "eq", "value": "helmet:1;vest_military:1;backpack_military:2;"},
    {"type": "assert", "query": "game.clothingVisuals", "op": "contains", "value": "vest_military:1;"},
    {"type": "cvar", "name": "nextdayz.debug.orbitYaw", "set": 160},
    {"type": "wait-frames", "n": 15},
    {"type": "screenshot", "out": "screenshots/nextdayz_clothing_vest_only"},
    {"type": "cvar", "name": "nextdayz.validation.loadout", "set": false},
    {"type": "cvar", "name": "nextdayz.validation.restart", "set": true},
    {"type": "wait-frames", "n": 10},
    {"type": "assert", "query": "game.clothingVisuals", "op": "eq", "value": ""},
    {"type": "assert", "query": "game.bareTorsoVisible", "op": "eq", "value": true},
    {"type": "assert", "query": "game.shortsVisible", "op": "eq", "value": true},
    {"type": "quit"}
  ]
}

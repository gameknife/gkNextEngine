{
  "name": "nextdayz-contracts",
  "target": "NextDayz",
  "viewport": {
    "width": 1600,
    "height": 900
  },
  "args": [
    "--cvar",
    "nextdayz.validation.campaign true",
    "--cvar",
    "nextdayz.validation.campaignFresh true",
    "--cvar",
    "nextdayz.validation.campaignPath out/nextdayz-validation/contracts.json"
  ],
  "defaults": {
    "waitFrames": 2,
    "stepTimeoutMs": 180000
  },
  "steps": [
    { "type": "wait-until", "query": "game.sceneReady", "op": "eq", "value": true, "timeoutMs": 60000 },
    { "type": "assert", "query": "game.cabinScene", "op": "eq", "value": true },
    { "type": "assert", "query": "game.campaignSaveBlocked", "op": "eq", "value": false },
    { "type": "assert", "query": "game.contractBoardSize", "op": "eq", "value": 3 },
    { "type": "assert", "query": "game.contractBoardTypes", "op": "contains", "value": "recon" },

    { "type": "log", "message": "Delivery: hand in field dressings from storage" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "contract-reroll" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "contract-offer:med_dressings" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "contract-handin" },
    { "type": "assert", "query": "game.contractsCompleted", "op": "eq", "value": 0 },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "contract-fill" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "contract-handin" },
    { "type": "assert", "query": "game.contractsCompleted", "op": "eq", "value": 1 },
    { "type": "assert", "query": "game.reputation", "op": "eq", "value": 1 },
    { "type": "assert", "query": "game.lastContractGold", "op": "ge", "value": 30 },
    { "type": "assert", "query": "game.campaignGold", "op": "ge", "value": 30 },

    { "type": "log", "message": "Recon: accept, deploy, reach the site, extract" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "contract-offer:recon_settlement" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "contract-accept:recon" },
    { "type": "assert", "query": "game.contractsActive", "op": "eq", "value": 1 },
    { "type": "key", "code": "T", "action": "press" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "page:0" },
    { "type": "wait-frames", "n": 30 },
    { "type": "assert", "query": "game.cabinPanel", "op": "eq", "value": 2 },
    { "type": "screenshot", "out": "screenshots/nextdayz-contracts-board", "ui": true },
    { "type": "key", "code": "Escape", "action": "press" },
    { "type": "cvar", "name": "nextdayz.validation.deployMap", "set": "cz_loket_riverbend" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "deploy" },
    { "type": "wait-until", "query": "game.campaignInField", "op": "eq", "value": true, "timeoutMs": 180000 },
    { "type": "cvar", "name": "nextdayz.validation.invulnerable", "set": true },
    { "type": "assert", "query": "game.contractMarkers", "op": "eq", "value": 1 },
    { "type": "assert", "query": "game.contractObjective", "op": "ne", "value": "" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "goto-target" },
    { "type": "wait-ms", "ms": 1500 },
    { "type": "assert", "query": "game.visitedSites", "op": "ge", "value": 1 },
    { "type": "assert", "query": "game.contractMarkers", "op": "eq", "value": 0 },
    { "type": "cvar", "name": "nextdayz.validation.give", "set": "signal_flare" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "pad:0" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "call" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "flight:58" },
    { "type": "assert", "query": "game.flightPhase", "op": "eq", "value": "Waiting at helipad" },
    { "type": "key", "code": "E", "action": "press" },
    { "type": "assert", "query": "game.flightBoarded", "op": "eq", "value": true },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "flight:9" },
    { "type": "wait-until", "query": "game.cabinScene", "op": "eq", "value": true, "timeoutMs": 60000 },
    { "type": "assert", "query": "game.contractsCompleted", "op": "eq", "value": 2 },
    { "type": "assert", "query": "game.contractsActive", "op": "eq", "value": 0 },
    { "type": "assert", "query": "game.lastContractGold", "op": "ge", "value": 100 },
    { "type": "assert", "query": "game.reputation", "op": "eq", "value": 2 },
    { "type": "assert", "query": "game.contractBoardSize", "op": "ge", "value": 3 },

    { "type": "log", "message": "Fetch: take the records, die, recover them, extract" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "contract-offer:fetch_records" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "contract-accept:fetch" },
    { "type": "assert", "query": "game.contractsActive", "op": "eq", "value": 1 },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "deploy" },
    { "type": "wait-until", "query": "game.campaignInField", "op": "eq", "value": true, "timeoutMs": 180000 },
    { "type": "assert", "query": "game.parcelInWorld", "op": "eq", "value": true },
    { "type": "assert", "query": "game.contractMarkers", "op": "eq", "value": 1 },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "goto-target" },
    { "type": "wait-frames", "n": 10 },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "take-item:contract_documents" },
    { "type": "assert", "query": "game.parcelCarried", "op": "eq", "value": true },
    { "type": "assert", "query": "game.parcelInWorld", "op": "eq", "value": false },
    { "type": "cvar", "name": "nextdayz.validation.invulnerable", "set": false },
    { "type": "cvar", "name": "nextdayz.validation.damagePlayer", "set": 200 },
    { "type": "wait-until", "query": "game.cabinScene", "op": "eq", "value": true, "timeoutMs": 60000 },
    { "type": "assert", "query": "game.campaignInField", "op": "eq", "value": false },
    { "type": "assert", "query": "game.contractsActive", "op": "eq", "value": 1 },
    { "type": "assert", "query": "game.lastSortieOutcome", "op": "eq", "value": "died" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "deploy" },
    { "type": "wait-until", "query": "game.campaignInField", "op": "eq", "value": true, "timeoutMs": 180000 },
    { "type": "cvar", "name": "nextdayz.validation.invulnerable", "set": true },
    { "type": "cvar", "name": "nextdayz.validation.give", "set": "backpack" },
    { "type": "cvar", "name": "nextdayz.validation.use", "set": "backpack" },
    { "type": "assert", "query": "game.parcelInWorld", "op": "eq", "value": true },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "goto-target" },
    { "type": "wait-frames", "n": 10 },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "take-item:contract_documents" },
    { "type": "assert", "query": "game.parcelCarried", "op": "eq", "value": true },
    { "type": "cvar", "name": "nextdayz.validation.give", "set": "signal_flare" },
    { "type": "assert", "query": "game.signalFlares", "op": "eq", "value": 1 },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "pad:1" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "call" },
    { "type": "assert", "query": "game.flightPhase", "op": "eq", "value": "Inbound" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "flight:58" },
    { "type": "assert", "query": "game.flightPhase", "op": "eq", "value": "Waiting at helipad" },
    { "type": "key", "code": "E", "action": "press" },
    { "type": "assert", "query": "game.flightBoarded", "op": "eq", "value": true },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "flight:9" },
    { "type": "wait-until", "query": "game.cabinScene", "op": "eq", "value": true, "timeoutMs": 60000 },
    { "type": "assert", "query": "game.contractsCompleted", "op": "eq", "value": 3 },
    { "type": "assert", "query": "game.contractsActive", "op": "eq", "value": 0 },
    { "type": "assert", "query": "game.parcelCarried", "op": "eq", "value": false },
    { "type": "assert", "query": "game.lastContractGold", "op": "ge", "value": 240 },
    { "type": "assert", "query": "game.reputation", "op": "eq", "value": 4 },

    { "type": "log", "message": "Abandon: costs reputation but never the tier" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "contract-offer:fetch_consignment" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "contract-accept:fetch" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "contract-abandon:fetch" },
    { "type": "assert", "query": "game.contractsActive", "op": "eq", "value": 0 },
    { "type": "assert", "query": "game.lastContractsExpired", "op": "eq", "value": 1 },
    { "type": "assert", "query": "game.reputation", "op": "eq", "value": 3 },
    { "type": "key", "code": "T", "action": "press" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "page:1" },
    { "type": "wait-frames", "n": 30 },
    { "type": "screenshot", "out": "screenshots/nextdayz-contracts-report", "ui": true },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "save" },
    { "type": "quit" }
  ]
}

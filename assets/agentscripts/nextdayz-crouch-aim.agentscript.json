{
  "name": "nextdayz-crouch-aim",
  "target": "NextDayz",
  "scene": "assets/scad/tests/nextdayz_melee.scad",
  "defaults": {
    "waitFrames": 2,
    "stepTimeoutMs": 20000
  },
  "viewport": {
    "width": 1600,
    "height": 1000
  },
  "steps": [
    {"type": "wait-until", "query": "game.sceneReady", "op": "eq", "value": true, "timeoutMs": 30000},
    {"type": "cvar", "name": "nextdayz.debug.freezeNeeds", "set": true},
    {"type": "cvar", "name": "nextdayz.validation.teleport", "set": "0,0"},
    {"type": "cvar", "name": "nextdayz.validation.lookYaw", "set": 0},
    {"type": "cvar", "name": "nextdayz.validation.lookPitch", "set": 0},
    {"type": "cvar", "name": "nextdayz.validation.loadout", "set": true},
    {"type": "cvar", "name": "nextdayz.validation.thirdPerson", "set": true},
    {"type": "cvar", "name": "nextdayz.debug.orbit", "set": true},
    {"type": "cvar", "name": "nextdayz.debug.orbitDistance", "set": 2.4},
    {"type": "cvar", "name": "nextdayz.debug.orbitHeight", "set": 0.95},
    {"type": "cvar", "name": "nextdayz.debug.orbitYaw", "set": 90},
    {"type": "cvar", "name": "nextdayz.debug.freeze", "set": true},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 30},
    {"type": "wait-frames", "n": 33},
    {"type": "screenshot", "out": "screenshots/nextdayz_crouch_aim_standing_ready"},
    {"type": "mouse-button", "button": "right", "action": "down"},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 30},
    {"type": "wait-frames", "n": 33},
    {"type": "assert", "query": "game.stance", "op": "eq", "value": "standing"},
    {"type": "assert", "query": "game.isAiming", "op": "eq", "value": true},
    {"type": "assert", "query": "game.aimWeight", "op": "gt", "value": 0.99},
    {"type": "assert", "query": "game.heldWeaponVisible", "op": "eq", "value": true},
    {"type": "assert", "query": "game.gripError", "op": "lt", "value": 0.03},
    {"type": "assert", "query": "game.weaponAimError", "op": "lt", "value": 15},
    {"type": "screenshot", "out": "screenshots/nextdayz_crouch_aim_standing_ads"},
    {"type": "log", "message": "Keep ADS held while crouching and standing again"},
    {"type": "key", "code": "C", "action": "press"},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 30},
    {"type": "wait-frames", "n": 33},
    {"type": "assert", "query": "game.stance", "op": "eq", "value": "crouched"},
    {"type": "assert", "query": "game.isAiming", "op": "eq", "value": true},
    {"type": "assert", "query": "game.aimWeight", "op": "gt", "value": 0.99},
    {"type": "assert", "query": "game.heldWeaponVisible", "op": "eq", "value": true},
    {"type": "assert", "query": "game.gripError", "op": "lt", "value": 0.03},
    {"type": "assert", "query": "game.weaponAimError", "op": "lt", "value": 2},
    {"type": "screenshot", "out": "screenshots/nextdayz_crouch_aim_crouched_ads_from_standing"},
    {"type": "key", "code": "C", "action": "press"},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 30},
    {"type": "wait-frames", "n": 33},
    {"type": "assert", "query": "game.stance", "op": "eq", "value": "standing"},
    {"type": "assert", "query": "game.isAiming", "op": "eq", "value": true},
    {"type": "assert", "query": "game.aimWeight", "op": "gt", "value": 0.99},
    {"type": "assert", "query": "game.heldWeaponVisible", "op": "eq", "value": true},
    {"type": "assert", "query": "game.gripError", "op": "lt", "value": 0.03},
    {"type": "assert", "query": "game.weaponAimError", "op": "lt", "value": 15},
    {"type": "log", "message": "Enter ADS from crouched ready, including both pitch directions and walking"},
    {"type": "mouse-button", "button": "right", "action": "up"},
    {"type": "key", "code": "C", "action": "press"},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 30},
    {"type": "wait-frames", "n": 33},
    {"type": "assert", "query": "game.aimWeight", "op": "lt", "value": 0.01},
    {"type": "screenshot", "out": "screenshots/nextdayz_crouch_aim_crouched_ready"},
    {"type": "mouse-button", "button": "right", "action": "down"},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 30},
    {"type": "wait-frames", "n": 33},
    {"type": "assert", "query": "game.stance", "op": "eq", "value": "crouched"},
    {"type": "assert", "query": "game.isAiming", "op": "eq", "value": true},
    {"type": "assert", "query": "game.aimWeight", "op": "gt", "value": 0.99},
    {"type": "assert", "query": "game.heldWeaponVisible", "op": "eq", "value": true},
    {"type": "assert", "query": "game.gripError", "op": "lt", "value": 0.03},
    {"type": "assert", "query": "game.weaponAimError", "op": "lt", "value": 2},
    {"type": "screenshot", "out": "screenshots/nextdayz_crouch_aim_crouched_ads"},
    {"type": "cvar", "name": "nextdayz.validation.lookPitch", "set": -25},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 20},
    {"type": "wait-frames", "n": 23},
    {"type": "assert", "query": "game.stance", "op": "eq", "value": "crouched"},
    {"type": "assert", "query": "game.isAiming", "op": "eq", "value": true},
    {"type": "assert", "query": "game.aimWeight", "op": "gt", "value": 0.99},
    {"type": "assert", "query": "game.heldWeaponVisible", "op": "eq", "value": true},
    {"type": "assert", "query": "game.gripError", "op": "lt", "value": 0.03},
    {"type": "assert", "query": "game.weaponAimError", "op": "lt", "value": 2},
    {"type": "screenshot", "out": "screenshots/nextdayz_crouch_aim_pitch_-25"},
    {"type": "cvar", "name": "nextdayz.validation.lookPitch", "set": 25},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 20},
    {"type": "wait-frames", "n": 23},
    {"type": "assert", "query": "game.stance", "op": "eq", "value": "crouched"},
    {"type": "assert", "query": "game.isAiming", "op": "eq", "value": true},
    {"type": "assert", "query": "game.aimWeight", "op": "gt", "value": 0.99},
    {"type": "assert", "query": "game.heldWeaponVisible", "op": "eq", "value": true},
    {"type": "assert", "query": "game.gripError", "op": "lt", "value": 0.03},
    {"type": "assert", "query": "game.weaponAimError", "op": "lt", "value": 2},
    {"type": "screenshot", "out": "screenshots/nextdayz_crouch_aim_pitch_25"},
    {"type": "cvar", "name": "nextdayz.validation.lookPitch", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 20},
    {"type": "wait-frames", "n": 23},
    {"type": "assert", "query": "game.stance", "op": "eq", "value": "crouched"},
    {"type": "assert", "query": "game.isAiming", "op": "eq", "value": true},
    {"type": "assert", "query": "game.aimWeight", "op": "gt", "value": 0.99},
    {"type": "assert", "query": "game.heldWeaponVisible", "op": "eq", "value": true},
    {"type": "assert", "query": "game.gripError", "op": "lt", "value": 0.03},
    {"type": "assert", "query": "game.weaponAimError", "op": "lt", "value": 2},
    {"type": "screenshot", "out": "screenshots/nextdayz_crouch_aim_pitch_0"},
    {"type": "key", "code": "W", "action": "down"},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 30},
    {"type": "wait-frames", "n": 33},
    {"type": "assert", "query": "game.stance", "op": "eq", "value": "crouched"},
    {"type": "assert", "query": "game.isAiming", "op": "eq", "value": true},
    {"type": "assert", "query": "game.aimWeight", "op": "gt", "value": 0.99},
    {"type": "assert", "query": "game.heldWeaponVisible", "op": "eq", "value": true},
    {"type": "assert", "query": "game.gripError", "op": "lt", "value": 0.03},
    {"type": "assert", "query": "game.weaponAimError", "op": "lt", "value": 2},
    {"type": "assert", "query": "game.gait", "op": "eq", "value": "walk"},
    {"type": "screenshot", "out": "screenshots/nextdayz_crouch_aim_crouched_walk_ads"},
    {"type": "key", "code": "W", "action": "up"},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 30},
    {"type": "wait-frames", "n": 33},
    {"type": "cvar", "name": "nextdayz.validation.lookYaw", "set": 35},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 5},
    {"type": "wait-frames", "n": 8},
    {"type": "assert", "query": "game.weaponAimError", "op": "lt", "value": 2},
    {"type": "assert", "query": "game.gripError", "op": "lt", "value": 0.03},
    {"type": "cvar", "name": "nextdayz.validation.lookYaw", "set": 75},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 5},
    {"type": "wait-frames", "n": 8},
    {"type": "assert", "query": "game.weaponAimError", "op": "lt", "value": 2},
    {"type": "assert", "query": "game.gripError", "op": "lt", "value": 0.03},
    {"type": "cvar", "name": "nextdayz.validation.lookYaw", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 5},
    {"type": "wait-frames", "n": 8},
    {"type": "assert", "query": "game.weaponAimError", "op": "lt", "value": 2},
    {"type": "assert", "query": "game.gripError", "op": "lt", "value": 0.03},
    {"type": "log", "message": "Crouched ADS follows the real camera recoil direction while firing"},
    {"type": "mouse-button", "button": "left", "action": "down"},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 6},
    {"type": "wait-frames", "n": 9},
    {"type": "mouse-button", "button": "left", "action": "up"},
    {"type": "assert", "query": "game.shotSequence", "op": "ge", "value": 1},
    {"type": "assert", "query": "game.recoilActive", "op": "eq", "value": true},
    {"type": "assert", "query": "game.weaponAimError", "op": "lt", "value": 2},
    {"type": "assert", "query": "game.gripError", "op": "lt", "value": 0.03},
    {"type": "screenshot", "out": "screenshots/nextdayz_crouch_aim_firing"},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 40},
    {"type": "wait-frames", "n": 43},
    {"type": "assert", "query": "game.weaponAimError", "op": "lt", "value": 2},
    {"type": "log", "message": "Crouched FPS still raises its view model and applies ADS FOV"},
    {"type": "cvar", "name": "nextdayz.debug.orbit", "set": false},
    {"type": "cvar", "name": "nextdayz.validation.thirdPerson", "set": false},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 30},
    {"type": "wait-frames", "n": 33},
    {"type": "assert", "query": "game.firstPerson", "op": "eq", "value": true},
    {"type": "assert", "query": "game.isAiming", "op": "eq", "value": true},
    {"type": "assert", "query": "game.viewModelVisible", "op": "eq", "value": true},
    {"type": "assert", "query": "game.cameraFov", "op": "lt", "value": 56},
    {"type": "screenshot", "out": "screenshots/nextdayz_crouch_aim_fps"},
    {"type": "mouse-button", "button": "right", "action": "up"},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 30},
    {"type": "wait-frames", "n": 33},
    {"type": "assert", "query": "game.aimWeight", "op": "lt", "value": 0.01},
    {"type": "assert", "query": "game.cameraFov", "op": "gt", "value": 74},
    {"type": "quit"}
  ]
}

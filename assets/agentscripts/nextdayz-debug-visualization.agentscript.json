{
  "name": "nextdayz-debug-visualization",
  "target": "NextDayz",
  "scene": "assets/scad/proc/coldwar/riverland_1km.scad",
  "viewport": { "width": 1600, "height": 900 },
  "defaults": { "waitFrames": 2, "stepTimeoutMs": 30000 },
  "steps": [
    { "type": "wait-until", "query": "game.worldLootAnchors", "op": "ge", "value": 1, "timeoutMs": 120000 },
    { "type": "cvar", "name": "nextdayz.validation.loadout", "set": true },
    { "type": "cvar", "name": "nextdayz.validation.spawnZombie", "set": true },
    { "type": "key", "code": "F5", "action": "press" },
    { "type": "wait-frames", "n": 4 },
    { "type": "assert", "query": "game.debugVisible", "op": "eq", "value": true },
    { "type": "assert", "query": "game.debugZombieOverlay", "op": "eq", "value": true },
    { "type": "assert", "query": "game.debugLootOverlay", "op": "eq", "value": true },
    { "type": "assert", "query": "game.debugHitProxyOverlay", "op": "eq", "value": true },
    { "type": "assert", "query": "game.hitProxyRegistered", "op": "ge", "value": 1 },
    { "type": "assert", "query": "game.lootDebugEntries", "op": "ge", "value": 50 },
    { "type": "assert", "query": "game.debugEvents", "op": "ge", "value": 2 },
    { "type": "screenshot", "out": "screenshots/nextdayz_debug_world", "ui": true },

    { "type": "log", "message": "A shot: trace, noise and combat reach the debugger" },
    { "type": "mouse-button", "button": "left", "action": "down" },
    { "type": "wait-ms", "ms": 120 },
    { "type": "mouse-button", "button": "left", "action": "up" },
    { "type": "wait-frames", "n": 4 },
    { "type": "assert", "query": "game.recentWeaponTraces", "op": "ge", "value": 1 },
    { "type": "screenshot", "out": "screenshots/nextdayz_debug_shot", "ui": true },

    { "type": "log", "message": "Select the nearest infected: its tab, perception cone and hitboxes" },
    { "type": "cvar", "name": "nextdayz.debug.layers", "set": "infected,perception,hitboxes,traces,noise,spawns" },
    { "type": "cvar", "name": "nextdayz.debug.select", "set": "nearest" },
    { "type": "wait-frames", "n": 4 },
    { "type": "assert", "query": "game.debugTab", "op": "eq", "value": "Infected" },
    { "type": "assert", "query": "game.debugSelected", "op": "contains", "value": "civilian" },
    { "type": "assert", "query": "game.debugLayers", "op": "contains", "value": "perception" },
    { "type": "assert", "query": "game.debugLayers", "op": "contains", "value": "spawns" },
    { "type": "screenshot", "out": "screenshots/nextdayz_debug_infected", "ui": true },
    { "type": "cvar", "name": "nextdayz.debug.orbitDistance", "set": 7.5 },
    { "type": "cvar", "name": "nextdayz.debug.orbitHeight", "set": 1.2 },
    { "type": "cvar", "name": "nextdayz.debug.orbitYaw", "set": 160 },
    { "type": "cvar", "name": "nextdayz.debug.orbitZombie", "set": true },
    { "type": "cvar", "name": "nextdayz.debug.orbit", "set": true },
    { "type": "wait-frames", "n": 6 },
    { "type": "screenshot", "out": "screenshots/nextdayz_debug_orbit", "ui": true },
    { "type": "cvar", "name": "nextdayz.debug.orbit", "set": false },

    { "type": "log", "message": "Freeze and single-step the simulation" },
    { "type": "cvar", "name": "nextdayz.debug.freeze", "set": true },
    { "type": "wait-frames", "n": 3 },
    { "type": "assert", "query": "game.debugFrozen", "op": "eq", "value": true },
    { "type": "cvar", "name": "nextdayz.debug.step", "set": 5 },
    { "type": "wait-frames", "n": 8 },
    { "type": "assert", "query": "game.debugFrozen", "op": "eq", "value": true },
    { "type": "cvar", "name": "nextdayz.debug.freeze", "set": false },
    { "type": "wait-frames", "n": 3 },
    { "type": "assert", "query": "game.debugFrozen", "op": "eq", "value": false },

    { "type": "log", "message": "Spawn director, loot and log tabs" },
    { "type": "cvar", "name": "nextdayz.debug.tab", "set": "spawns" },
    { "type": "wait-frames", "n": 4 },
    { "type": "assert", "query": "game.debugTab", "op": "eq", "value": "Spawns" },
    { "type": "assert", "query": "game.spawnVerdict", "op": "ne", "value": "Unevaluated" },
    { "type": "screenshot", "out": "screenshots/nextdayz_debug_spawns", "ui": true },
    { "type": "cvar", "name": "nextdayz.debug.layers", "set": "loot,zones,anchors" },
    { "type": "cvar", "name": "nextdayz.debug.tab", "set": "loot" },
    { "type": "wait-frames", "n": 4 },
    { "type": "assert", "query": "game.debugTab", "op": "eq", "value": "Loot" },
    { "type": "screenshot", "out": "screenshots/nextdayz_debug_loot", "ui": true },
    { "type": "cvar", "name": "nextdayz.debug.tab", "set": "log" },
    { "type": "wait-frames", "n": 4 },
    { "type": "screenshot", "out": "screenshots/nextdayz_debug_log", "ui": true },

    { "type": "log", "message": "Snapshot of every system for agents" },
    { "type": "cvar", "name": "nextdayz.debug.dump", "set": true },
    { "type": "wait-frames", "n": 2 },
    { "type": "assert", "query": "game.debugSnapshot", "op": "contains", "value": "nextdayz_snapshot.json" },
    { "type": "quit" }
  ]
}

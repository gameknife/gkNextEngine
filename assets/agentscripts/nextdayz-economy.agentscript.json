{
  "name": "nextdayz-economy",
  "target": "NextDayz",
  "viewport": {
    "width": 1600,
    "height": 900
  },
  "args": [
    "--cvar",
    "nextdayz.validation.campaign true",
    "--cvar",
    "nextdayz.validation.campaignFresh true",
    "--cvar",
    "nextdayz.validation.campaignPath out/nextdayz-validation/economy.json"
  ],
  "defaults": {
    "waitFrames": 2,
    "stepTimeoutMs": 180000
  },
  "steps": [
    { "type": "wait-until", "query": "game.sceneReady", "op": "eq", "value": true, "timeoutMs": 60000 },
    { "type": "assert", "query": "game.cabinScene", "op": "eq", "value": true },
    { "type": "assert", "query": "game.campaignSaveBlocked", "op": "eq", "value": false },
    { "type": "assert", "query": "game.traderShelves", "op": "ge", "value": 10 },
    { "type": "assert", "query": "game.campaignGold", "op": "eq", "value": 0 },

    { "type": "log", "message": "Sell: an SVD (200) and an AK-74 (120) from storage" },
    { "type": "cvar", "name": "nextdayz.validation.give", "set": "svd" },
    { "type": "cvar", "name": "nextdayz.validation.give", "set": "ak" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "store-all" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "sell-all" },
    { "type": "assert", "query": "game.campaignGold", "op": "eq", "value": 320 },
    { "type": "assert", "query": "game.campaignStorage", "op": "eq", "value": 0 },

    { "type": "log", "message": "Buy: a first aid kit (75) and 20 rounds of 9x18 (80); the flare is tier 2" },
    { "type": "key", "code": "T", "action": "press" },
    { "type": "wait-frames", "n": 3 },
    { "type": "assert", "query": "game.cabinPanel", "op": "eq", "value": 2 },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "buy:medkit" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "buy:ammo_9mm" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "buy:signal_flare" },
    { "type": "assert", "query": "game.campaignGold", "op": "eq", "value": 165 },
    { "type": "assert", "query": "game.campaignStorage", "op": "eq", "value": 2 },
    { "type": "assert", "query": "game.sortieSpent", "op": "eq", "value": 155 },
    { "type": "wait-frames", "n": 30 },
    { "type": "screenshot", "out": "screenshots/nextdayz-economy-trader", "ui": true },

    { "type": "log", "message": "Paid landing: book Loket's third landing point (40)" },
    { "type": "cvar", "name": "nextdayz.validation.deployMap", "set": "cz_loket_riverbend" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "insert:2" },
    { "type": "assert", "query": "game.insertionMap", "op": "eq", "value": "cz_loket_riverbend" },
    { "type": "assert", "query": "game.campaignGold", "op": "eq", "value": 125 },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "insert-cancel" },
    { "type": "assert", "query": "game.campaignGold", "op": "eq", "value": 165 },
    { "type": "assert", "query": "game.insertionMap", "op": "eq", "value": "" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "insert:2" },
    { "type": "assert", "query": "game.campaignGold", "op": "eq", "value": 125 },
    { "type": "assert", "query": "game.sortieSpent", "op": "eq", "value": 195 },
    { "type": "key", "code": "M", "action": "press" },
    { "type": "wait-frames", "n": 30 },
    { "type": "assert", "query": "game.cabinPanel", "op": "eq", "value": 0 },
    { "type": "screenshot", "out": "screenshots/nextdayz-economy-landing", "ui": true },
    { "type": "key", "code": "Escape", "action": "press" },

    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "deploy" },
    { "type": "wait-until", "query": "game.campaignInField", "op": "eq", "value": true, "timeoutMs": 180000 },
    { "type": "assert", "query": "game.activeMapId", "op": "eq", "value": "cz_loket_riverbend" },
    { "type": "assert", "query": "game.insertionError", "op": "ge", "value": 0 },
    { "type": "assert", "query": "game.insertionError", "op": "le", "value": 3 },
    { "type": "assert", "query": "game.insertionMap", "op": "eq", "value": "" },

    { "type": "log", "message": "Return: the sortie is recorded and the shelves refill" },
    { "type": "cvar", "name": "nextdayz.validation.give", "set": "food_can" },
    { "type": "cvar", "name": "nextdayz.debug.expedition", "set": "return" },
    { "type": "wait-until", "query": "game.cabinScene", "op": "eq", "value": true, "timeoutMs": 60000 },
    { "type": "assert", "query": "game.campaignInField", "op": "eq", "value": false },
    { "type": "assert", "query": "game.campaignSaveBlocked", "op": "eq", "value": false },
    { "type": "assert", "query": "game.sortieHistory", "op": "eq", "value": 1 },
    { "type": "assert", "query": "game.lastSortieOutcome", "op": "eq", "value": "debug" },
    { "type": "assert", "query": "game.lastSortieSpent", "op": "eq", "value": 195 },
    { "type": "assert", "query": "game.lastSortieValue", "op": "eq", "value": 5 },
    { "type": "assert", "query": "game.lastSortieNet", "op": "eq", "value": -190 },
    { "type": "assert", "query": "game.sortieSpent", "op": "eq", "value": 0 },
    { "type": "assert", "query": "game.campaignGold", "op": "eq", "value": 125 },
    { "type": "key", "code": "T", "action": "press" },
    { "type": "wait-frames", "n": 30 },
    { "type": "assert", "query": "game.cabinPanel", "op": "eq", "value": 2 },
    { "type": "screenshot", "out": "screenshots/nextdayz-economy-report", "ui": true },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "save" },
    { "type": "quit" }
  ]
}

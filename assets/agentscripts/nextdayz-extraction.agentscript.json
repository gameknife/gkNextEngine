{
  "name": "nextdayz-extraction",
  "target": "NextDayz",
  "scene": "assets/scad/proc/coldwar/riverland_1km.scad",
  "defaults": { "waitFrames": 2, "stepTimeoutMs": 30000 },
  "viewport": { "width": 1600, "height": 900 },
  "steps": [
    { "type": "wait-until", "query": "game.sceneReady", "op": "eq", "value": true, "timeoutMs": 60000 },
    { "type": "cvar", "name": "nextdayz.validation.campaignPath", "set": "out/nextdayz-validation/extraction.json" },
    { "type": "cvar", "name": "nextdayz.validation.campaign", "set": true },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "new" },
    { "type": "assert", "query": "game.campaignSaveBlocked", "op": "eq", "value": false },
    { "type": "assert", "query": "game.extractionPoints", "op": "eq", "value": 2 },
    { "type": "assert", "query": "game.campaignInField", "op": "eq", "value": false },
    { "type": "cvar", "name": "nextdayz.validation.give", "set": "food_can:2" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "store-all" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "take-first" },
    { "type": "screenshot", "out": "screenshots/nextdayz-safehouse" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "deploy" },
    { "type": "assert", "query": "game.campaignInField", "op": "eq", "value": true },
    { "type": "cvar", "name": "nextdayz.validation.invulnerable", "set": true },
    { "type": "cvar", "name": "nextdayz.validation.give", "set": "signal_flare" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "call" },
    { "type": "assert", "query": "game.signalFlares", "op": "eq", "value": 1 },
    { "type": "assert", "query": "game.flightPhase", "op": "eq", "value": "Idle" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "pad:0" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "call" },
    { "type": "assert", "query": "game.signalFlares", "op": "eq", "value": 0 },
    { "type": "assert", "query": "game.flightPhase", "op": "eq", "value": "Inbound" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "reload" },
    { "type": "assert", "query": "game.flightPhase", "op": "eq", "value": "Inbound" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "flight:58" },
    { "type": "assert", "query": "game.flightPhase", "op": "eq", "value": "Waiting at helipad" },
    { "type": "cvar", "name": "nextdayz.validation.lookYaw", "set": 30 },
    { "type": "cvar", "name": "nextdayz.validation.lookPitch", "set": -8 },
    { "type": "screenshot", "out": "screenshots/nextdayz-rescue-rooftop" },
    { "type": "key", "code": "E", "action": "press" },
    { "type": "assert", "query": "game.flightBoarded", "op": "eq", "value": true },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "save" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "reload" },
    { "type": "assert", "query": "game.flightBoarded", "op": "eq", "value": true },
    { "type": "screenshot", "out": "screenshots/nextdayz-rescue-takeoff" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "flight:9" },
    { "type": "assert", "query": "game.campaignInField", "op": "eq", "value": false },
    { "type": "assert", "query": "game.campaignExtractions", "op": "eq", "value": 1 },
    { "type": "assert", "query": "game.campaignStorage", "op": "eq", "value": 2 },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "sell-first" },
    { "type": "assert", "query": "game.campaignGold", "op": "eq", "value": 5 },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "reload" },
    { "type": "assert", "query": "game.campaignGold", "op": "eq", "value": 5 },
    { "type": "assert", "query": "game.campaignStorage", "op": "eq", "value": 1 },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "deploy" },
    { "type": "assert", "query": "game.campaignSorties", "op": "eq", "value": 2 },
    { "type": "cvar", "name": "nextdayz.validation.give", "set": "bandage" },
    { "type": "cvar", "name": "nextdayz.validation.damagePlayer", "set": 200 },
    { "type": "wait-frames", "n": 5 },
    { "type": "assert", "query": "game.campaignInField", "op": "eq", "value": false },
    { "type": "assert", "query": "game.campaignStorage", "op": "eq", "value": 1 },
    { "type": "assert", "query": "game.campaignGold", "op": "eq", "value": 5 },
    { "type": "assert", "query": "game.lootPiles", "op": "ge", "value": 1 },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "reload" },
    { "type": "assert", "query": "game.lootPiles", "op": "ge", "value": 1 },
    { "type": "assert", "query": "game.campaignSaveBlocked", "op": "eq", "value": false },
    { "type": "screenshot", "out": "screenshots/nextdayz-death-safehouse" },
    { "type": "quit" }
  ]
}

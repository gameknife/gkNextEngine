{
  "name": "nextdayz-free-look",
  "target": "NextDayz",
  "scene": "assets/agentscripts/fixtures/nextdayz-camera-arm.scad",
  "defaults": { "waitFrames": 2, "stepTimeoutMs": 20000 },
  "viewport": { "width": 1600, "height": 900 },
  "steps": [
    { "type": "wait-until", "query": "game.sceneReady", "op": "eq", "value": true, "timeoutMs": 30000 },
    { "type": "cvar", "name": "nextdayz.debug.freezeNeeds", "set": true },
    { "type": "cvar", "name": "nextdayz.validation.teleport", "set": "40,0" },
    { "type": "cvar", "name": "nextdayz.validation.lookYaw", "set": 0 },
    { "type": "cvar", "name": "nextdayz.validation.lookPitch", "set": 0 },
    { "type": "cvar", "name": "nextdayz.validation.thirdPerson", "set": true },
    { "type": "wait-ms", "ms": 1000 },
    { "type": "mouse-move", "to": { "px": [800, 450] } },

    { "type": "log", "message": "Alt orbits the camera without turning the character or movement basis" },
    { "type": "key", "code": "LALT", "action": "down" },
    { "type": "assert", "query": "game.freeLookActive", "op": "eq", "value": true },
    { "type": "mouse-move", "relative": true, "to": { "px": [900, 100] } },
    { "type": "assert", "query": "game.playerYaw", "op": "eq", "value": 0.0 },
    { "type": "assert", "query": "game.playerPitch", "op": "eq", "value": 0.0 },
    { "type": "assert", "query": "game.cameraYaw", "op": "lt", "value": -1.9 },
    { "type": "assert", "query": "game.cameraPitch", "op": "gt", "value": 0.2 },
    { "type": "screenshot", "out": "screenshots/nextdayz_free_look_front" },
    { "type": "key", "code": "W", "action": "down" },
    { "type": "wait-ms", "ms": 600 },
    { "type": "assert", "query": "game.posX", "op": "gt", "value": 39.9 },
    { "type": "assert", "query": "game.posX", "op": "lt", "value": 40.1 },
    { "type": "assert", "query": "game.posZ", "op": "gt", "value": 1.0 },
    { "type": "assert", "query": "game.playerYaw", "op": "eq", "value": 0.0 },
    { "type": "key", "code": "W", "action": "up" },
    { "type": "key", "code": "LALT", "action": "up" },
    { "type": "assert", "query": "game.freeLookActive", "op": "eq", "value": false },
    { "type": "assert", "query": "game.cameraYaw", "op": "eq", "value": 0.0 },
    { "type": "assert", "query": "game.cameraPitch", "op": "eq", "value": 0.0 },
    { "type": "screenshot", "out": "screenshots/nextdayz_free_look_restored" },
    { "type": "mouse-move", "relative": true, "to": { "px": [100, -50] } },
    { "type": "assert", "query": "game.playerYaw", "op": "lt", "value": -0.2 },
    { "type": "assert", "query": "game.playerPitch", "op": "lt", "value": -0.1 },
    { "type": "mouse-move", "relative": true, "to": { "px": [-100, 50] } },

    { "type": "log", "message": "Either Alt works; releasing one does not cancel the other" },
    { "type": "key", "code": "RALT", "action": "down" },
    { "type": "mouse-move", "relative": true, "to": { "px": [100, 50] } },
    { "type": "assert", "query": "game.freeLookActive", "op": "eq", "value": true },
    { "type": "key", "code": "LALT", "action": "down" },
    { "type": "key", "code": "RALT", "action": "up" },
    { "type": "assert", "query": "game.freeLookActive", "op": "eq", "value": true },
    { "type": "key", "code": "LALT", "action": "up" },
    { "type": "assert", "query": "game.freeLookActive", "op": "eq", "value": false },

    { "type": "log", "message": "Orbit collision and pitch limits remain active" },
    { "type": "cvar", "name": "nextdayz.validation.teleport", "set": "0,0" },
    { "type": "cvar", "name": "nextdayz.validation.lookYaw", "set": 180 },
    { "type": "cvar", "name": "nextdayz.validation.lookPitch", "set": 0 },
    { "type": "wait-ms", "ms": 1200 },
    { "type": "key", "code": "LALT", "action": "down" },
    { "type": "mouse-move", "relative": true, "to": { "px": [1428, 0] } },
    { "type": "assert", "query": "game.cameraArmLength", "op": "lt", "value": 1.0 },
    { "type": "assert", "query": "game.playerYaw", "op": "gt", "value": 3.14 },
    { "type": "mouse-move", "relative": true, "to": { "px": [0, 10000] } },
    { "type": "assert", "query": "game.cameraPitch", "op": "gt", "value": 1.48 },
    { "type": "assert", "query": "game.cameraPitch", "op": "lt", "value": 1.49 },
    { "type": "key", "code": "LALT", "action": "up" },
    { "type": "assert", "query": "game.cameraPitch", "op": "eq", "value": 0.0 },

    { "type": "log", "message": "Fire and aim restore the normal view, including a nonzero saved pitch and yaw" },
    { "type": "cvar", "name": "nextdayz.validation.lookYaw", "set": 35 },
    { "type": "cvar", "name": "nextdayz.validation.lookPitch", "set": 12 },
    { "type": "key", "code": "LALT", "action": "down" },
    { "type": "mouse-move", "relative": true, "to": { "px": [200, -200] } },
    { "type": "mouse-button", "button": "left", "action": "down" },
    { "type": "assert", "query": "game.freeLookActive", "op": "eq", "value": false },
    { "type": "assert", "query": "game.cameraYaw", "op": "gt", "value": 0.610 },
    { "type": "assert", "query": "game.cameraYaw", "op": "lt", "value": 0.612 },
    { "type": "assert", "query": "game.cameraPitch", "op": "gt", "value": 0.209 },
    { "type": "assert", "query": "game.cameraPitch", "op": "lt", "value": 0.210 },
    { "type": "key", "code": "LALT", "action": "up" },
    { "type": "key", "code": "LALT", "action": "down" },
    { "type": "assert", "query": "game.freeLookActive", "op": "eq", "value": false },
    { "type": "mouse-button", "button": "left", "action": "up" },
    { "type": "key", "code": "LALT", "action": "up" },
    { "type": "key", "code": "LALT", "action": "down" },
    { "type": "assert", "query": "game.freeLookActive", "op": "eq", "value": true },
    { "type": "mouse-button", "button": "right", "action": "down" },
    { "type": "assert", "query": "game.freeLookActive", "op": "eq", "value": false },
    { "type": "key", "code": "LALT", "action": "up" },
    { "type": "key", "code": "LALT", "action": "down" },
    { "type": "assert", "query": "game.freeLookActive", "op": "eq", "value": false },
    { "type": "mouse-button", "button": "right", "action": "up" },
    { "type": "key", "code": "LALT", "action": "up" },

    { "type": "log", "message": "Inventory and view changes clear the orbit; first person keeps normal look" },
    { "type": "key", "code": "LALT", "action": "down" },
    { "type": "key", "code": "TAB", "action": "press" },
    { "type": "assert", "query": "game.freeLookActive", "op": "eq", "value": false },
    { "type": "key", "code": "LALT", "action": "up" },
    { "type": "key", "code": "TAB", "action": "press" },
    { "type": "key", "code": "LALT", "action": "down" },
    { "type": "key", "code": "V", "action": "press" },
    { "type": "assert", "query": "game.freeLookActive", "op": "eq", "value": false },
    { "type": "assert", "query": "game.firstPerson", "op": "eq", "value": true },
    { "type": "key", "code": "LALT", "action": "up" },
    { "type": "key", "code": "RALT", "action": "down" },
    { "type": "assert", "query": "game.freeLookActive", "op": "eq", "value": false },
    { "type": "key", "code": "RALT", "action": "up" },
    { "type": "quit" }
  ]
}

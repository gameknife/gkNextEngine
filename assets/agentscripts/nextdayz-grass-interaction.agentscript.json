{
  "name": "nextdayz-grass-interaction",
  "target": "NextDayz",
  "scene": "assets/scad/proc/coldwar/riverland_1km.scad",
  "defaults": { "waitFrames": 2, "stepTimeoutMs": 30000 },
  "viewport": { "width": 1600, "height": 900 },
  "steps": [
    { "type": "wait-until", "query": "game.sceneReady", "op": "eq", "value": true, "timeoutMs": 60000 },
    { "type": "cvar", "name": "nextdayz.validation.invulnerable", "set": true },
    { "type": "cvar", "name": "nextdayz.debug.hour", "set": 12 },
    { "type": "cvar", "name": "nextdayz.debug.weather", "set": 0 },
    { "type": "cvar", "name": "nextdayz.grass.windSpeed", "set": 0 },
    { "type": "cvar", "name": "nextdayz.grass.playerInteraction", "set": false },
    { "type": "cvar", "name": "nextdayz.grass.zombieInteraction", "set": false },
    { "type": "cvar", "name": "nextdayz.validation.teleport", "set": "-180,-285" },
    { "type": "cvar", "name": "nextdayz.validation.lookYaw", "set": 85 },
    { "type": "cvar", "name": "nextdayz.validation.lookPitch", "set": 28 },
    { "type": "cvar", "name": "nextdayz.validation.thirdPerson", "set": true },
    { "type": "cvar", "name": "r.rendererType", "set": 0 },
    { "type": "cvar", "name": "r.exposure.auto", "set": false },
    { "type": "wait-ms", "ms": 500 },
    { "type": "assert", "query": "game.grassContactCount", "op": "eq", "value": 0 },
    { "type": "screenshot", "out": "screenshots/grass_contact_off" },
    { "type": "cvar", "name": "nextdayz.grass.playerInteraction", "set": true },
    { "type": "wait-ms", "ms": 400 },
    { "type": "assert", "query": "game.grassContactCount", "op": "gt", "value": 0 },
    { "type": "assert", "query": "game.grassMaxPressure", "op": "gt", "value": 0.1 },
    { "type": "screenshot", "out": "screenshots/grass_player_standing" },
    { "type": "key", "code": "LSHIFT", "action": "down" },
    { "type": "key", "code": "W", "action": "down" },
    { "type": "wait-ms", "ms": 1200 },
    { "type": "assert", "query": "game.grassInteractionCount", "op": "gt", "value": 8 },
    { "type": "assert", "query": "game.grassMaxPressure", "op": "gt", "value": 0.2 },
    { "type": "assert", "query": "game.grassContactChecks", "op": "lt", "value": 3000 },
    { "type": "screenshot", "out": "screenshots/grass_player_running" },
    { "type": "key", "code": "W", "action": "up" },
    { "type": "key", "code": "LSHIFT", "action": "up" },
    { "type": "wait-ms", "ms": 200 },
    { "type": "screenshot", "out": "screenshots/grass_player_trail" },
    { "type": "cvar", "name": "nextdayz.grass.playerInteraction", "set": false },
    { "type": "assert", "query": "game.grassInteractionCount", "op": "gt", "value": 0 },
    { "type": "wait-ms", "ms": 4000 },
    { "type": "assert", "query": "game.grassContactCount", "op": "eq", "value": 0 },
    { "type": "assert", "query": "game.grassInteractionCount", "op": "eq", "value": 0 },
    { "type": "screenshot", "out": "screenshots/grass_player_recovered" },
    { "type": "cvar", "name": "nextdayz.grass.zombieInteraction", "set": true },
    { "type": "cvar", "name": "nextdayz.validation.zombieDistance", "set": 5 },
    { "type": "cvar", "name": "nextdayz.validation.spawnZombie", "set": true },
    { "type": "wait-ms", "ms": 700 },
    { "type": "assert", "query": "game.grassContactCount", "op": "gt", "value": 0 },
    { "type": "assert", "query": "game.grassMaxPressure", "op": "gt", "value": 0.1 },
    { "type": "screenshot", "out": "screenshots/grass_zombie_running" },
    { "type": "cvar", "name": "r.rendererType", "set": 4 },
    { "type": "wait-ms", "ms": 400 },
    { "type": "screenshot", "out": "screenshots/grass_contact_raster" },
    { "type": "assert", "query": "game.grassMeshes", "op": "eq", "value": 27 },
    { "type": "assert", "query": "game.grassPoolSize", "op": "le", "value": 42000 },
    { "type": "cvar", "name": "nextdayz.grass.zombieInteraction", "set": false },
    { "type": "wait-ms", "ms": 4000 },
    { "type": "assert", "query": "game.grassInteractionCount", "op": "eq", "value": 0 },
    { "type": "cvar", "name": "nextdayz.grass.playerInteraction", "set": true },
    { "type": "cvar", "name": "nextdayz.grass.zombieInteraction", "set": true },
    { "type": "cvar", "name": "nextdayz.grass.windSpeed", "set": 1 },
    { "type": "cvar", "name": "r.exposure.auto", "set": true },
    { "type": "cvar", "name": "r.rendererType", "set": 0 },
    { "type": "quit" }
  ]
}

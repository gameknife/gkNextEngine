{
  "name": "nextdayz-grass-lighting",
  "target": "NextDayz",
  "scene": "assets/scad/proc/coldwar/riverland_1km.scad",
  "defaults": { "waitFrames": 2, "stepTimeoutMs": 30000 },
  "viewport": { "width": 1600, "height": 900 },
  "steps": [
    { "type": "wait-until", "query": "game.sceneReady", "op": "eq", "value": true, "timeoutMs": 60000 },
    { "type": "cvar", "name": "nextdayz.validation.invulnerable", "set": true },
    { "type": "cvar", "name": "nextdayz.debug.hour", "set": 12 },
    { "type": "cvar", "name": "nextdayz.debug.weather", "set": 0 },
    { "type": "cvar", "name": "nextdayz.debug.timeScale", "set": 0 },
    { "type": "cvar", "name": "nextdayz.grass.windSpeed", "set": 0 },
    { "type": "cvar", "name": "nextdayz.validation.teleport", "set": "-180,-285" },
    { "type": "cvar", "name": "nextdayz.validation.lookYaw", "set": 85 },
    { "type": "cvar", "name": "nextdayz.validation.lookPitch", "set": 10 },
    { "type": "cvar", "name": "r.exposure.auto", "set": false },
    { "type": "cvar", "name": "r.rendererType", "set": 4 },
    { "type": "cvar", "name": "nextdayz.grass.transmission", "set": 0 },
    { "type": "wait-frames", "n": 90 },
    { "type": "assert", "query": "game.grassInstances", "op": "gt", "value": 1000 },
    { "type": "screenshot", "out": "screenshots/grass_noambient_opaque" },
    { "type": "cvar", "name": "nextdayz.grass.transmission", "set": 1.0 },
    { "type": "wait-frames", "n": 60 },
    { "type": "screenshot", "out": "screenshots/grass_noambient_translucent" },
    { "type": "cvar", "name": "r.rendererType", "set": 2 },
    { "type": "cvar", "name": "nextdayz.grass.transmission", "set": 0 },
    { "type": "wait-frames", "n": 90 },
    { "type": "screenshot", "out": "screenshots/grass_modern_opaque" },
    { "type": "cvar", "name": "nextdayz.grass.transmission", "set": 1.0 },
    { "type": "wait-frames", "n": 60 },
    { "type": "screenshot", "out": "screenshots/grass_modern_translucent" },
    { "type": "cvar", "name": "r.rendererType", "set": 1 },
    { "type": "cvar", "name": "nextdayz.grass.transmission", "set": 0 },
    { "type": "wait-frames", "n": 90 },
    { "type": "screenshot", "out": "screenshots/grass_swtracing_opaque" },
    { "type": "cvar", "name": "nextdayz.grass.transmission", "set": 1.0 },
    { "type": "wait-frames", "n": 60 },
    { "type": "screenshot", "out": "screenshots/grass_swtracing_translucent" },
    { "type": "cvar", "name": "r.rendererType", "set": 4 },
    { "type": "cvar", "name": "nextdayz.debug.hour", "set": 8 },
    { "type": "cvar", "name": "nextdayz.validation.teleport", "set": "-250,-205" },
    { "type": "cvar", "name": "nextdayz.grass.transmission", "set": 0 },
    { "type": "wait-frames", "n": 60 },
    { "type": "screenshot", "out": "screenshots/grass_building_shadow_opaque" },
    { "type": "cvar", "name": "nextdayz.grass.transmission", "set": 1.0 },
    { "type": "wait-frames", "n": 60 },
    { "type": "screenshot", "out": "screenshots/grass_building_shadow_translucent" },
    { "type": "cvar", "name": "nextdayz.debug.hour", "set": 12 },
    { "type": "cvar", "name": "nextdayz.validation.teleport", "set": "-180,-285" },
    { "type": "cvar", "name": "r.rendererType", "set": 0 },
    { "type": "cvar", "name": "nextdayz.grass.transmission", "set": 0 },
    { "type": "wait-frames", "n": 90 },
    { "type": "screenshot", "out": "screenshots/grass_pathtracing_opaque" },
    { "type": "cvar", "name": "nextdayz.grass.transmission", "set": 0.7 },
    { "type": "wait-frames", "n": 90 },
    { "type": "screenshot", "out": "screenshots/grass_pathtracing_transmission_07" },
    { "type": "cvar", "name": "nextdayz.grass.transmission", "set": 1.0 },
    { "type": "wait-frames", "n": 90 },
    { "type": "screenshot", "out": "screenshots/grass_pathtracing_translucent" },
    { "type": "cvar", "name": "r.rendererType", "set": 5 },
    { "type": "cvar", "name": "nextdayz.grass.transmission", "set": 0 },
    { "type": "wait-frames", "n": 90 },
    { "type": "screenshot", "out": "screenshots/grass_pathtracing_lite_opaque" },
    { "type": "cvar", "name": "nextdayz.grass.transmission", "set": 1.0 },
    { "type": "wait-frames", "n": 90 },
    { "type": "screenshot", "out": "screenshots/grass_pathtracing_lite_translucent" },
    { "type": "cvar", "name": "r.rendererType", "set": 0 },
    { "type": "cvar", "name": "r.exposure.auto", "set": true },
    { "type": "cvar", "name": "nextdayz.grass.windSpeed", "set": 1 },
    { "type": "cvar", "name": "nextdayz.debug.timeScale", "set": 1 },
    { "type": "quit" }
  ]
}

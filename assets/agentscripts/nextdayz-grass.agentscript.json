{
  "name": "nextdayz-grass",
  "target": "NextDayz",
  "scene": "assets/scad/proc/coldwar/riverland_1km.scad",
  "defaults": { "waitFrames": 2, "stepTimeoutMs": 30000 },
  "viewport": { "width": 1600, "height": 900 },
  "steps": [
    { "type": "wait-until", "query": "game.sceneReady", "op": "eq", "value": true, "timeoutMs": 60000 },
    { "type": "cvar", "name": "nextdayz.validation.invulnerable", "set": true },
    { "type": "cvar", "name": "nextdayz.debug.hour", "set": 12 },
    { "type": "cvar", "name": "nextdayz.debug.weather", "set": 0 },
    { "type": "cvar", "name": "nextdayz.validation.teleport", "set": "-180,-285" },
    { "type": "cvar", "name": "nextdayz.validation.lookYaw", "set": -35 },
    { "type": "cvar", "name": "nextdayz.validation.lookPitch", "set": 10 },
    { "type": "wait-frames", "n": 90 },
    { "type": "assert", "query": "game.grassMeshes", "op": "eq", "value": 27 },
    { "type": "assert", "query": "game.grassInstances", "op": "gt", "value": 14000 },
    { "type": "assert", "query": "game.grassPoolSize", "op": "le", "value": 42000 },
    { "type": "assert", "query": "game.grassMidInstances", "op": "gt", "value": 100 },
    { "type": "assert", "query": "game.grassFarInstances", "op": "gt", "value": 100 },
    { "type": "assert", "query": "game.grassFarthestDistance", "op": "gt", "value": 185 },
    { "type": "assert", "query": "game.grassFarthestDistance", "op": "lt", "value": 192 },
    { "type": "screenshot", "out": "screenshots/nextdayz_meadow" },
    { "type": "cvar", "name": "nextdayz.grass.windSpeed", "set": 0 },
    { "type": "cvar", "name": "nextdayz.grass.radius", "set": 48 },
    { "type": "wait-frames", "n": 30 },
    { "type": "assert", "query": "game.grassFarInstances", "op": "eq", "value": 0 },
    { "type": "assert", "query": "game.grassFarthestDistance", "op": "lt", "value": 48 },
    { "type": "screenshot", "out": "screenshots/nextdayz_meadow_48m" },
    { "type": "cvar", "name": "nextdayz.grass.radius", "set": 192 },
    { "type": "wait-frames", "n": 30 },
    { "type": "assert", "query": "game.grassFarthestDistance", "op": "gt", "value": 185 },
    { "type": "screenshot", "out": "screenshots/nextdayz_meadow_192m" },
    { "type": "cvar", "name": "nextdayz.grass.windSpeed", "set": 1 },
    { "type": "cvar", "name": "nextdayz.grass.windStrength", "set": 1 },
    { "type": "cvar", "name": "nextdayz.grass.windYaw", "set": 2.5 },
    { "type": "wait-ms", "ms": 2500 },
    { "type": "assert", "query": "game.grassPoseChanges", "op": "gt", "value": 1000 },
    { "type": "screenshot", "out": "screenshots/nextdayz_meadow_wind" },
    { "type": "cvar", "name": "nextdayz.grass.enabled", "set": false },
    { "type": "wait-frames", "n": 30 },
    { "type": "assert", "query": "game.grassInstances", "op": "eq", "value": 0 },
    { "type": "screenshot", "out": "screenshots/nextdayz_meadow_off" },
    { "type": "cvar", "name": "nextdayz.grass.enabled", "set": true },
    { "type": "wait-frames", "n": 30 },
    { "type": "assert", "query": "game.grassInstances", "op": "gt", "value": 1000 },
    { "type": "cvar", "name": "nextdayz.validation.teleport", "set": "300,-390" },
    { "type": "wait-frames", "n": 60 },
    { "type": "assert", "query": "game.grassInstances", "op": "gt", "value": 1000 },
    { "type": "assert", "query": "game.grassMeshes", "op": "eq", "value": 27 },
    { "type": "assert", "query": "game.grassPoolSize", "op": "le", "value": 42000 },
    { "type": "assert", "query": "game.grassFarInstances", "op": "gt", "value": 100 },
    { "type": "assert", "query": "game.grassFarthestDistance", "op": "gt", "value": 185 },
    { "type": "screenshot", "out": "screenshots/nextdayz_meadow_streamed" },
    { "type": "cvar", "name": "r.rendererType", "set": 4 },
    { "type": "wait-frames", "n": 60 },
    { "type": "assert", "query": "game.grassInstances", "op": "gt", "value": 1000 },
    { "type": "screenshot", "out": "screenshots/nextdayz_meadow_raster" },
    { "type": "cvar", "name": "r.rendererType", "set": 0 },
    { "type": "wait-frames", "n": 20 },
    { "type": "cvar", "name": "nextdayz.validation.teleport", "set": "-120,-150" },
    { "type": "cvar", "name": "nextdayz.validation.lookYaw", "set": 85 },
    { "type": "cvar", "name": "nextdayz.validation.lookPitch", "set": 12 },
    { "type": "cvar", "name": "nextdayz.grass.windSpeed", "set": 0 },
    { "type": "cvar", "name": "nextdayz.grass.edgeWidth", "set": 0 },
    { "type": "wait-frames", "n": 60 },
    { "type": "assert", "query": "game.grassEdgeInstances", "op": "eq", "value": 0 },
    { "type": "screenshot", "out": "screenshots/nextdayz_road_hard_edge" },
    { "type": "cvar", "name": "nextdayz.grass.edgeWidth", "set": 4 },
    { "type": "wait-frames", "n": 60 },
    { "type": "assert", "query": "game.grassEdgeInstances", "op": "gt", "value": 0 },
    { "type": "screenshot", "out": "screenshots/nextdayz_road_soft_edge" },
    { "type": "quit" }
  ]
}

{
  "name": "nextdayz-inventory-preview",
  "target": "NextDayz",
  "scene": "assets/scad/tests/nextdayz_melee.scad",
  "args": ["--system-dpi-scaling"],
  "defaults": {"waitFrames": 3, "stepTimeoutMs": 20000},
  "viewport": {"width": 1920, "height": 1080},
  "steps": [
    {"type": "wait-until", "query": "game.sceneReady", "op": "eq", "value": true, "timeoutMs": 30000},
    {"type": "cvar", "name": "nextdayz.debug.freezeNeeds", "set": true},
    {"type": "cvar", "name": "nextdayz.validation.loadout", "set": true},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "jacket"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "jacket"},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "helmet"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "helmet"},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "work_pants"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "work_pants"},
    {"type": "wait-frames", "n": 30},
    {"type": "key", "code": "TAB", "action": "press"},
    {"type": "assert", "query": "game.inventoryOpen", "op": "eq", "value": true},
    {"type": "wait-until", "query": "game.inventoryPreviewReady", "op": "eq", "value": true},
    {"type": "log", "message": "Change weapon geometry while the preview is already live"},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "svd"},
    {"type": "cvar", "name": "nextdayz.validation.equip", "set": "2:svd"},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "pistol"},
    {"type": "cvar", "name": "nextdayz.validation.equip", "set": "3:pistol"},
    {"type": "key", "code": "1", "action": "press"},
    {"type": "wait-ms", "ms": 1000},
    {"type": "assert", "query": "game.weaponSlot2", "op": "eq", "value": "svd"},
    {"type": "assert", "query": "game.weaponSlot3", "op": "eq", "value": "pistol"},
    {"type": "assert", "query": "game.heldWeaponVisible", "op": "eq", "value": true},
    {"type": "wait-frames", "n": 15},
    {"type": "screenshot", "out": "screenshots/nextdayz_inventory_preview_front", "ui": true},
    {"type": "mouse-move", "to": {"norm": [0.32, 0.4]}},
    {"type": "mouse-button", "button": "left", "action": "down"},
    {"type": "mouse-move", "to": {"norm": [0.46, 0.4]}},
    {"type": "mouse-button", "button": "left", "action": "up"},
    {"type": "mouse-move", "to": {"norm": [0.32, 0.6]}},
    {"type": "wait-frames", "n": 10},
    {"type": "screenshot", "out": "screenshots/nextdayz_inventory_preview_rotated", "ui": true},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "helmet"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "jacket"},
    {"type": "wait-frames", "n": 10},
    {"type": "screenshot", "out": "screenshots/nextdayz_inventory_preview_changed", "ui": true},
    {"type": "key", "code": "TAB", "action": "press"},
    {"type": "assert", "query": "game.inventoryOpen", "op": "eq", "value": false},
    {"type": "wait-frames", "n": 10},
    {"type": "key", "code": "TAB", "action": "press"},
    {"type": "wait-until", "query": "game.inventoryPreviewReady", "op": "eq", "value": true},
    {"type": "wait-frames", "n": 10},
    {"type": "screenshot", "out": "screenshots/nextdayz_inventory_preview_reopened", "ui": true},
    {"type": "mouse-move", "to": {"norm": [0.96, 0.03]}},
    {"type": "mouse-button", "button": "left", "action": "down"},
    {"type": "wait-frames", "n": 3},
    {"type": "mouse-button", "button": "left", "action": "up"},
    {"type": "wait-until", "query": "game.inventoryOpen", "op": "eq", "value": false},
    {"type": "cvar", "name": "nextdayz.validation.thirdPerson", "set": true},
    {"type": "key", "code": "TAB", "action": "press"},
    {"type": "wait-frames", "n": 10},
    {"type": "assert", "query": "game.inventoryPreviewReady", "op": "eq", "value": true},
    {"type": "quit"}
  ]
}

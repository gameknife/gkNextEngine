{
  "name": "nextdayz-inventory-smoke",
  "target": "NextDayz",
  "scene": "assets/scad/proc/coldwar/riverland_1km.scad",
  "defaults": { "waitFrames": 2, "stepTimeoutMs": 20000 },
  "viewport": { "width": 1920, "height": 1080 },
  "steps": [
    { "type": "wait-until", "query": "engine.status", "op": "eq", "value": "Running", "timeoutMs": 20000 },
    { "type": "wait-until", "query": "game.sceneReady", "op": "eq", "value": true, "timeoutMs": 30000 },
    { "type": "wait-frames", "n": 30 },
    { "type": "log", "message": "Opening NextDayz Inventory with TAB" },
    { "type": "key", "code": "TAB", "action": "press" },
    { "type": "wait-frames", "n": 20 },
    { "type": "screenshot", "out": "screenshots/nextdayz_inventory_open", "ui": true },
    { "type": "wait-frames", "n": 10 },
    { "type": "quit" }
  ]
}

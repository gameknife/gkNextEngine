{
  "name": "nextdayz-inventory-stacks",
  "target": "NextDayz",
  "scene": "assets/scad/tests/nextdayz_melee.scad",
  "args": [
    "--system-dpi-scaling"
  ],
  "defaults": {
    "waitFrames": 3,
    "stepTimeoutMs": 20000
  },
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "steps": [
    {
      "type": "wait-until",
      "query": "game.sceneReady",
      "op": "eq",
      "value": true,
      "timeoutMs": 30000
    },
    {
      "type": "cvar",
      "name": "nextdayz.debug.freezeNeeds",
      "set": true
    },
    {
      "type": "log",
      "message": "Ground ammo merges into a partially full stack even when hovering its second grid cell; overflow stays on the ground"
    },
    {
      "type": "cvar",
      "name": "nextdayz.validation.give",
      "set": "ammo_545:40"
    },
    {
      "type": "cvar",
      "name": "nextdayz.validation.drop",
      "set": ""
    },
    {
      "type": "cvar",
      "name": "nextdayz.validation.drop",
      "set": "ammo_545"
    },
    {
      "type": "key",
      "code": "TAB",
      "action": "press"
    },
    {
      "type": "wait-frames",
      "n": 10
    },
    {
      "type": "assert",
      "query": "game.inventoryContents",
      "op": "contains",
      "value": "ammo_545@Basic trouser pockets:10;"
    },
    {
      "type": "mouse-move",
      "to": {
        "norm": [
          0.1,
          0.132
        ]
      }
    },
    {
      "type": "mouse-button",
      "button": "left",
      "action": "down"
    },
    {
      "type": "mouse-move",
      "to": {
        "norm": [
          0.726,
          0.27
        ]
      }
    },
    {
      "type": "wait-frames",
      "n": 5
    },
    {
      "type": "screenshot",
      "out": "screenshots/nextdayz_stacks_ground_preview",
      "ui": true
    },
    {
      "type": "mouse-button",
      "button": "left",
      "action": "up"
    },
    {
      "type": "wait-frames",
      "n": 5
    },
    {
      "type": "wait-ms",
      "ms": 1300
    },
    {
      "type": "assert",
      "query": "game.inventoryContents",
      "op": "contains",
      "value": "ammo_545@Basic trouser pockets:30;"
    },
    {
      "type": "assert",
      "query": "game.lootRemaining",
      "op": "eq",
      "value": 1
    },
    {
      "type": "screenshot",
      "out": "screenshots/nextdayz_stacks_overflow_remains",
      "ui": true
    },
    {
      "type": "log",
      "message": "A full ammo stack rejects another drop without deleting the ground remainder"

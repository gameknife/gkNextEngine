{
  "name": "nextdayz-inventory-transfer",
  "target": "NextDayz",
  "scene": "assets/scad/tests/nextdayz_melee.scad",
  "args": ["--system-dpi-scaling"],
  "defaults": {"waitFrames": 3, "stepTimeoutMs": 20000},
  "viewport": {"width": 1920, "height": 1080},
  "steps": [
    {"type": "wait-until", "query": "game.sceneReady", "op": "eq", "value": true, "timeoutMs": 30000},
    {"type": "cvar", "name": "nextdayz.validation.teleport", "set": "0,0"},
    {"type": "cvar", "name": "nextdayz.debug.freezeNeeds", "set": true},
    {"type": "key", "code": "TAB", "action": "press"},
    {"type": "wait-frames", "n": 10},
    {"type": "log", "message": "Move between containers using the first empty cell and an occupied cell"},
    {"type": "mouse-move", "to": {"norm": [0.575, 0.318]}},
    {"type": "mouse-button", "button": "left", "action": "down"},
    {"type": "mouse-move", "to": {"norm": [0.575, 0.425]}},
    {"type": "wait-frames", "n": 5},
    {"type": "mouse-button", "button": "left", "action": "up"},
    {"type": "assert", "query": "game.inventoryContents", "op": "contains", "value": "bandage@Basic trouser pockets:1;"},
    {"type": "mouse-move", "to": {"norm": [0.575, 0.425]}},
    {"type": "mouse-button", "button": "left", "action": "down"},
    {"type": "mouse-move", "to": {"norm": [0.575, 0.318]}},
    {"type": "wait-frames", "n": 5},
    {"type": "mouse-button", "button": "left", "action": "up"},
    {"type": "assert", "query": "game.inventoryContents", "op": "contains", "value": "bandage@Basic shirt pockets:1;"},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "water_bottle"},
    {"type": "cvar", "name": "nextdayz.validation.drop", "set": "water_bottle"},
    {"type": "wait-frames", "n": 10},
    {"type": "screenshot", "out": "screenshots/nextdayz_transfer_before", "ui": true},
    {"type": "log", "message": "Drag the vicinity card into the selected container, preserving the loot action"},
    {"type": "mouse-move", "to": {"norm": [0.27, 0.27]}},
    {"type": "mouse-button", "button": "left", "action": "down"},
    {"type": "mouse-move", "to": {"norm": [0.575, 0.425]}},
    {"type": "wait-frames", "n": 5},
    {"type": "mouse-button", "button": "left", "action": "up"},
    {"type": "wait-ms", "ms": 1200},
    {"type": "assert", "query": "game.inventoryContents", "op": "contains", "value": "water_bottle@Basic trouser pockets:1;"},
    {"type": "log", "message": "The Take button has a separate hit area from the drag source"},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "food_crackers"},
    {"type": "cvar", "name": "nextdayz.validation.drop", "set": "food_crackers"},
    {"type": "wait-frames", "n": 10},
    {"type": "click", "at": {"norm": [0.205, 0.27]}, "button": "left"},
    {"type": "wait-ms", "ms": 1200},
    {"type": "assert", "query": "game.inventoryContents", "op": "contains", "value": "food_crackers@Basic shirt pockets:1;"},
    {"type": "cvar", "name": "nextdayz.validation.restart", "set": true},
    {"type": "wait-frames", "n": 10},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "backpack"},
    {"type": "cvar", "name": "nextdayz.validation.drop", "set": "backpack"},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "medkit"},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "fuel"},
    {"type": "assert", "query": "game.inventoryUsed", "op": "eq", "value": 10},
    {"type": "key", "code": "TAB", "action": "press"},
    {"type": "wait-frames", "n": 10},
    {"type": "log", "message": "A ground backpack equips even with completely full cargo"},
    {"type": "mouse-move", "to": {"norm": [0.27, 0.27]}},
    {"type": "mouse-button", "button": "left", "action": "down"},
    {"type": "mouse-move", "to": {"norm": [0.45, 0.48]}},
    {"type": "wait-frames", "n": 5},
    {"type": "mouse-button", "button": "left", "action": "up"},
    {"type": "wait-ms", "ms": 1200},
    {"type": "assert", "query": "game.inventoryCapacity", "op": "eq", "value": 38},
    {"type": "assert", "query": "game.inventoryContents", "op": "contains", "value": "backpack@worn:1;"},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "jacket"},
    {"type": "log", "message": "Drag cargo clothing directly onto the body with full pockets"},
    {"type": "mouse-move", "to": {"norm": [0.7, 0.6]}},
    {"type": "scroll", "y": -20},
    {"type": "wait-frames", "n": 20},
    {"type": "mouse-move", "to": {"norm": [0.575, 0.49]}},
    {"type": "mouse-button", "button": "left", "action": "down"},
    {"type": "mouse-move", "to": {"norm": [0.45, 0.32]}},
    {"type": "wait-frames", "n": 5},
    {"type": "mouse-button", "button": "left", "action": "up"},
    {"type": "assert", "query": "game.inventoryContents", "op": "contains", "value": "jacket@worn:1;"},
    {"type": "assert", "query": "game.inventoryCapacity", "op": "eq", "value": 50},
    {"type": "cvar", "name": "nextdayz.validation.drop", "set": "jacket"},
    {"type": "wait-frames", "n": 10},
    {"type": "mouse-move", "to": {"norm": [0.27, 0.27]}},
    {"type": "mouse-button", "button": "left", "action": "down"},
    {"type": "mouse-move", "to": {"norm": [0.45, 0.27]}},
    {"type": "wait-frames", "n": 5},
    {"type": "mouse-button", "button": "left", "action": "up"},
    {"type": "wait-ms", "ms": 1000},
    {"type": "assert", "query": "game.inventoryCapacity", "op": "eq", "value": 38},
    {"type": "mouse-move", "to": {"norm": [0.27, 0.27]}},
    {"type": "mouse-button", "button": "left", "action": "down"},
    {"type": "mouse-move", "to": {"norm": [0.45, 0.32]}},
    {"type": "wait-frames", "n": 5},
    {"type": "mouse-button", "button": "left", "action": "up"},
    {"type": "wait-ms", "ms": 1200},
    {"type": "assert", "query": "game.inventoryContents", "op": "contains", "value": "jacket@worn:1;"},
    {"type": "assert", "query": "game.inventoryCapacity", "op": "eq", "value": 50},
    {"type": "mouse-move", "to": {"norm": [0.7, 0.6]}},
    {"type": "scroll", "y": -20},
    {"type": "wait-frames", "n": 20},
    {"type": "screenshot", "out": "screenshots/nextdayz_transfer_large_containers", "ui": true},
    {"type": "log", "message": "Worn clothing can be dragged back into a chosen cargo container"},
    {"type": "mouse-move", "to": {"norm": [0.45, 0.32]}},
    {"type": "mouse-button", "button": "left", "action": "down"},
    {"type": "mouse-move", "to": {"norm": [0.65, 0.235]}},
    {"type": "wait-frames", "n": 5},
    {"type": "mouse-button", "button": "left", "action": "up"},
    {"type": "assert", "query": "game.inventoryContents", "op": "contains", "value": "jacket@Backpack:1;"},
    {"type": "assert", "query": "game.inventoryCapacity", "op": "eq", "value": 38},
    {"type": "quit"}
  ]
}

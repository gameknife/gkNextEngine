{
  "name": "nextdayz-localization",
  "target": "NextDayz",
  "scene": "assets/agentscripts/fixtures/nextdayz-traversal.scad",
  "viewport": { "width": 1600, "height": 900 },
  "defaults": { "waitFrames": 2, "stepTimeoutMs": 120000 },
  "steps": [
    { "type": "wait-until", "query": "game.sceneReady", "op": "eq", "value": true, "timeoutMs": 120000 },
    { "type": "cvar", "name": "nextdayz.debug.freeze", "set": true },
    { "type": "assert", "query": "game.language", "op": "eq", "value": "zhCN" },
    { "type": "assert", "query": "game.lastNotification", "op": "contains", "value": "你在路边醒来" },
    { "type": "assert", "query": "game.currentObjective", "op": "contains", "value": "寻找" },
    { "type": "screenshot", "out": "screenshots/localization-hud-zh", "ui": true },
    { "type": "cvar", "name": "nextdayz.debug.panel", "set": true },
    { "type": "cvar", "name": "nextdayz.debug.tab", "set": "survival" },
    { "type": "key", "code": "F9", "action": "press" },
    { "type": "assert", "query": "game.debugTab", "op": "eq", "value": "Survival" },
    { "type": "screenshot", "out": "screenshots/localization-debug-zh", "ui": true },
    { "type": "key", "code": "F12", "action": "press" },
    { "type": "assert", "query": "game.language", "op": "eq", "value": "en" },
    { "type": "assert", "query": "game.lastNotification", "op": "contains", "value": "You wake up by the road" },
    { "type": "assert", "query": "game.debugLastEvent", "op": "contains", "value": "You wake up by the road" },
    { "type": "assert", "query": "game.currentObjective", "op": "contains", "value": "Find" },
    { "type": "assert", "query": "game.debugTab", "op": "eq", "value": "Survival" },
    { "type": "screenshot", "out": "screenshots/localization-debug-en", "ui": true },
    { "type": "cvar", "name": "nextdayz.debug.tab", "set": "log" },
    { "type": "screenshot", "out": "screenshots/localization-log-en", "ui": true },
    { "type": "key", "code": "F12", "action": "press" },
    { "type": "assert", "query": "game.language", "op": "eq", "value": "zhCN" },
    { "type": "assert", "query": "game.lastNotification", "op": "contains", "value": "你在路边醒来" },
    { "type": "assert", "query": "game.debugLastEvent", "op": "contains", "value": "你在路边醒来" },
    { "type": "assert", "query": "game.debugTab", "op": "eq", "value": "Log" },
    { "type": "screenshot", "out": "screenshots/localization-log-zh", "ui": true },
    { "type": "key", "code": "F5", "action": "press" },
    { "type": "cvar", "name": "nextdayz.validation.addBackpack", "set": true },
    { "type": "cvar", "name": "nextdayz.validation.give", "set": "water_bottle:2" },
    { "type": "key", "code": "Tab", "action": "press" },
    { "type": "screenshot", "out": "screenshots/localization-inventory-zh", "ui": true },
    { "type": "key", "code": "Tab", "action": "press" },
    { "type": "key", "code": "Escape", "action": "press" },
    { "type": "screenshot", "out": "screenshots/localization-pause-zh", "ui": true },
    { "type": "key", "code": "Escape", "action": "press" },
    { "type": "cvar", "name": "nextdayz.validation.campaignPath", "set": "out/nextdayz-validation/localization.json" },
    { "type": "cvar", "name": "nextdayz.validation.campaignFresh", "set": true },
    { "type": "cvar", "name": "nextdayz.validation.campaign", "set": true },
    { "type": "assert", "query": "game.campaignInField", "op": "eq", "value": false },
    { "type": "screenshot", "out": "screenshots/localization-safehouse-zh", "ui": true },
    { "type": "key", "code": "F12", "action": "press" },
    { "type": "assert", "query": "game.language", "op": "eq", "value": "en" },
    { "type": "screenshot", "out": "screenshots/localization-safehouse-en", "ui": true },
    { "type": "quit" }
  ]
}

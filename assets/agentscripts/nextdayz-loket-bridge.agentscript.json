{
  "name": "nextdayz-loket-bridge",
  "target": "NextDayz",
  "scene": "assets/scad/proc/nextdayz/cz_loket_riverbend/scene.scad",
  "defaults": {
    "stepTimeoutMs": 180000
  },
  "steps": [
    {
      "type": "wait-until",
      "query": "game.sceneReady",
      "op": "eq",
      "value": true,
      "timeoutMs": 180000
    },
    {
      "type": "cvar",
      "name": "nextdayz.validation.invulnerable",
      "set": true
    },
    {
      "type": "cvar",
      "name": "nextdayz.validation.teleport",
      "set": "-92.4087,117.3504"
    },
    {
      "type": "cvar",
      "name": "nextdayz.validation.lookYaw",
      "set": 205.2999
    },
    {
      "type": "cvar",
      "name": "nextdayz.validation.lookPitch",
      "set": -5
    },
    {
      "type": "wait-frames",
      "n": 4
    },
    {
      "type": "key",
      "code": "W",
      "action": "down"
    },
    {
      "type": "wait-until",
      "query": "game.posZ",
      "op": "lt",
      "value": -262,
      "timeoutMs": 60000
    },
    {
      "type": "key",
      "code": "W",
      "action": "up"
    },
    {
      "type": "assert",
      "query": "game.posY",
      "op": "gt",
      "value": 10.1
    },
    {
      "type": "screenshot",
      "out": "screenshots/nextdayz-loket-bridge",
      "ui": true
    },
    {
      "type": "quit"
    }
  ]
}

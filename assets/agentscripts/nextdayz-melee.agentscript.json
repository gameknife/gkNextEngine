{
  "name": "nextdayz-melee",
  "target": "NextDayz",
  "scene": "assets/scad/tests/nextdayz_melee.scad",
  "defaults": {"waitFrames": 2, "stepTimeoutMs": 20000},
  "viewport": {"width": 1600, "height": 900},
  "steps": [
    {"type": "wait-until", "query": "game.sceneReady", "op": "eq", "value": true, "timeoutMs": 30000},
    {"type": "cvar", "name": "nextdayz.validation.teleport", "set": "0,0"},
    {"type": "cvar", "name": "nextdayz.validation.lookYaw", "set": 0},
    {"type": "cvar", "name": "nextdayz.validation.lookPitch", "set": 0},
    {"type": "cvar", "name": "nextdayz.validation.loadout", "set": true},
    {"type": "cvar", "name": "nextdayz.debug.freezeNeeds", "set": true},
    {"type": "cvar", "name": "nextdayz.debug.zombieTimeScale", "set": 0},
    {"type": "wait-ms", "ms": 600},
    {"type": "cvar", "name": "nextdayz.debug.freeze", "set": true},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "knife"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "knife"},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 20},
    {"type": "wait-frames", "n": 22},
    {"type": "assert", "query": "game.equippedWeapon", "op": "eq", "value": "knife"},
    {"type": "log", "message": "Knife guard keeps normal FOV; contact happens after wind-up, once per click"},
    {"type": "mouse-button", "button": "right", "action": "down"},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 20},
    {"type": "wait-frames", "n": 22},
    {"type": "assert", "query": "game.cameraFov", "op": "gt", "value": 74.9},
    {"type": "assert", "query": "game.isAiming", "op": "eq", "value": true},
    {"type": "screenshot", "out": "screenshots/nextdayz_melee_knife_guard_fps", "ui": true},
    {"type": "cvar", "name": "nextdayz.validation.zombieDistance", "set": 1.4},
    {"type": "cvar", "name": "nextdayz.validation.spawnZombie", "set": true},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 1},
    {"type": "wait-frames", "n": 3},
    {"type": "assert", "query": "game.zombieHealth", "op": "eq", "value": 90},
    {"type": "mouse-button", "button": "left", "action": "down"},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 1},
    {"type": "wait-frames", "n": 3},
    {"type": "assert", "query": "game.shotSequence", "op": "eq", "value": 1},
    {"type": "assert", "query": "game.isSwinging", "op": "eq", "value": true},
    {"type": "assert", "query": "game.meleeStrikeResolved", "op": "eq", "value": false},
    {"type": "assert", "query": "game.zombieHealth", "op": "eq", "value": 90},
    {"type": "assert", "query": "game.weaponActionClip", "op": "eq", "value": "melee_knife_attack"},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 4},
    {"type": "wait-frames", "n": 6},
    {"type": "assert", "query": "game.meleeStrikeResolved", "op": "eq", "value": false},
    {"type": "assert", "query": "game.zombieHealth", "op": "eq", "value": 90},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 7},
    {"type": "wait-frames", "n": 9},
    {"type": "assert", "query": "game.meleeStrikeResolved", "op": "eq", "value": true},
    {"type": "assert", "query": "game.zombieHealth", "op": "lt", "value": 90},
    {"type": "assert", "query": "game.recoilActive", "op": "eq", "value": false},
    {"type": "screenshot", "out": "screenshots/nextdayz_melee_knife_contact_fps", "ui": true},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 60},
    {"type": "wait-frames", "n": 62},
    {"type": "assert", "query": "game.shotSequence", "op": "eq", "value": 1},
    {"type": "assert", "query": "game.isSwinging", "op": "eq", "value": false},
    {"type": "assert", "query": "game.isAiming", "op": "eq", "value": true},
    {"type": "mouse-button", "button": "left", "action": "up"},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 1},
    {"type": "wait-frames", "n": 3},
    {"type": "log", "message": "Third-person crowbar uses a chest guard and a dedicated lateral sweep"},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "crowbar"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "crowbar"},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 20},
    {"type": "wait-frames", "n": 22},
    {"type": "assert", "query": "game.equippedWeapon", "op": "eq", "value": "crowbar"},
    {"type": "cvar", "name": "nextdayz.validation.thirdPerson", "set": true},
    {"type": "cvar", "name": "nextdayz.debug.orbit", "set": true},
    {"type": "cvar", "name": "nextdayz.debug.orbitYaw", "set": 125},
    {"type": "cvar", "name": "nextdayz.debug.orbitDistance", "set": 3},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 20},
    {"type": "wait-frames", "n": 22},
    {"type": "screenshot", "out": "screenshots/nextdayz_melee_crowbar_guard_tps", "ui": true},
    {"type": "mouse-button", "button": "left", "action": "down"},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 1},
    {"type": "wait-frames", "n": 3},
    {"type": "mouse-button", "button": "left", "action": "up"},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 19},
    {"type": "wait-frames", "n": 21},
    {"type": "assert", "query": "game.weaponActionClip", "op": "eq", "value": "melee_crowbar_attack"},
    {"type": "assert", "query": "game.meleeStrikeResolved", "op": "eq", "value": false},
    {"type": "screenshot", "out": "screenshots/nextdayz_melee_crowbar_windup_tps", "ui": true},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 2},
    {"type": "wait-frames", "n": 4},
    {"type": "assert", "query": "game.meleeStrikeResolved", "op": "eq", "value": true},
    {"type": "assert", "query": "game.gripError", "op": "lt", "value": 0.04},
    {"type": "screenshot", "out": "screenshots/nextdayz_melee_crowbar_contact_tps", "ui": true},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 40},
    {"type": "wait-frames", "n": 42},
    {"type": "log", "message": "Axe overhead chop buffers one late recovery click; holding does not auto-repeat"},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "axe"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "axe"},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 20},
    {"type": "wait-frames", "n": 22},
    {"type": "assert", "query": "game.equippedWeapon", "op": "eq", "value": "axe"},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 20},
    {"type": "wait-frames", "n": 22},
    {"type": "screenshot", "out": "screenshots/nextdayz_melee_axe_guard_tps", "ui": true},
    {"type": "mouse-button", "button": "left", "action": "down"},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 1},
    {"type": "wait-frames", "n": 3},
    {"type": "mouse-button", "button": "left", "action": "up"},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 17},
    {"type": "wait-frames", "n": 19},
    {"type": "assert", "query": "game.weaponActionClip", "op": "eq", "value": "melee_axe_attack"},
    {"type": "assert", "query": "game.meleeStrikeResolved", "op": "eq", "value": false},
    {"type": "screenshot", "out": "screenshots/nextdayz_melee_axe_windup_tps", "ui": true},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 11},
    {"type": "wait-frames", "n": 13},
    {"type": "assert", "query": "game.meleeStrikeResolved", "op": "eq", "value": true},
    {"type": "assert", "query": "game.gripError", "op": "lt", "value": 0.04},
    {"type": "screenshot", "out": "screenshots/nextdayz_melee_axe_contact_tps", "ui": true},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 26},
    {"type": "wait-frames", "n": 28},
    {"type": "mouse-button", "button": "left", "action": "down"},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 1},
    {"type": "wait-frames", "n": 3},
    {"type": "mouse-button", "button": "left", "action": "up"},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 9},
    {"type": "wait-frames", "n": 11},
    {"type": "assert", "query": "game.shotSequence", "op": "eq", "value": 4},
    {"type": "assert", "query": "game.isSwinging", "op": "eq", "value": true},
    {"type": "assert", "query": "game.meleeStrikeResolved", "op": "eq", "value": false},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 70},
    {"type": "wait-frames", "n": 72},
    {"type": "assert", "query": "game.shotSequence", "op": "eq", "value": 4},
    {"type": "assert", "query": "game.isSwinging", "op": "eq", "value": false},
    {"type": "log", "message": "Inventory cancels a pending strike and clears buffered input"},
    {"type": "mouse-button", "button": "left", "action": "down"},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 1},
    {"type": "wait-frames", "n": 3},
    {"type": "mouse-button", "button": "left", "action": "up"},
    {"type": "assert", "query": "game.meleeStrikeResolved", "op": "eq", "value": false},
    {"type": "key", "code": "I", "action": "press"},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 40},
    {"type": "wait-frames", "n": 42},
    {"type": "assert", "query": "game.isSwinging", "op": "eq", "value": false},
    {"type": "assert", "query": "game.meleeStrikeResolved", "op": "eq", "value": false},
    {"type": "assert", "query": "game.shotSequence", "op": "eq", "value": 5},
    {"type": "key", "code": "I", "action": "press"},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 70},
    {"type": "wait-frames", "n": 72},
    {"type": "assert", "query": "game.shotSequence", "op": "eq", "value": 5},
    {"type": "log", "message": "Firearm ADS and automatic fire still work after switching from melee"},
    {"type": "cvar", "name": "nextdayz.debug.orbit", "set": false},
    {"type": "cvar", "name": "nextdayz.validation.thirdPerson", "set": false},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "ak"},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 30},
    {"type": "wait-frames", "n": 32},
    {"type": "mouse-button", "button": "right", "action": "down"},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 30},
    {"type": "wait-frames", "n": 32},
    {"type": "assert", "query": "game.cameraFov", "op": "lt", "value": 66},
    {"type": "mouse-button", "button": "left", "action": "down"},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 20},
    {"type": "wait-frames", "n": 22},
    {"type": "mouse-button", "button": "left", "action": "up"},
    {"type": "assert", "query": "game.shotSequence", "op": "ge", "value": 8},
    {"type": "assert", "query": "game.recoilActive", "op": "eq", "value": true},
    {"type": "mouse-button", "button": "right", "action": "up"},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 90},
    {"type": "wait-frames", "n": 92},
    {"type": "assert", "query": "game.recoilActive", "op": "eq", "value": false},
    {"type": "log", "message": "A quick press and release during sprint survives the weapon-ready transition"},
    {"type": "cvar", "name": "nextdayz.validation.use", "set": "axe"},
    {"type": "cvar", "name": "nextdayz.validation.teleport", "set": "10,0"},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 30},
    {"type": "wait-frames", "n": 32},
    {"type": "key", "code": "W", "action": "down"},
    {"type": "key", "code": "LSHIFT", "action": "down"},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 60},
    {"type": "wait-frames", "n": 62},
    {"type": "assert", "query": "game.sprintAlpha", "op": "gt", "value": 0.9},
    {"type": "mouse-button", "button": "left", "action": "down"},
    {"type": "mouse-button", "button": "left", "action": "up"},
    {"type": "wait-frames", "n": 4},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 30},
    {"type": "wait-frames", "n": 32},
    {"type": "assert", "query": "game.isSwinging", "op": "eq", "value": true},
    {"type": "assert", "query": "game.weaponActionClip", "op": "eq", "value": "melee_axe_attack"},
    {"type": "assert", "query": "game.gait", "op": "ne", "value": "sprint"},
    {"type": "key", "code": "W", "action": "up"},
    {"type": "key", "code": "LSHIFT", "action": "up"},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 0},
    {"type": "cvar", "name": "nextdayz.debug.step", "set": 90},
    {"type": "wait-frames", "n": 92},
    {"type": "assert", "query": "game.isSwinging", "op": "eq", "value": false},
    {"type": "quit"}
  ]
}

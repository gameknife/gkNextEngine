      "n": 6
    },
    {
      "type": "key",
      "code": "W",
      "action": "down"
    },
    {
      "type": "wait-until",
      "query": "game.posX",
      "op": "gt",
      "value": -44.4003,
      "timeoutMs": 40000
    },
    {
      "type": "key",
      "code": "W",
      "action": "up"
    },

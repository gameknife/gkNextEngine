{
  "name": "nextdayz-otaru-rescue",
  "target": "NextDayz",
  "scene": "assets/scad/proc/nextdayz/jp_otaru_north_canal/published/v4/scene.scad",
  "defaults": { "stepTimeoutMs": 180000 },
  "steps": [
    { "type": "wait-until", "query": "game.sceneReady", "op": "eq", "value": true, "timeoutMs": 180000 },
    { "type": "cvar", "name": "nextdayz.validation.campaignPath", "set": "out/nextdayz-validation/otaru-rescue.json" },
    { "type": "cvar", "name": "nextdayz.validation.campaignFresh", "set": true },
    { "type": "cvar", "name": "nextdayz.validation.campaign", "set": true },
    { "type": "cvar", "name": "nextdayz.validation.deployMap", "set": "jp_otaru_north_canal" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "deploy" },
    { "type": "assert", "query": "game.campaignInField", "op": "eq", "value": true },
    { "type": "assert", "query": "game.currentMapSorties", "op": "eq", "value": 1 },
    { "type": "cvar", "name": "nextdayz.validation.give", "set": "signal_flare" },
    { "type": "assert", "query": "game.signalFlares", "op": "eq", "value": 1 },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "pad:1" },
    { "type": "cvar", "name": "nextdayz.validation.lookYaw", "set": 270 },
    { "type": "cvar", "name": "nextdayz.validation.lookPitch", "set": -6 },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "call" },
    { "type": "assert", "query": "game.flightPhase", "op": "eq", "value": "Inbound" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "flight:58" },
    { "type": "assert", "query": "game.flightPhase", "op": "eq", "value": "Waiting at helipad" },
    { "type": "wait-frames", "n": 4 },
    { "type": "screenshot", "out": "screenshots/nextdayz-otaru-clear-landing-zone", "ui": true },
    { "type": "key", "code": "E", "action": "press" },
    { "type": "assert", "query": "game.flightBoarded", "op": "eq", "value": true },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "flight:9" },
    { "type": "assert", "query": "game.campaignExtractions", "op": "eq", "value": 1 },
    { "type": "assert", "query": "game.campaignInField", "op": "eq", "value": false },
    { "type": "assert", "query": "game.campaignSaveBlocked", "op": "eq", "value": false },
    { "type": "wait-frames", "n": 3 },
    { "type": "screenshot", "out": "screenshots/nextdayz-otaru-safehouse-record", "ui": true },
    { "type": "quit" }
  ]
}

{
  "name": "nextdayz-published-dispatch",
  "target": "NextDayz",
  "scene": "assets/scad/proc/nextdayz/cz_loket_riverbend/published/v3/scene.scad",
  "defaults": {
    "stepTimeoutMs": 180000
  },
  "steps": [
    {
      "type": "wait-until",
      "query": "game.sceneReady",
      "op": "eq",
      "value": true,
      "timeoutMs": 180000
    },
    {
      "type": "cvar",
      "name": "nextdayz.validation.campaignPath",
      "set": "out/nextdayz-validation/published-dispatch.json"
    },
    {
      "type": "cvar",
      "name": "nextdayz.validation.campaignFresh",
      "set": true
    },
    {
      "type": "cvar",
      "name": "nextdayz.validation.campaign",
      "set": true
    },
    {
      "type": "cvar",
      "name": "nextdayz.validation.campaignCommand",
      "set": "new"
    },
    {
      "type": "assert",
      "query": "game.publishedMaps",
      "op": "eq",
      "value": 3
    },
    {
      "type": "wait-frames",
      "n": 4
    },
    {
      "type": "assert",
      "query": "game.atlasPolygons",
      "op": "ge",
      "value": 100
    },
    {
      "type": "screenshot",
      "out": "screenshots/nextdayz-safehouse-published-atlas",
      "ui": true
    },
    {
      "type": "cvar",
      "name": "nextdayz.validation.campaignCommand",
      "set": "deploy"
    },
    {
      "type": "wait-until",
      "query": "game.campaignInField",
      "op": "eq",
      "value": true,
      "timeoutMs": 180000
    },
    {
      "type": "assert",
      "query": "game.currentMapSorties",
      "op": "eq",
      "value": 1
    },
    {
      "type": "assert",
      "query": "game.campaignSorties",
      "op": "eq",
      "value": 1
    },
    {
      "type": "cvar",
      "name": "nextdayz.validation.give",
      "set": "signal_flare"
    },
    {
      "type": "cvar",
      "name": "nextdayz.validation.campaignCommand",
      "set": "pad:0"
    },
    {
      "type": "cvar",
      "name": "nextdayz.validation.campaignCommand",
      "set": "call"
    },
    {
      "type": "cvar",
      "name": "nextdayz.validation.campaignCommand",
      "set": "flight:58"
    },
    {
      "type": "cvar",
      "name": "nextdayz.validation.campaignCommand",
      "set": "board"
    },
    {
      "type": "cvar",
      "name": "nextdayz.validation.campaignCommand",
      "set": "flight:9"
    },
    {
      "type": "assert",
      "query": "game.campaignExtractions",
      "op": "eq",
      "value": 1
    },
    {
      "type": "assert",
      "query": "game.campaignInField",
      "op": "eq",
      "value": false
    },
    {
      "type": "assert",
      "query": "game.campaignSaveBlocked",
      "op": "eq",
      "value": false
    },
    {
      "type": "wait-frames",
      "n": 3
    },
    {
      "type": "screenshot",
      "out": "screenshots/nextdayz-safehouse-first-record",
      "ui": true
    },
    {
      "type": "quit"
    }
  ]
}

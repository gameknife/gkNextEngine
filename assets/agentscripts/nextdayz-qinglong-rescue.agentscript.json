{
  "name": "nextdayz-qinglong-rescue",
  "target": "NextDayz",
  "scene": "assets/scad/proc/nextdayz/cz_loket_riverbend/published/v3/scene.scad",
  "viewport": { "width": 1600, "height": 900 },
  "defaults": { "stepTimeoutMs": 180000 },
  "steps": [
    { "type": "wait-until", "query": "game.sceneReady", "op": "eq", "value": true, "timeoutMs": 180000 },
    { "type": "cvar", "name": "nextdayz.validation.campaignPath", "set": "out/nextdayz-validation/qinglong-rescue.json" },
    { "type": "cvar", "name": "nextdayz.validation.campaignFresh", "set": true },
    { "type": "cvar", "name": "nextdayz.validation.campaign", "set": true },
    { "type": "assert", "query": "game.publishedMaps", "op": "eq", "value": 3 },
    { "type": "assert", "query": "game.atlasPolygons", "op": "ge", "value": 100 },
    { "type": "cvar", "name": "nextdayz.debug.god", "set": true },
    { "type": "cvar", "name": "nextdayz.debug.freezeNeeds", "set": true },
    { "type": "cvar", "name": "nextdayz.validation.deployMap", "set": "cz_loket_riverbend" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "deploy" },
    { "type": "wait-until", "query": "game.campaignInField", "op": "eq", "value": true },
    { "type": "cvar", "name": "nextdayz.validation.addBackpack", "set": true },
    { "type": "cvar", "name": "nextdayz.validation.give", "set": "food_can:2" },
    { "type": "cvar", "name": "nextdayz.debug.expedition", "set": "return" },
    { "type": "assert", "query": "game.campaignInField", "op": "eq", "value": false },
    { "type": "assert", "query": "game.campaignStorage", "op": "ge", "value": 1 },
    { "type": "assert", "query": "game.campaignSorties", "op": "eq", "value": 1 },
    { "type": "assert", "query": "game.currentMapSorties", "op": "eq", "value": 1 },
    { "type": "cvar", "name": "nextdayz.validation.deployMap", "set": "cn_chengdu_qinglong_lake" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "deploy" },
    { "type": "wait-until", "query": "game.activeMapId", "op": "eq", "value": "cn_chengdu_qinglong_lake", "timeoutMs": 180000 },
    { "type": "wait-until", "query": "game.mapLoading", "op": "eq", "value": false, "timeoutMs": 180000 },
    { "type": "assert", "query": "game.campaignInField", "op": "eq", "value": true },
    { "type": "assert", "query": "game.currentMapSorties", "op": "eq", "value": 1 },
    { "type": "assert", "query": "game.campaignSorties", "op": "eq", "value": 2 },
    { "type": "assert", "query": "game.safeSpawns", "op": "eq", "value": 5 },
    { "type": "assert", "query": "game.extractionPoints", "op": "eq", "value": 2 },
    { "type": "assert", "query": "game.worldLootAnchors", "op": "ge", "value": 140 },
    { "type": "cvar", "name": "nextdayz.validation.give", "set": "signal_flare" },
    { "type": "assert", "query": "game.signalFlares", "op": "eq", "value": 1 },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "pad:1" },
    { "type": "cvar", "name": "nextdayz.validation.lookYaw", "set": 270 },
    { "type": "cvar", "name": "nextdayz.validation.lookPitch", "set": -6 },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "call" },
    { "type": "assert", "query": "game.flightPhase", "op": "eq", "value": "Inbound" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "flight:58" },
    { "type": "assert", "query": "game.flightPhase", "op": "eq", "value": "Waiting at helipad" },
    { "type": "wait-frames", "n": 4 },
    { "type": "screenshot", "out": "screenshots/nextdayz-qinglong-clear-landing-zone", "ui": true },
    { "type": "key", "code": "E", "action": "press" },
    { "type": "assert", "query": "game.flightBoarded", "op": "eq", "value": true },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "flight:9" },
    { "type": "assert", "query": "game.campaignExtractions", "op": "eq", "value": 1 },
    { "type": "assert", "query": "game.campaignInField", "op": "eq", "value": false },
    { "type": "assert", "query": "game.campaignSaveBlocked", "op": "eq", "value": false },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "reload" },
    { "type": "wait-until", "query": "game.mapLoading", "op": "eq", "value": false, "timeoutMs": 180000 },
    { "type": "assert", "query": "game.campaignSorties", "op": "eq", "value": 2 },
    { "type": "assert", "query": "game.currentMapSorties", "op": "eq", "value": 1 },
    { "type": "assert", "query": "game.campaignExtractions", "op": "eq", "value": 1 },
    { "type": "assert", "query": "game.campaignStorage", "op": "ge", "value": 1 },
    { "type": "assert", "query": "game.campaignSaveBlocked", "op": "eq", "value": false },
    { "type": "wait-frames", "n": 4 },
    { "type": "click", "at": { "px": [170, 505] }, "button": "left" },
    { "type": "wait-frames", "n": 3 },
    { "type": "assert", "query": "game.browsedMapId", "op": "eq", "value": "cn_chengdu_qinglong_lake" },
    { "type": "screenshot", "out": "screenshots/nextdayz-qinglong-safehouse-record", "ui": true },
    { "type": "quit" }
  ]
}

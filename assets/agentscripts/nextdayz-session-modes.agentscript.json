{
  "name": "nextdayz-session-modes",
  "target": "NextDayz",
  "viewport": {
    "width": 1600,
    "height": 900
  },
  "args": [
    "--cvar",
    "nextdayz.validation.campaign true",
    "--cvar",
    "nextdayz.validation.campaignFresh true",
    "--cvar",
    "nextdayz.validation.campaignPath out/nextdayz-validation/session-modes.json",
    "--cvar",
    "nextdayz.ui.sessionMenu true"
  ],
  "defaults": {
    "stepTimeoutMs": 180000
  },
  "description": "Requires an isolated Master at http://127.0.0.1:17880 (gnb master serve --listen 127.0.0.1:17880 --data out/nextdayz-validation/session-master --port-base 28100 --cheats). Exercises startup, isolated offline training, server favorites, UI login/deploy, and switching back without importing online gear.",
  "steps": [
    {"type": "wait-until", "query": "game.sceneReady", "op": "eq", "value": true, "timeoutMs": 180000, "fatal": true},
    {"type": "assert", "query": "game.sessionMode", "op": "eq", "value": "offline", "fatal": true},
    {"type": "assert", "query": "game.loggedIn", "op": "eq", "value": false, "fatal": true},
    {"type": "assert", "query": "game.sessionMenuOpen", "op": "eq", "value": true, "fatal": true},
    {"type": "screenshot", "out": "screenshots/session-offline-start", "ui": true},
    {"type": "click", "at": {"norm": [0.5, 0.34]}, "button": "left"},
    {"type": "wait-frames", "n": 4},
    {"type": "wait-until", "query": "game.sessionMode", "op": "eq", "value": "training", "timeoutMs": 180000, "fatal": true},
    {"type": "wait-until", "query": "game.activeMapId", "op": "eq", "value": "training_ground", "timeoutMs": 180000, "fatal": true},
    {"type": "wait-until", "query": "game.sceneReady", "op": "eq", "value": true, "timeoutMs": 180000, "fatal": true},
    {"type": "assert", "query": "game.cabinScene", "op": "eq", "value": false, "fatal": true},
    {"type": "assert", "query": "game.activeMapId", "op": "eq", "value": "training_ground", "fatal": true},
    {"type": "assert", "query": "game.loggedIn", "op": "eq", "value": false, "fatal": true},
    {"type": "cvar", "name": "nextdayz.validation.give", "set": "food_can:5"},
    {"type": "wait-frames", "n": 4},
    {"type": "assert", "query": "game.inventoryCount", "op": "ge", "value": 3, "fatal": true},
    {"type": "screenshot", "out": "screenshots/session-training", "ui": true},
    {"type": "key", "code": "Escape", "action": "press"},
    {"type": "wait-frames", "n": 4},
    {"type": "click", "at": {"norm": [0.625, 0.614444]}, "button": "left"},
    {"type": "wait-frames", "n": 4},
    {"type": "wait-until", "query": "game.sessionMode", "op": "eq", "value": "offline", "timeoutMs": 180000, "fatal": true},
    {"type": "wait-until", "query": "game.cabinScene", "op": "eq", "value": true, "timeoutMs": 180000, "fatal": true},
    {"type": "assert", "query": "game.inventoryCount", "op": "eq", "value": 0, "fatal": true},
    {"type": "assert", "query": "game.campaignGold", "op": "eq", "value": 0, "fatal": true},
    {"type": "assert", "query": "game.campaignSorties", "op": "eq", "value": 0, "fatal": true},
    {"type": "click", "at": {"norm": [0.775, 0.062222]}, "button": "left"},
    {"type": "wait-frames", "n": 4},
    {"type": "assert", "query": "game.sessionMenuOpen", "op": "eq", "value": true, "fatal": true},
    {"type": "click", "at": {"norm": [0.5, 0.264444]}, "button": "left"},
    {"type": "wait-frames", "n": 4},
    {"type": "assert", "query": "game.sessionMenuTab", "op": "eq", "value": 1, "fatal": true},
    {"type": "click", "at": {"norm": [0.5, 0.497778]}, "button": "left"},
    {"type": "wait-frames", "n": 4},
    {"type": "key", "code": "A", "action": "press", "mods": ["CTRL"]},
    {"type": "key", "code": "LCTRL", "action": "up"},
    {"type": "wait-frames", "n": 4},
    {"type": "text", "value": "http://127.0.0.1:17880"},
    {"type": "wait-frames", "n": 4},
    {"type": "click", "at": {"norm": [0.5, 0.562222]}, "button": "left"},
    {"type": "wait-frames", "n": 4},
    {"type": "key", "code": "A", "action": "press", "mods": ["CTRL"]},
    {"type": "key", "code": "LCTRL", "action": "up"},
    {"type": "wait-frames", "n": 4},
    {"type": "text", "value": "UI validation Master"},
    {"type": "wait-frames", "n": 4},
    {"type": "click", "at": {"norm": [0.675, 0.562222]}, "button": "left"},
    {"type": "wait-frames", "n": 4},
    {"type": "assert", "query": "game.masterServerCount", "op": "eq", "value": 2, "fatal": true},
    {"type": "click", "at": {"norm": [0.5, 0.627778]}, "button": "left"},
    {"type": "wait-frames", "n": 4},
    {"type": "key", "code": "A", "action": "press", "mods": ["CTRL"]},
    {"type": "key", "code": "LCTRL", "action": "up"},
    {"type": "wait-frames", "n": 4},
    {"type": "text", "value": "session-ui-check"},
    {"type": "wait-frames", "n": 4},
    {"type": "screenshot", "out": "screenshots/session-server-list", "ui": true},
    {"type": "click", "at": {"norm": [0.5, 0.673333]}, "button": "left"},
    {"type": "wait-frames", "n": 4},
    {"type": "wait-until", "query": "game.sessionMode", "op": "eq", "value": "master", "timeoutMs": 180000, "fatal": true},
    {"type": "wait-until", "query": "game.netLobby", "op": "eq", "value": "profile", "timeoutMs": 30000, "fatal": true},
    {"type": "assert", "query": "game.loggedIn", "op": "eq", "value": true, "fatal": true},
    {"type": "assert", "query": "game.accountName", "op": "eq", "value": "session-ui-check", "fatal": true},
    {"type": "assert", "query": "game.masterUrl", "op": "eq", "value": "http://127.0.0.1:17880", "fatal": true},
    {"type": "screenshot", "out": "screenshots/session-logged-in", "ui": true},
    {"type": "key", "code": "M", "action": "press"},
    {"type": "wait-frames", "n": 4},
    {"type": "assert", "query": "game.cabinPanel", "op": "eq", "value": 0, "fatal": true},
    {"type": "screenshot", "out": "screenshots/session-master-map-selection", "ui": true},
    {"type": "click", "at": {"norm": [0.1375, 0.26]}, "button": "left"},
    {"type": "wait-frames", "n": 4},
    {"type": "click", "at": {"norm": [0.146875, 0.324444]}, "button": "left"},
    {"type": "wait-frames", "n": 4},
    {"type": "wait-until", "query": "game.netLobby", "op": "eq", "value": "playing", "timeoutMs": 180000, "fatal": true},
    {"type": "assert", "query": "game.sessionMode", "op": "eq", "value": "master", "fatal": true},
    {"type": "assert", "query": "game.activeMapId", "op": "eq", "value": "training_ground", "fatal": true},
    {"type": "wait-until", "query": "game.netLootSynced", "op": "eq", "value": true, "timeoutMs": 30000, "fatal": true},
    {"type": "screenshot", "out": "screenshots/session-online-field-after-offline-training", "ui": true},
    {"type": "key", "code": "Escape", "action": "press"},
    {"type": "wait-frames", "n": 4},
    {"type": "click", "at": {"norm": [0.625, 0.614444]}, "button": "left"},
    {"type": "wait-frames", "n": 4},
    {"type": "wait-until", "query": "game.netLobby", "op": "eq", "value": "profile", "timeoutMs": 30000, "fatal": true},
    {"type": "wait-until", "query": "game.cabinScene", "op": "eq", "value": true, "timeoutMs": 180000, "fatal": true},
    {"type": "assert", "query": "game.loggedIn", "op": "eq", "value": true, "fatal": true},
    {"type": "screenshot", "out": "screenshots/session-online-return-to-lobby", "ui": true},
    {"type": "click", "at": {"norm": [0.775, 0.062222]}, "button": "left"},
    {"type": "wait-frames", "n": 4},
    {"type": "click", "at": {"norm": [0.35, 0.264444]}, "button": "left"},
    {"type": "wait-frames", "n": 4},
    {"type": "click", "at": {"norm": [0.5, 0.425556]}, "button": "left"},
    {"type": "wait-frames", "n": 4},
    {"type": "wait-until", "query": "game.sessionMode", "op": "eq", "value": "offline", "timeoutMs": 180000, "fatal": true},
    {"type": "wait-until", "query": "game.inventoryCount", "op": "eq", "value": 0, "timeoutMs": 30000, "fatal": true},
    {"type": "wait-until", "query": "game.cabinScene", "op": "eq", "value": true, "timeoutMs": 180000, "fatal": true},
    {"type": "assert", "query": "game.loggedIn", "op": "eq", "value": false, "fatal": true},
    {"type": "assert", "query": "game.campaignGold", "op": "eq", "value": 0, "fatal": true},
    {"type": "assert", "query": "game.campaignSorties", "op": "eq", "value": 0, "fatal": true},
    {"type": "wait-frames", "n": 90},
    {"type": "assert", "query": "game.sessionMode", "op": "eq", "value": "offline", "fatal": true},
    {"type": "screenshot", "out": "screenshots/session-offline-restored", "ui": true},
    {"type": "quit"}
  ]
}

{
  "name": "nextdayz-settings-in-game",
  "target": "NextDayz",
  "scene": "assets/agentscripts/fixtures/nextdayz-traversal.scad",
  "viewport": {
    "width": 1600,
    "height": 900
  },
  "defaults": {
    "stepTimeoutMs": 120000
  },
  "steps": [
    {"type": "wait-until", "query": "game.sceneReady", "op": "eq", "value": true, "timeoutMs": 120000},
    {"type": "cvar", "name": "nextdayz.settings.soundVolume", "set": 1},
    {"type": "cvar", "name": "nextdayz.settings.mouseSensitivity", "set": 1},
    {"type": "cvar", "name": "nextdayz.settings.invertMouseY", "set": false},
    {"type": "assert", "query": "game.runState", "op": "eq", "value": "playing", "fatal": true},
    {"type": "cvar", "name": "nextdayz.validation.lookYaw", "set": 0},
    {"type": "wait-frames", "n": 4},
    {"type": "cvar", "name": "nextdayz.validation.lookPitch", "set": 0},
    {"type": "wait-frames", "n": 4},
    {"type": "key", "code": "Escape", "action": "press"},
    {"type": "wait-frames", "n": 4},
    {"type": "assert", "query": "game.runState", "op": "eq", "value": "paused", "fatal": true},
    {"type": "click", "at": {"norm": [0.5, 0.5677777777777778]}, "button": "left"},
    {"type": "wait-frames", "n": 4},
    {"type": "assert", "query": "game.settingsOpen", "op": "eq", "value": true, "fatal": true},
    {"type": "assert", "query": "game.mouseCaptured", "op": "eq", "value": false, "fatal": true},
    {"type": "key", "code": "W", "action": "press"},
    {"type": "wait-frames", "n": 4},
    {"type": "key", "code": "Tab", "action": "press"},
    {"type": "wait-frames", "n": 4},
    {"type": "key", "code": "M", "action": "press"},
    {"type": "wait-frames", "n": 4},
    {"type": "key", "code": "V", "action": "press"},
    {"type": "wait-frames", "n": 4},
    {"type": "mouse-move", "relative": true, "to": [100, 50]},
    {"type": "wait-frames", "n": 4},
    {"type": "assert", "query": "game.playerYaw", "op": "eq", "value": 0, "fatal": true},
    {"type": "assert", "query": "game.playerPitch", "op": "eq", "value": 0, "fatal": true},
    {"type": "assert", "query": "game.runState", "op": "eq", "value": "paused", "fatal": true},
    {"type": "screenshot", "out": "screenshots/settings-in-game-zh", "ui": true},
    {"type": "key", "code": "F12", "action": "press"},
    {"type": "wait-frames", "n": 4},
    {"type": "assert", "query": "game.language", "op": "eq", "value": "en", "fatal": true},
    {"type": "assert", "query": "game.settingsOpen", "op": "eq", "value": true, "fatal": true},
    {"type": "key", "code": "Escape", "action": "press"},
    {"type": "wait-frames", "n": 4},
    {"type": "assert", "query": "game.settingsOpen", "op": "eq", "value": false, "fatal": true},
    {"type": "assert", "query": "game.runState", "op": "eq", "value": "paused", "fatal": true},
    {"type": "assert", "query": "game.mouseCaptured", "op": "eq", "value": false, "fatal": true},
    {"type": "screenshot", "out": "screenshots/settings-return-to-pause-en", "ui": true},
    {"type": "key", "code": "Escape", "action": "press"},
    {"type": "wait-frames", "n": 4},
    {"type": "assert", "query": "game.runState", "op": "eq", "value": "playing", "fatal": true},
    {"type": "assert", "query": "game.mouseCaptured", "op": "eq", "value": true, "fatal": true},
    {"type": "key", "code": "Escape", "action": "press"},
    {"type": "wait-frames", "n": 4},
    {"type": "assert", "query": "game.runState", "op": "eq", "value": "paused", "fatal": true},
    {"type": "click", "at": {"norm": [0.5, 0.5677777777777778]}, "button": "left"},
    {"type": "wait-frames", "n": 4},
    {"type": "assert", "query": "game.settingsOpen", "op": "eq", "value": true, "fatal": true},
    {"type": "click", "at": {"norm": [0.5, 0.7588888888888888]}, "button": "left"},
    {"type": "wait-frames", "n": 4},
    {"type": "assert", "query": "game.settingsOpen", "op": "eq", "value": false, "fatal": true},
    {"type": "assert", "query": "game.runState", "op": "eq", "value": "paused", "fatal": true},
    {"type": "click", "at": {"norm": [0.5, 0.52]}, "button": "left"},
    {"type": "wait-frames", "n": 4},
    {"type": "assert", "query": "game.runState", "op": "eq", "value": "playing", "fatal": true},
    {"type": "assert", "query": "game.mouseCaptured", "op": "eq", "value": true, "fatal": true},
    {"type": "cvar", "name": "nextdayz.settings.mouseSensitivity", "set": 2},
    {"type": "wait-frames", "n": 4},
    {"type": "cvar", "name": "nextdayz.settings.invertMouseY", "set": true},
    {"type": "wait-frames", "n": 4},
    {"type": "mouse-move", "to": {"norm": [0.8, 0.7]}},
    {"type": "wait-frames", "n": 4},
    {"type": "mouse-move", "relative": true, "to": [0, 0]},
    {"type": "wait-frames", "n": 4},
    {"type": "cvar", "name": "nextdayz.validation.lookYaw", "set": 0},
    {"type": "wait-frames", "n": 4},
    {"type": "cvar", "name": "nextdayz.validation.lookPitch", "set": 0},
    {"type": "wait-frames", "n": 4},
    {"type": "mouse-move", "relative": true, "to": [20, 10]},
    {"type": "wait-frames", "n": 4},
    {"type": "assert", "query": "game.playerYaw", "op": "gt", "value": -0.089, "fatal": true},
    {"type": "assert", "query": "game.playerYaw", "op": "lt", "value": -0.087, "fatal": true},
    {"type": "assert", "query": "game.playerPitch", "op": "gt", "value": -0.045, "fatal": true},
    {"type": "assert", "query": "game.playerPitch", "op": "lt", "value": -0.043, "fatal": true},
    {"type": "quit"}
  ]
}

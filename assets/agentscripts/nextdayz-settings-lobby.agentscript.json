{
  "name": "nextdayz-settings-lobby",
  "target": "NextDayz",
  "viewport": {
    "width": 1600,
    "height": 900
  },
  "args": [
    "--cvar",
    "nextdayz.validation.campaign true",
    "--cvar",
    "nextdayz.validation.campaignFresh true",
    "--cvar",
    "nextdayz.validation.campaignPath out/nextdayz-validation/settings-lobby.json",
    "--cvar",
    "r.rendererType 4",
    "--cvar",
    "r.upscaler.type 0",
    "--cvar",
    "r.upscaler.qualityMode 0"
  ],
  "defaults": {
    "stepTimeoutMs": 120000
  },
  "steps": [
    {"type": "wait-until", "query": "game.sceneReady", "op": "eq", "value": true, "timeoutMs": 120000},
    {"type": "cvar", "name": "nextdayz.settings.soundVolume", "set": 1},
    {"type": "cvar", "name": "nextdayz.settings.mouseSensitivity", "set": 1},
    {"type": "cvar", "name": "nextdayz.settings.invertMouseY", "set": false},
    {"type": "assert", "query": "game.cabinScene", "op": "eq", "value": true, "fatal": true},
    {"type": "screenshot", "out": "screenshots/settings-lobby-entry", "ui": true},
    {"type": "click", "at": {"norm": [0.915625, 0.06222222222222222]}, "button": "left"},
    {"type": "wait-frames", "n": 4},
    {"type": "assert", "query": "game.settingsOpen", "op": "eq", "value": true, "fatal": true},
    {"type": "assert", "query": "game.mouseCaptured", "op": "eq", "value": false, "fatal": true},
    {"type": "key", "code": "M", "action": "press"},
    {"type": "wait-frames", "n": 4},
    {"type": "key", "code": "Tab", "action": "press"},
    {"type": "wait-frames", "n": 4},
    {"type": "key", "code": "W", "action": "press"},
    {"type": "wait-frames", "n": 4},
    {"type": "assert", "query": "game.cabinPanel", "op": "eq", "value": -1, "fatal": true},
    {"type": "click", "at": {"norm": [0.5, 0.37222222222222223]}, "button": "left"},
    {"type": "wait-frames", "n": 4},
    {"type": "screenshot", "out": "screenshots/settings-renderer-options", "ui": true},
    {"type": "key", "code": "Escape", "action": "press"},
    {"type": "wait-frames", "n": 4},
    {"type": "assert", "query": "game.settingsOpen", "op": "eq", "value": true, "fatal": true},
    {"type": "click", "at": {"norm": [0.5, 0.29]}, "button": "left"},
    {"type": "wait-frames", "n": 4},
    {"type": "assert", "query": "game.settingsTab", "op": "eq", "value": 1, "fatal": true},
    {"type": "click", "at": {"norm": [0.4, 0.37222222222222223]}, "button": "left"},
    {"type": "wait-frames", "n": 4},
    {"type": "assert", "query": "cvar.nextdayz.settings.soundVolume", "op": "gt", "value": 0.1, "fatal": true},
    {"type": "assert", "query": "cvar.nextdayz.settings.soundVolume", "op": "lt", "value": 0.5, "fatal": true},
    {"type": "click", "at": {"norm": [0.5625, 0.4533333333333333]}, "button": "left"},
    {"type": "wait-frames", "n": 4},
    {"type": "assert", "query": "cvar.nextdayz.settings.mouseSensitivity", "op": "gt", "value": 1.5, "fatal": true},
    {"type": "click", "at": {"norm": [0.29875, 0.5022222222222222]}, "button": "left"},
    {"type": "wait-frames", "n": 4},
    {"type": "assert", "query": "cvar.nextdayz.settings.invertMouseY", "op": "eq", "value": true, "fatal": true},
    {"type": "screenshot", "out": "screenshots/settings-controls-zh", "ui": true},
    {"type": "click", "at": {"norm": [0.640625, 0.29]}, "button": "left"},
    {"type": "wait-frames", "n": 4},
    {"type": "assert", "query": "game.settingsTab", "op": "eq", "value": 2, "fatal": true},
    {"type": "click", "at": {"norm": [0.5, 0.37222222222222223]}, "button": "left"},
    {"type": "wait-frames", "n": 4},
    {"type": "click", "at": {"norm": [0.3875, 0.45444444444444443]}, "button": "left"},
    {"type": "wait-frames", "n": 4},
    {"type": "assert", "query": "game.language", "op": "eq", "value": "en", "fatal": true},
    {"type": "screenshot", "out": "screenshots/settings-language-en", "ui": true},
    {"type": "key", "code": "F12", "action": "press"},
    {"type": "wait-frames", "n": 4},
    {"type": "assert", "query": "game.language", "op": "eq", "value": "zhCN", "fatal": true},
    {"type": "assert", "query": "game.settingsTab", "op": "eq", "value": 2, "fatal": true},
    {"type": "click", "at": {"norm": [0.3575, 0.29]}, "button": "left"},
    {"type": "wait-frames", "n": 4},
    {"type": "assert", "query": "game.settingsTab", "op": "eq", "value": 0, "fatal": true},
    {"type": "click", "at": {"norm": [0.5, 0.37222222222222223]}, "button": "left"},
    {"type": "wait-frames", "n": 4},
    {"type": "click", "at": {"norm": [0.3875, 0.45444444444444443]}, "button": "left"},
    {"type": "wait-frames", "n": 4},
    {"type": "wait-until", "query": "cvar.r.rendererType", "op": "eq", "value": 2, "timeoutMs": 30000, "fatal": true},
    {"type": "click", "at": {"norm": [0.5, 0.4533333333333333]}, "button": "left"},
    {"type": "wait-frames", "n": 4},
    {"type": "click", "at": {"norm": [0.3875, 0.6266666666666667]}, "button": "left"},
    {"type": "wait-frames", "n": 4},
    {"type": "wait-until", "query": "cvar.r.upscaler.type", "op": "eq", "value": 4, "timeoutMs": 30000, "fatal": true},
    {"type": "click", "at": {"norm": [0.5, 0.5322222222222223]}, "button": "left"},
    {"type": "wait-frames", "n": 4},
    {"type": "click", "at": {"norm": [0.3875, 0.6144444444444445]}, "button": "left"},
    {"type": "wait-frames", "n": 4},
    {"type": "assert", "query": "cvar.r.upscaler.qualityMode", "op": "eq", "value": 1, "fatal": true},
    {"type": "screenshot", "out": "screenshots/settings-graphics-zh", "ui": true},
    {"type": "key", "code": "Escape", "action": "press"},
    {"type": "wait-frames", "n": 4},
    {"type": "assert", "query": "game.settingsOpen", "op": "eq", "value": false, "fatal": true},
    {"type": "assert", "query": "game.mouseCaptured", "op": "eq", "value": false, "fatal": true},
    {"type": "key", "code": "Escape", "action": "press"},
    {"type": "wait-frames", "n": 4},
    {"type": "assert", "query": "game.settingsOpen", "op": "eq", "value": true, "fatal": true},
    {"type": "key", "code": "Escape", "action": "press"},
    {"type": "wait-frames", "n": 4},
    {"type": "assert", "query": "game.settingsOpen", "op": "eq", "value": false, "fatal": true},
    {"type": "key", "code": "M", "action": "press"},
    {"type": "wait-frames", "n": 4},
    {"type": "assert", "query": "game.cabinPanel", "op": "eq", "value": 0, "fatal": true},
    {"type": "key", "code": "Escape", "action": "press"},
    {"type": "wait-frames", "n": 4},
    {"type": "assert", "query": "game.cabinPanel", "op": "eq", "value": -1, "fatal": true},
    {"type": "assert", "query": "game.settingsOpen", "op": "eq", "value": false, "fatal": true},
    {"type": "quit"}
  ]
}

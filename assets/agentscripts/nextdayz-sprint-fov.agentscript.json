{
  "name": "nextdayz-sprint-fov",
  "target": "NextDayz",
  "scene": "assets/agentscripts/fixtures/nextdayz-camera-arm.scad",
  "defaults": { "waitFrames": 2, "stepTimeoutMs": 20000 },
  "viewport": { "width": 1600, "height": 900 },
  "steps": [
    { "type": "wait-until", "query": "game.sceneReady", "op": "eq", "value": true, "timeoutMs": 30000 },
    { "type": "cvar", "name": "nextdayz.debug.freezeNeeds", "set": true },
    { "type": "cvar", "name": "nextdayz.debug.zombieTimeScale", "set": 0 },
    { "type": "cvar", "name": "nextdayz.debug.freeze", "set": true },
    { "type": "cvar", "name": "nextdayz.validation.teleport", "set": "0,0" },
    { "type": "cvar", "name": "nextdayz.validation.lookYaw", "set": 180 },
    { "type": "cvar", "name": "nextdayz.validation.lookPitch", "set": 0 },

    { "type": "log", "message": "Holding Shift while stationary keeps the base FOV" },
    { "type": "key", "code": "LSHIFT", "action": "down" },
    { "type": "cvar", "name": "nextdayz.debug.step", "set": 30 },
    { "type": "wait-frames", "n": 33 },
    { "type": "assert", "query": "game.horizontalSpeed", "op": "lt", "value": 0.1 },
    { "type": "assert", "query": "game.cameraFov", "op": "gt", "value": 74.9 },
    { "type": "assert", "query": "game.cameraFov", "op": "lt", "value": 75.1 },

    { "type": "log", "message": "Sprint input against a wall cannot widen the FOV" },
    { "type": "key", "code": "W", "action": "down" },
    { "type": "cvar", "name": "nextdayz.debug.step", "set": 60 },
    { "type": "wait-frames", "n": 63 },
    { "type": "assert", "query": "game.gait", "op": "eq", "value": "sprint" },
    { "type": "assert", "query": "game.sprintAlpha", "op": "gt", "value": 0.99 },
    { "type": "assert", "query": "game.horizontalSpeed", "op": "lt", "value": 0.1 },
    { "type": "assert", "query": "game.cameraFov", "op": "lt", "value": 75.1 },
    { "type": "key", "code": "W", "action": "up" },
    { "type": "key", "code": "LSHIFT", "action": "up" },

    { "type": "log", "message": "Normal running keeps the base FOV; actual sprint speed widens it" },
    { "type": "cvar", "name": "nextdayz.validation.teleport", "set": "0,-8" },
    { "type": "cvar", "name": "nextdayz.validation.lookYaw", "set": 180 },
    { "type": "cvar", "name": "nextdayz.debug.step", "set": 30 },
    { "type": "wait-frames", "n": 33 },
    { "type": "key", "code": "W", "action": "down" },
    { "type": "cvar", "name": "nextdayz.debug.step", "set": 0 },
    { "type": "cvar", "name": "nextdayz.debug.step", "set": 30 },
    { "type": "wait-frames", "n": 33 },
    { "type": "assert", "query": "game.horizontalSpeed", "op": "gt", "value": 4.1 },
    { "type": "assert", "query": "game.cameraFov", "op": "lt", "value": 75.1 },
    { "type": "key", "code": "LSHIFT", "action": "down" },
    { "type": "cvar", "name": "nextdayz.debug.step", "set": 45 },
    { "type": "wait-frames", "n": 48 },
    { "type": "assert", "query": "game.horizontalSpeed", "op": "gt", "value": 7.5 },
    { "type": "assert", "query": "game.cameraFov", "op": "gt", "value": 81.5 },
    { "type": "assert", "query": "game.cameraFov", "op": "lt", "value": 82.1 },
    { "type": "screenshot", "out": "screenshots/nextdayz_sprint_fov_moving" },

    { "type": "log", "message": "Colliding while sprint stays held restores the base FOV" },
    { "type": "cvar", "name": "nextdayz.debug.step", "set": 90 },
    { "type": "wait-frames", "n": 93 },
    { "type": "assert", "query": "game.gait", "op": "eq", "value": "sprint" },
    { "type": "assert", "query": "game.sprintAlpha", "op": "gt", "value": 0.99 },
    { "type": "assert", "query": "game.horizontalSpeed", "op": "lt", "value": 0.1 },
    { "type": "assert", "query": "game.cameraFov", "op": "gt", "value": 74.9 },
    { "type": "assert", "query": "game.cameraFov", "op": "lt", "value": 75.1 },
    { "type": "screenshot", "out": "screenshots/nextdayz_sprint_fov_blocked" },

    { "type": "log", "message": "Turning away restores sprint FOV; releasing movement recovers it" },
    { "type": "cvar", "name": "nextdayz.validation.lookYaw", "set": 0 },
    { "type": "cvar", "name": "nextdayz.debug.step", "set": 60 },
    { "type": "wait-frames", "n": 63 },
    { "type": "assert", "query": "game.horizontalSpeed", "op": "gt", "value": 7.5 },
    { "type": "assert", "query": "game.cameraFov", "op": "gt", "value": 81.5 },
    { "type": "key", "code": "W", "action": "up" },
    { "type": "key", "code": "LSHIFT", "action": "up" },
    { "type": "cvar", "name": "nextdayz.debug.step", "set": 0 },
    { "type": "cvar", "name": "nextdayz.debug.step", "set": 60 },
    { "type": "wait-frames", "n": 63 },
    { "type": "assert", "query": "game.horizontalSpeed", "op": "lt", "value": 0.1 },
    { "type": "assert", "query": "game.cameraFov", "op": "gt", "value": 74.9 },
    { "type": "assert", "query": "game.cameraFov", "op": "lt", "value": 75.1 },
    { "type": "quit" }
  ]
}

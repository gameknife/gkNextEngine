{
  "name": "nextdayz-survival-depth",
  "target": "NextDayz",
  "scene": "assets/scad/proc/coldwar/riverland_1km.scad",
  "defaults": { "waitFrames": 2, "stepTimeoutMs": 30000 },
  "viewport": { "width": 1600, "height": 900 },
  "steps": [
    { "type": "wait-until", "query": "engine.status", "op": "eq", "value": "Running", "timeoutMs": 30000 },
    { "type": "wait-until", "query": "game.sceneReady", "op": "eq", "value": true, "timeoutMs": 60000 },
    { "type": "cvar", "name": "nextdayz.validation.invulnerable", "set": true },
    { "type": "wait-frames", "n": 30 },

    { "type": "log", "message": "World: dense POIs, loot spots in every building, many infected anchors" },
    { "type": "assert", "query": "game.poiCount", "op": "ge", "value": 20 },
    { "type": "assert", "query": "game.lootSpots", "op": "ge", "value": 200 },
    { "type": "assert", "query": "game.lootZones", "op": "ge", "value": 18 },
    { "type": "assert", "query": "game.zombieSpawnPoints", "op": "ge", "value": 80 },
    { "type": "assert", "query": "game.zombieCap", "op": "ge", "value": 40 },

    { "type": "log", "message": "Bleeding: a wound drains health until it is dressed with H" },
    { "type": "cvar", "name": "nextdayz.validation.bleed", "set": 2 },
    { "type": "wait-frames", "n": 5 },
    { "type": "assert", "query": "game.bleeding", "op": "eq", "value": 2 },
    { "type": "key", "code": "H", "action": "press" },
    { "type": "wait-ms", "ms": 1700 },
    { "type": "assert", "query": "game.bleeding", "op": "eq", "value": 0 },

    { "type": "log", "message": "Tools: a map opens with M, a radio with a battery marks a supply cache" },
    { "type": "cvar", "name": "nextdayz.validation.give", "set": "map" },
    { "type": "cvar", "name": "nextdayz.validation.give", "set": "compass" },
    { "type": "cvar", "name": "nextdayz.validation.give", "set": "radio" },
    { "type": "cvar", "name": "nextdayz.validation.give", "set": "battery" },
    { "type": "cvar", "name": "nextdayz.validation.use", "set": "radio" },
    { "type": "wait-frames", "n": 5 },
    { "type": "assert", "query": "game.cacheMarked", "op": "eq", "value": true },
    { "type": "key", "code": "M", "action": "press" },
    { "type": "wait-frames", "n": 10 },
    { "type": "assert", "query": "game.showMap", "op": "eq", "value": true },
    { "type": "screenshot", "out": "screenshots/nextdayz_map", "ui": true },
    { "type": "key", "code": "M", "action": "press" },
    { "type": "wait-frames", "n": 5 },

    { "type": "log", "message": "Clothing: the military vest is worn armour" },
    { "type": "cvar", "name": "nextdayz.validation.addBackpack", "set": true },
    { "type": "cvar", "name": "nextdayz.validation.give", "set": "vest_military" },
    { "type": "cvar", "name": "nextdayz.validation.use", "set": "vest_military" },
    { "type": "wait-frames", "n": 3 },
    { "type": "assert", "query": "game.armor", "op": "ge", "value": 0.29 },

    { "type": "log", "message": "Melee: an axe swing kills an infected without a shot fired" },
    { "type": "cvar", "name": "nextdayz.validation.give", "set": "axe" },
    { "type": "cvar", "name": "nextdayz.validation.use", "set": "axe" },
    { "type": "wait-ms", "ms": 1200 },
    { "type": "assert", "query": "game.equippedWeapon", "op": "eq", "value": "axe" },
    { "type": "cvar", "name": "nextdayz.validation.zombieDistance", "set": 1.6 },
    { "type": "cvar", "name": "nextdayz.validation.spawnZombie", "set": true },
    { "type": "wait-frames", "n": 3 },
    { "type": "mouse-button", "button": "left", "action": "down" },
    { "type": "wait-ms", "ms": 2400 },
    { "type": "mouse-button", "button": "left", "action": "up" },
    { "type": "assert", "query": "game.zombieKills", "op": "ge", "value": 1 },
    { "type": "assert", "query": "game.shotSequence", "op": "ge", "value": 1 },

    { "type": "log", "message": "Dropping puts a pile on the ground that can be taken back" },
    { "type": "cvar", "name": "nextdayz.validation.drop", "set": "compass" },
    { "type": "wait-frames", "n": 3 },
    { "type": "assert", "query": "game.lootPiles", "op": "ge", "value": 1 },

    { "type": "log", "message": "Inventory screen: vicinity / equipment / cargo" },
    { "type": "key", "code": "TAB", "action": "press" },
    { "type": "wait-frames", "n": 10 },
    { "type": "screenshot", "out": "screenshots/nextdayz_inventory", "ui": true },
    { "type": "key", "code": "TAB", "action": "press" },
    { "type": "wait-frames", "n": 5 },

    { "type": "log", "message": "Night: a lit lantern burns fuel" },
    { "type": "cvar", "name": "nextdayz.validation.give", "set": "lantern" },
    { "type": "cvar", "name": "nextdayz.validation.give", "set": "fuel" },
    { "type": "key", "code": "L", "action": "press" },
    { "type": "wait-frames", "n": 3 },
    { "type": "assert", "query": "game.lanternLit", "op": "eq", "value": true },
    { "type": "cvar", "name": "nextdayz.validation.lookYaw", "set": -100 },
    { "type": "cvar", "name": "nextdayz.debug.hour", "set": 21.5 },
    { "type": "wait-frames", "n": 60 },
    { "type": "screenshot", "out": "screenshots/nextdayz_night", "ui": true },

    { "type": "log", "message": "Fog rolls in" },
    { "type": "cvar", "name": "nextdayz.debug.hour", "set": 10 },
    { "type": "cvar", "name": "nextdayz.debug.weather", "set": 2 },
    { "type": "wait-frames", "n": 60 },
    { "type": "assert", "query": "game.weather", "op": "eq", "value": "Fog" },
    { "type": "screenshot", "out": "screenshots/nextdayz_fog", "ui": true },
    { "type": "quit" }
  ]
}

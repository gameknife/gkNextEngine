{
  "name": "nextdayz-talek-bridge",
  "target": "NextDayz",
  "scene": "assets/scad/proc/nextdayz/ke_talek_mara/scene.scad",
  "defaults": {
    "stepTimeoutMs": 180000
  },
  "steps": [
    {
      "type": "wait-until",
      "query": "game.sceneReady",
      "op": "eq",
      "value": true,
      "timeoutMs": 180000
    },
    {
      "type": "cvar",
      "name": "nextdayz.validation.invulnerable",
      "set": true
    },
    {
      "type": "cvar",
      "name": "nextdayz.validation.teleport",
      "set": "-314,-24"
    },
    {
      "type": "cvar",
      "name": "nextdayz.validation.lookYaw",
      "set": 270
    },
    {
      "type": "cvar",
      "name": "nextdayz.validation.lookPitch",
      "set": -5
    },
    {
      "type": "wait-frames",
      "n": 4
    },
    {
      "type": "screenshot",
      "out": "screenshots/nextdayz-talek-bridge-east",
      "ui": true
    },
    {
      "type": "key",
      "code": "W",
      "action": "down"
    },
    {
      "type": "wait-until",
      "query": "game.posX",
      "op": "lt",
      "value": -372,
      "timeoutMs": 60000
    },
    {
      "type": "key",
      "code": "W",
      "action": "up"
    },
    {
      "type": "assert",
      "query": "game.posZ",
      "op": "gt",
      "value": 16
    },
    {
      "type": "assert",
      "query": "game.posZ",
      "op": "lt",
      "value": 32
    },
    {
      "type": "screenshot",
      "out": "screenshots/nextdayz-talek-gate",
      "ui": true
    },
    {
      "type": "cvar",
      "name": "nextdayz.validation.teleport",
      "set": "441,60"
    },
    {
      "type": "cvar",
      "name": "nextdayz.validation.lookYaw",
      "set": 180
    },
    {
      "type": "wait-frames",
      "n": 8
    },
    {
      "type": "screenshot",
      "out": "screenshots/nextdayz-talek-trading",
      "ui": true
    },
    {
      "type": "quit"
    }
  ]
}
{
  "name": "nextdayz-warehouse",
  "target": "NextDayz",
  "viewport": {
    "width": 1600,
    "height": 900
  },
  "args": [
    "--cvar",
    "nextdayz.validation.campaign true",
    "--cvar",
    "nextdayz.validation.campaignFresh true",
    "--cvar",
    "nextdayz.validation.campaignPath out/nextdayz-validation/warehouse.json"
  ],
  "defaults": {
    "waitFrames": 2,
    "stepTimeoutMs": 180000
  },
  "steps": [
    { "type": "wait-until", "query": "game.sceneReady", "op": "eq", "value": true, "timeoutMs": 60000 },
    { "type": "assert", "query": "game.cabinScene", "op": "eq", "value": true },
    { "type": "assert", "query": "game.campaignSaveBlocked", "op": "eq", "value": false },
    { "type": "assert", "query": "game.warehouseCapacity", "op": "eq", "value": 40 },
    { "type": "assert", "query": "game.traderStockFull", "op": "eq", "value": 47 },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "gold:5000" },

    { "type": "log", "message": "Over capacity: no buying, no deploying" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "fill-storage:42" },
    { "type": "assert", "query": "game.campaignStorage", "op": "eq", "value": 42 },
    { "type": "assert", "query": "game.warehouseOver", "op": "eq", "value": true },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "buy:bandage" },
    { "type": "assert", "query": "game.campaignGold", "op": "eq", "value": 5000 },
    { "type": "cvar", "name": "nextdayz.validation.deployMap", "set": "cz_loket_riverbend" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "deploy" },
    { "type": "wait-frames", "n": 20 },
    { "type": "assert", "query": "game.campaignInField", "op": "eq", "value": false },
    { "type": "assert", "query": "game.mapLoading", "op": "eq", "value": false },
    { "type": "key", "code": "Tab", "action": "press" },
    { "type": "wait-frames", "n": 30 },
    { "type": "assert", "query": "game.cabinPanel", "op": "eq", "value": 1 },
    { "type": "screenshot", "out": "screenshots/nextdayz-warehouse-over", "ui": true },
    { "type": "key", "code": "Escape", "action": "press" },

    { "type": "log", "message": "Sell two stacks, then the deployment goes" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "sell-first" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "sell-first" },
    { "type": "assert", "query": "game.campaignStorage", "op": "eq", "value": 40 },
    { "type": "assert", "query": "game.warehouseOver", "op": "eq", "value": false },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "deploy" },
    { "type": "wait-until", "query": "game.campaignInField", "op": "eq", "value": true, "timeoutMs": 180000 },

    { "type": "log", "message": "Coming home with more than fits: nothing is lost" },
    { "type": "cvar", "name": "nextdayz.validation.give", "set": "compass" },
    { "type": "cvar", "name": "nextdayz.validation.give", "set": "can_opener" },
    { "type": "cvar", "name": "nextdayz.validation.give", "set": "radio" },
    { "type": "cvar", "name": "nextdayz.debug.expedition", "set": "return" },
    { "type": "wait-until", "query": "game.cabinScene", "op": "eq", "value": true, "timeoutMs": 60000 },
    { "type": "assert", "query": "game.campaignInField", "op": "eq", "value": false },
    { "type": "assert", "query": "game.campaignStorage", "op": "ge", "value": 43 },
    { "type": "assert", "query": "game.warehouseOver", "op": "eq", "value": true },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "warehouse-upgrade" },
    { "type": "assert", "query": "game.warehouseLevel", "op": "eq", "value": 1 },
    { "type": "assert", "query": "game.warehouseCapacity", "op": "eq", "value": 60 },
    { "type": "assert", "query": "game.warehouseOver", "op": "eq", "value": false },

    { "type": "log", "message": "Reputation: a delivery lifts tier 0 to tier 1 and opens its shelves" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "reputation:2" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "contract-offer:med_dressings" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "contract-fill" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "contract-handin" },
    { "type": "assert", "query": "game.reputation", "op": "eq", "value": 3 },
    { "type": "assert", "query": "game.reputationTier", "op": "eq", "value": 1 },
    { "type": "assert", "query": "game.traderStock", "op": "eq", "value": 47 },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "buy:ammo_545" },
    { "type": "assert", "query": "game.traderStock", "op": "eq", "value": 46 },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "buy:signal_flare" },
    { "type": "assert", "query": "game.traderStock", "op": "eq", "value": 46 },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "reputation:8" },
    { "type": "assert", "query": "game.reputationTier", "op": "eq", "value": 2 },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "buy:signal_flare" },
    { "type": "assert", "query": "game.traderStock", "op": "eq", "value": 45 },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "buy:signal_flare" },
    { "type": "assert", "query": "game.traderStock", "op": "eq", "value": 45 },
    { "type": "key", "code": "T", "action": "press" },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "page:1" },
    { "type": "wait-frames", "n": 30 },
    { "type": "screenshot", "out": "screenshots/nextdayz-warehouse-trader", "ui": true },
    { "type": "cvar", "name": "nextdayz.validation.campaignCommand", "set": "save" },
    { "type": "quit" }
  ]
}

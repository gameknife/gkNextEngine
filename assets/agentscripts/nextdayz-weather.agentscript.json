{
  "name": "nextdayz-weather",
  "target": "NextDayz",
  "scene": "assets/scad/proc/coldwar/riverland_1km.scad",
  "viewport": { "width": 1280, "height": 720 },
  "defaults": { "waitFrames": 2, "stepTimeoutMs": 30000 },
  "steps": [
    { "type": "wait-until", "query": "game.sceneReady", "op": "eq", "value": true, "timeoutMs": 60000 },
    { "type": "cvar", "name": "nextdayz.validation.invulnerable", "set": true },
    { "type": "cvar", "name": "nextdayz.debug.hour", "set": 12 },
    { "type": "cvar", "name": "nextdayz.debug.weather", "set": 0 },
    { "type": "cvar", "name": "nextdayz.debug.fogDensityScale", "set": 1 },
    { "type": "cvar", "name": "nextdayz.validation.teleport", "set": "-180,-285" },
    { "type": "cvar", "name": "nextdayz.validation.lookYaw", "set": 85 },
    { "type": "cvar", "name": "nextdayz.validation.lookPitch", "set": 5 },
    { "type": "wait-until", "query": "game.weatherBlend", "op": "le", "value": 0 },
    { "type": "assert", "query": "game.sunIntensity", "op": "gt", "value": 470 },
    { "type": "screenshot", "out": "screenshots/weather_clear" },

    { "type": "log", "message": "Clear to overcast: light and haze change gradually" },
    { "type": "cvar", "name": "nextdayz.debug.weather", "set": 1 },
    { "type": "assert", "query": "game.weatherBlend", "op": "lt", "value": 0.15 },
    { "type": "assert", "query": "game.sunIntensity", "op": "gt", "value": 400 },
    { "type": "wait-until", "query": "game.weatherBlend", "op": "gt", "value": 0.3 },
    { "type": "assert", "query": "game.sunIntensity", "op": "gt", "value": 20 },
    { "type": "assert", "query": "game.sunIntensity", "op": "lt", "value": 300 },
    { "type": "cvar", "name": "nextdayz.debug.timeScale", "set": 0 },
    { "type": "screenshot", "out": "screenshots/weather_overcast_arriving" },
    { "type": "cvar", "name": "nextdayz.debug.timeScale", "set": 8 },
    { "type": "wait-until", "query": "game.weatherBlend", "op": "ge", "value": 0.6 },
    { "type": "assert", "query": "game.sunIntensity", "op": "lt", "value": 1 },
    { "type": "assert", "query": "game.fogDensity", "op": "lt", "value": 0.008 },
    { "type": "cvar", "name": "nextdayz.debug.timeScale", "set": 0 },
    { "type": "screenshot", "out": "screenshots/weather_overcast" },

    { "type": "log", "message": "Overcast to fog: dense fog rolls in, instead of snapping on" },
    { "type": "cvar", "name": "nextdayz.debug.timeScale", "set": 1 },
    { "type": "cvar", "name": "nextdayz.debug.weather", "set": 2 },
    { "type": "assert", "query": "game.fogDensity", "op": "lt", "value": 0.012 },
    { "type": "wait-until", "query": "game.fogDensity", "op": "gt", "value": 0.03 },
    { "type": "assert", "query": "game.fogDensity", "op": "lt", "value": 0.06 },
    { "type": "cvar", "name": "nextdayz.debug.timeScale", "set": 0 },
    { "type": "screenshot", "out": "screenshots/weather_fog_arriving" },
    { "type": "cvar", "name": "nextdayz.debug.timeScale", "set": 8 },
    { "type": "wait-until", "query": "game.weatherBlend", "op": "ge", "value": 0.8 },
    { "type": "assert", "query": "game.fogDensity", "op": "ge", "value": 0.0649 },
    { "type": "assert", "query": "game.ambienceWind", "op": "lt", "value": 0.019 },
    { "type": "cvar", "name": "nextdayz.debug.timeScale", "set": 0 },
    { "type": "screenshot", "out": "screenshots/weather_fog_dense" },

    { "type": "log", "message": "Fog to overcast: fog lingers and gradually disperses" },
    { "type": "cvar", "name": "nextdayz.debug.timeScale", "set": 1 },
    { "type": "cvar", "name": "nextdayz.debug.weather", "set": 1 },
    { "type": "assert", "query": "game.fogDensity", "op": "gt", "value": 0.055 },
    { "type": "wait-until", "query": "game.fogDensity", "op": "lt", "value": 0.04 },
    { "type": "assert", "query": "game.fogDensity", "op": "gt", "value": 0.012 },
    { "type": "cvar", "name": "nextdayz.debug.timeScale", "set": 8 },
    { "type": "wait-until", "query": "game.weatherBlend", "op": "le", "value": 0.600001 },
    { "type": "assert", "query": "game.fogDensity", "op": "lt", "value": 0.008 },

    { "type": "log", "message": "Overcast to clear: sunlight returns gradually" },
    { "type": "cvar", "name": "nextdayz.debug.timeScale", "set": 1 },
    { "type": "cvar", "name": "nextdayz.debug.weather", "set": 0 },
    { "type": "assert", "query": "game.sunIntensity", "op": "lt", "value": 50 },
    { "type": "cvar", "name": "nextdayz.debug.timeScale", "set": 8 },
    { "type": "wait-until", "query": "game.weatherBlend", "op": "le", "value": 0 },
    { "type": "assert", "query": "game.sunIntensity", "op": "gt", "value": 470 },

    { "type": "log", "message": "Direct clear to fog and fog to clear also preserve the current atmosphere" },
    { "type": "cvar", "name": "nextdayz.debug.timeScale", "set": 1 },
    { "type": "cvar", "name": "nextdayz.debug.weather", "set": 2 },
    { "type": "assert", "query": "game.weatherBlend", "op": "lt", "value": 0.15 },
    { "type": "cvar", "name": "nextdayz.debug.timeScale", "set": 8 },
    { "type": "wait-until", "query": "game.weatherBlend", "op": "ge", "value": 0.8 },
    { "type": "cvar", "name": "nextdayz.debug.timeScale", "set": 1 },
    { "type": "cvar", "name": "nextdayz.debug.weather", "set": 0 },
    { "type": "assert", "query": "game.fogDensity", "op": "gt", "value": 0.055 },
    { "type": "cvar", "name": "nextdayz.debug.timeScale", "set": 8 },
    { "type": "wait-until", "query": "game.weatherBlend", "op": "le", "value": 0 },

    { "type": "log", "message": "Reverse a partial transition without jumping to either endpoint" },
    { "type": "cvar", "name": "nextdayz.debug.timeScale", "set": 1 },
    { "type": "cvar", "name": "nextdayz.debug.weather", "set": 2 },
    { "type": "wait-until", "query": "game.weatherBlend", "op": "gt", "value": 0.15 },
    { "type": "cvar", "name": "nextdayz.debug.weather", "set": 0 },
    { "type": "assert", "query": "game.weatherBlend", "op": "gt", "value": 0.1 },
    { "type": "assert", "query": "game.weatherBlend", "op": "lt", "value": 0.3 },
    { "type": "wait-until", "query": "game.weatherBlend", "op": "le", "value": 0 },
    { "type": "assert", "query": "game.sunIntensity", "op": "gt", "value": 470 },
    { "type": "assert", "query": "game.fogDensity", "op": "lt", "value": 0.004 },
    { "type": "screenshot", "out": "screenshots/weather_clear_restored" },
    { "type": "quit" }
  ]
}

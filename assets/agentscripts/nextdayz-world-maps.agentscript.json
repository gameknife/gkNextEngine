{
  "name": "nextdayz-world-maps",
  "target": "NextDayz",
  "scene": "assets/scad/proc/nextdayz/cz_loket_riverbend/scene.scad",
  "viewport": {
    "width": 1600,
    "height": 900
  },
  "defaults": {
    "stepTimeoutMs": 180000,
    "waitFrames": 2
  },
  "steps": [
    {
      "type": "wait-until",
      "query": "game.sceneReady",
      "op": "eq",
      "value": true,
      "timeoutMs": 180000
    },
    {
      "type": "cvar",
      "name": "nextdayz.validation.campaignPath",
      "set": "out/nextdayz-validation/world-maps.json"
    },
    {
      "type": "cvar",
      "name": "nextdayz.authoring",
      "set": true
    },
    {
      "type": "cvar",
      "name": "nextdayz.validation.campaignFresh",
      "set": true
    },
    {
      "type": "cvar",
      "name": "nextdayz.validation.campaign",
      "set": true
    },
    {
      "type": "cvar",
      "name": "nextdayz.validation.campaignCommand",
      "set": "new"
    },
    {
      "type": "wait-frames",
      "n": 3
    },
    {
      "type": "assert",
      "query": "game.campaignSaveBlocked",
      "op": "eq",
      "value": false
    },
    {
      "type": "assert",
      "query": "game.activeMapId",
      "op": "eq",
      "value": "cz_loket_riverbend"
    },
    {
      "type": "assert",
      "query": "game.atlasPolygons",
      "op": "ge",
      "value": 100
    },
    {
      "type": "assert",
      "query": "game.extractionPoints",
      "op": "eq",
      "value": 2
    },
    {
      "type": "assert",
      "query": "game.safeSpawns",
      "op": "ge",
      "value": 3
    },
    {
      "type": "wait-frames",
      "n": 3
    },
    {
      "type": "click",
      "at": {
        "px": [
          110,
          462
        ]
      },
      "comment": "Second field record (training ground); window pixels at 125% UI scale (1600x900 viewport)."
    },
    {
      "type": "wait-frames",
      "n": 3
    },
    {
      "type": "assert",
      "query": "game.browsedMapId",
      "op": "eq",
      "value": "training_ground"
    },
    {
      "type": "assert",
      "query": "game.campaignSorties",
      "op": "eq",
      "value": 0
    },
    {
      "type": "screenshot",
      "out": "screenshots/nextdayz-world-atlas",
      "ui": true
    },
    {
      "type": "cvar",
      "name": "nextdayz.validation.deployMap",
      "set": "cz_loket_riverbend"
    },
    {
      "type": "cvar",
      "name": "nextdayz.validation.campaignCommand",
      "set": "deploy"
    },
    {
      "type": "assert",
      "query": "game.campaignInField",
      "op": "eq",
      "value": true
    },
    {
      "type": "assert",
      "query": "game.currentMapSorties",
      "op": "eq",
      "value": 1
    },
    {
      "type": "cvar",
      "name": "nextdayz.validation.invulnerable",
      "set": true
    },
    {
      "type": "cvar",
      "name": "nextdayz.validation.lookPitch",
      "set": -7
    },
    {
      "type": "key",
      "code": "W",
      "action": "down"
    },
    {
      "type": "wait-frames",
      "n": 60
    },
    {
      "type": "key",
      "code": "W",
      "action": "up"
    },
    {
      "type": "screenshot",
      "out": "screenshots/nextdayz-loket-street",
      "ui": true,
      "accumulateFrames": 64
    },
    {
      "type": "cvar",
      "name": "nextdayz.validation.give",
      "set": "food_can:2"
    },
    {
      "type": "cvar",
      "name": "nextdayz.validation.campaignCommand",
      "set": "rebuild"
    },
    {
      "type": "wait-until",
      "query": "game.sceneGeneration",
      "op": "ge",
      "value": 2,
      "timeoutMs": 180000
    },
    {
      "type": "assert",
      "query": "game.campaignInField",
      "op": "eq",
      "value": true
    },
    {
      "type": "assert",
      "query": "game.campaignSorties",
      "op": "eq",
      "value": 1
    },
    {
      "type": "assert",
      "query": "game.currentMapSorties",
      "op": "eq",
      "value": 1
    },
    {
      "type": "assert",
      "query": "game.campaignSaveBlocked",
      "op": "eq",
      "value": false
    },
    {
      "type": "cvar",
      "name": "nextdayz.validation.give",
      "set": "signal_flare"
    },
    {
      "type": "cvar",
      "name": "nextdayz.validation.campaignCommand",
      "set": "pad:0"
    },
    {
      "type": "cvar",
      "name": "nextdayz.validation.campaignCommand",
      "set": "call"
    },
    {
      "type": "cvar",
      "name": "nextdayz.validation.campaignCommand",
      "set": "flight:58"
    },
    {
      "type": "cvar",
      "name": "nextdayz.validation.campaignCommand",
      "set": "board"
    },
    {
      "type": "assert",
      "query": "game.flightBoarded",
      "op": "eq",
      "value": true
    },
    {
      "type": "cvar",
      "name": "nextdayz.validation.campaignCommand",
      "set": "flight:9"
    },
    {
      "type": "assert",
      "query": "game.campaignInField",
      "op": "eq",
      "value": false
    },
    {
      "type": "assert",
      "query": "game.campaignExtractions",
      "op": "eq",
      "value": 1
    },
    {
      "type": "cvar",
      "name": "nextdayz.validation.deployMap",
      "set": "training_ground"
    },
    {
      "type": "cvar",
      "name": "nextdayz.validation.campaignCommand",
      "set": "deploy"
    },
    {
      "type": "wait-until",
      "query": "game.activeMapId",
      "op": "eq",
      "value": "training_ground",
      "timeoutMs": 180000
    },
    {
      "type": "wait-until",
      "query": "game.mapLoading",
      "op": "eq",
      "value": false,
      "timeoutMs": 180000
    },
    {
      "type": "assert",
      "query": "game.campaignSaveBlocked",
      "op": "eq",
      "value": false
    },
    {
      "type": "assert",
      "query": "game.campaignInField",
      "op": "eq",
      "value": true
    },
    {
      "type": "assert",
      "query": "game.currentMapSorties",
      "op": "eq",
      "value": 1
    },
    {
      "type": "assert",
      "query": "game.campaignSorties",
      "op": "eq",
      "value": 2
    },
    {
      "type": "assert",
      "query": "game.extractionPoints",
      "op": "eq",
      "value": 2
    },
    {
      "type": "wait-frames",
      "n": 25
    },
    {
      "type": "screenshot",
      "out": "screenshots/nextdayz-training-street",
      "ui": true,
      "accumulateFrames": 64
    },
    {
      "type": "cvar",
      "name": "nextdayz.validation.give",
      "set": "bandage"
    },
    {
      "type": "cvar",
      "name": "nextdayz.validation.damagePlayer",
      "set": 200
    },
    {
      "type": "wait-frames",
      "n": 5
    },
    {
      "type": "assert",
      "query": "game.campaignInField",
      "op": "eq",
      "value": false
    },
    {
      "type": "assert",
      "query": "game.lootPiles",
      "op": "ge",
      "value": 1
    },
    {
      "type": "cvar",
      "name": "nextdayz.validation.deployMap",
      "set": "cz_loket_riverbend"
    },
    {
      "type": "cvar",
      "name": "nextdayz.validation.campaignCommand",
      "set": "deploy"
    },
    {
      "type": "wait-until",
      "query": "game.activeMapId",
      "op": "eq",
      "value": "cz_loket_riverbend",
      "timeoutMs": 180000
    },
    {
      "type": "wait-until",
      "query": "game.mapLoading",
      "op": "eq",
      "value": false,
      "timeoutMs": 180000
    },
    {
      "type": "assert",
      "query": "game.currentMapSorties",
      "op": "eq",
      "value": 2
    },
    {
      "type": "assert",
      "query": "game.campaignSorties",
      "op": "eq",
      "value": 3
    },
    {
      "type": "assert",
      "query": "game.campaignSaveBlocked",
      "op": "eq",
      "value": false
    },
    {
      "type": "assert",
      "query": "game.lootPiles",
      "op": "eq",
      "value": 0
    },
    {
      "type": "cvar",
      "name": "nextdayz.validation.campaignCommand",
      "set": "save"
    },
    {
      "type": "quit"
    }
  ]
}

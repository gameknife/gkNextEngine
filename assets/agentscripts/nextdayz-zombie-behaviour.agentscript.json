{
  "name": "nextdayz-zombie-behaviour",
  "target": "NextDayz",
  "scene": "assets/scad/proc/coldwar/riverland_1km.scad",
  "defaults": { "waitFrames": 2, "stepTimeoutMs": 20000 },
  "viewport": { "width": 1280, "height": 720 },
  "steps": [
    { "type": "wait-until", "query": "engine.status", "op": "eq", "value": "Running", "timeoutMs": 20000 },
    { "type": "wait-until", "query": "game.sceneReady", "op": "eq", "value": true, "timeoutMs": 30000 },
    { "type": "cvar", "name": "nextdayz.validation.loadout", "set": true },
    { "type": "cvar", "name": "nextdayz.validation.invulnerable", "set": true },
    { "type": "cvar", "name": "nextdayz.validation.lookYaw", "set": 180 },
    { "type": "key", "code": "W", "action": "down" },
    { "type": "wait-ms", "ms": 1200 },
    { "type": "key", "code": "W", "action": "up" },
    { "type": "wait-ms", "ms": 500 },
    { "type": "cvar", "name": "nextdayz.validation.thirdPerson", "set": true },
    { "type": "cvar", "name": "nextdayz.debug.orbit", "set": true },
    { "type": "cvar", "name": "nextdayz.debug.orbitZombie", "set": true },
    { "type": "cvar", "name": "nextdayz.debug.orbitDistance", "set": 3.0 },
    { "type": "cvar", "name": "nextdayz.debug.orbitHeight", "set": 1.0 },
    { "type": "cvar", "name": "nextdayz.debug.orbitYaw", "set": 120 },
    { "type": "cvar", "name": "nextdayz.validation.zombieDistance", "set": 8.0 },
    { "type": "cvar", "name": "nextdayz.validation.spawnZombie", "set": true },
    { "type": "wait-frames", "n": 3 },
    { "type": "assert", "query": "game.zombieState", "op": "eq", "value": "Alert" },
    { "type": "assert", "query": "game.zombieActionClip", "op": "eq", "value": "alert" },
    { "type": "assert", "query": "game.hitProxyCpuEligible", "op": "ge", "value": 11 },
    { "type": "wait-until", "query": "game.zombieState", "op": "eq", "value": "Chase", "timeoutMs": 5000 },
    { "type": "wait-until", "query": "game.zombieSpeed", "op": "gt", "value": 4.2, "timeoutMs": 3000 },
    { "type": "wait-until", "query": "game.zombieBaseClip", "op": "eq", "value": "run", "timeoutMs": 3000 },
    { "type": "screenshot", "out": "screenshots/nextdayz_zombie_chase" },
    { "type": "wait-until", "query": "game.zombieState", "op": "eq", "value": "Attack", "timeoutMs": 8000 },
    { "type": "wait-until", "query": "game.hurt", "op": "eq", "value": true, "timeoutMs": 3000 },
    { "type": "screenshot", "out": "screenshots/nextdayz_zombie_attack", "ui": true },
    { "type": "wait-until", "query": "game.zombieState", "op": "ne", "value": "Attack", "timeoutMs": 3000 },
    { "type": "cvar", "name": "nextdayz.validation.hitZombieZone", "set": 2 },
    { "type": "wait-frames", "n": 2 },
    { "type": "assert", "query": "game.lastHitZone", "op": "eq", "value": "torso" },
    { "type": "assert", "query": "game.zombieFlinch", "op": "gt", "value": 1.0 },
    { "type": "assert", "query": "game.fxParticles", "op": "ge", "value": 1 },
    { "type": "cvar", "name": "nextdayz.validation.hitZombieZone", "set": 0 },
    { "type": "wait-ms", "ms": 300 },
    { "type": "cvar", "name": "nextdayz.validation.hitZombieZone", "set": 4 },
    { "type": "cvar", "name": "nextdayz.validation.hitZombieZone", "set": 0 },
    { "type": "cvar", "name": "nextdayz.validation.hitZombieZone", "set": 4 },
    { "type": "assert", "query": "game.lastHitZone", "op": "eq", "value": "leg" },
    { "type": "assert", "query": "game.zombieCrippled", "op": "eq", "value": true },
    { "type": "assert", "query": "game.zombieState", "op": "eq", "value": "Stagger" },
    { "type": "assert", "query": "game.zombieStaggers", "op": "ge", "value": 1 },
    { "type": "wait-ms", "ms": 250 },
    { "type": "screenshot", "out": "screenshots/nextdayz_zombie_stagger" },
    { "type": "wait-until", "query": "game.zombieState", "op": "ne", "value": "Stagger", "timeoutMs": 3000 },
    { "type": "cvar", "name": "nextdayz.validation.hitZombieZone", "set": 0 },
    { "type": "cvar", "name": "nextdayz.validation.hitZombieZone", "set": 1 },
    { "type": "assert", "query": "game.zombieState", "op": "eq", "value": "Dead" },
    { "type": "assert", "query": "game.zombieDeath", "op": "ne", "value": "none" },
    { "type": "assert", "query": "game.headshots", "op": "ge", "value": 1 },
    { "type": "assert", "query": "game.hitMarkerKill", "op": "eq", "value": true },
    { "type": "assert", "query": "game.audioPlayed", "op": "ge", "value": 5 },
    { "type": "wait-ms", "ms": 2500 },
    { "type": "cvar", "name": "nextdayz.debug.orbitHeight", "set": 2.0 },
    { "type": "wait-frames", "n": 3 },
    { "type": "screenshot", "out": "screenshots/nextdayz_zombie_dead" },
    { "type": "quit" }
  ]
}

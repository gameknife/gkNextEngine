{
  "name": "renderer-shoot",
  "target": "gkNextRenderer",
  "scene": "assets/models/playground.glb",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "defaults": {
    "waitFrames": 2,
    "stepTimeoutMs": 20000
  },
  "steps": [
    {
      "type": "wait-until",
      "query": "engine.status",
      "op": "eq",
      "value": "Running"
    },
    {
      "type": "wait-until",
      "query": "scene.nodeCount",
      "op": "ge",
      "value": 50,
      "timeoutMs": 30000
    },
    {
      "type": "wait-ms",
      "ms": 1500
    },
    {
      "type": "key",
      "code": "SPACE",
      "action": "press"
    },
    {
      "type": "wait-ms",
      "ms": 250
    },
    {
      "type": "screenshot",
      "out": "screenshots/renderer_shoot"
    },
    {
      "type": "key",
      "code": "SPACE",
      "action": "press"
    },
    {
      "type": "wait-ms",
      "ms": 250
    },
    {
      "type": "assert",
      "query": "scene.nodeCount",
      "op": "ge",
      "value": 102
    },
    {
      "type": "quit"
    }
  ]
}

{
  "_comment": "NextRaiden 全局数值。取景与播放列的推导见 docs/projects/nextraiden/nextraiden-mvp-design.md 5.2。",
  "screen": {
    "_comment": "fieldOfView 是竖直视角：竖向取景由它决定，横向多出来的部分由 hudColumnFraction 两侧立柱盖住。cameraHeight 是整套尺度的唯一旋钮——它决定一块屏幕装下多少米世界，也就决定机体在屏幕上有多大。改它必须同步改所有'每秒多少米'和'多少米以内'的量，否则观感会整体走样。",
    "cameraHeight": 75.0,
    "cameraPitchDegrees": 15.0,
    "fieldOfView": 50.0,
    "nearPlane": 1.0,
    "farPlane": 600.0,
    "hudColumnFraction": 0.3
  },
  "playfield": {
    "_comment": "aheadLimit/behindLimit 是相对相机中心的 Z 偏移，前方是 -Z。halfWidth 决定播放列有几个机身宽——这是街机竖版射击手感的关键指标：5.5 m 的机体配 ±21 m 就是 7.6 个机身宽，和原版雷电同量级；早期的 ±13 只有 4.7 个，挤得没法走位。",
    "flightAltitude": 7.0,
    "halfWidth": 21.0,
    "aheadLimit": 16.0,
    "behindLimit": 24.0
  },
  "player": {
    "_comment": "hitRadius 远小于 5.5m 的机体宽度，这是街机手感的关键，不是笔误——而且它不随世界尺度缩放，因为变大的是世界不是机体。speed 乘的是 1.9 而不是世界尺度的 1.6：等比例只能保持原来的手感，而原来的手感就是偏慢。",
    "speed": 34.0,
    "slowScale": 0.5,
    "hitRadius": 0.6,
    "bankDegrees": 18.0,
    "bankRateDegrees": 140.0,
    "spawnBehind": 19.0
  },

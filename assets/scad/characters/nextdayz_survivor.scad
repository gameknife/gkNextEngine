// ============================================================================
// nextdayz_survivor.scad - Articulated rigid-body player for NextDayz 3C.
//
// ScadRig: 1 unit = 1 metre, Z-up, faces -Y, bone_root at ground. The
// character's RIGHT side is -X: the _r bones (firing hand, rear foot) sit at
// -X so the rifle shoulders on the same side the over-the-shoulder camera
// looks past.
//
// Every clip below is generated by rig_humanoid.scad from intent, not typed in
// as joint angles: gaits from cadence / speed / duty / bob / sway with the
// boots IK-planted on z = 0, weapon holds from a weapon frame in chest space
// with both arms IK-solved onto the grip and handguard. Tune the numbers in
// the dictionaries; the loader still sees ordinary anim_* data.
//
// Runtime contract (NextDayz PlayerRigVisual):
//   bone_ik_weapon      weapon frame (muzzle -Y), child of the torso. Hold
//                       clips animate it; the game re-solves the arms onto it
//                       every frame after adding aim pitch, sway and recoil.
//   bone_ik_hand_r/l    wrist frames on the grip / handguard (weapon space).
//   bone_weapon_socket  weapon attachment under the right hand; its bind is
//                       the inverse of the right grip, so a hand solved onto
//                       bone_ik_hand_r puts the weapon exactly on the frame.
// Locomotion is in-place; the Jolt character controller owns translation.
// ============================================================================

use <../lib/rig_humanoid.scad>

$fn = 8;

SKIN      = [0.72, 0.52, 0.38];
SHORTS    = [0.85, 0.85, 0.82];
HAIR      = [0.075, 0.055, 0.04];

// --- Skeleton ----------------------------------------------------------------
// Must match the bone_* translations below; the clip generators read it.

SKEL = rh_skeleton([
    ["pelvis_z", 0.94],
    ["hip", [0.105, 0, -0.08]],
    ["thigh", 0.44],
    ["calf", 0.42],
    ["heel", 0.085],
    ["ball", 0.21],
    ["torso_z", 0.02],
    ["shoulder", [0.235, 0, 0.48]],
    ["upperarm", 0.31],
    ["forearm", 0.29]
]);

// --- Weapon hold ---------------------------------------------------------------
// Weapon frame = the weapon model origin; muzzle -Y, top +Z. The rifle stock
// butt sits STOCK behind it. Holds are built from the shoulder pocket so the
// butt stays in the firing-side shoulder whatever the blade and pitch.

POCKET = [-0.14, -0.12, 0.42];
STOCK  = 0.34;

// Right wrist on the grip (inverse of the socket below) and left wrist under
// the handguard, both in weapon space.
GRIP_R = [[0, 0.0837, 0.0547], [-20, 0, 0]];
GRIP_L = [[0.045, -0.20, -0.075], [-160, -30, 0]];

// blade: torso yaw away from the target (right shoulder back), cancelled in
// the weapon frame so the muzzle stays on the body axis. pitch: + = muzzle down.
function nd_shoulder_hold(blade, pitch, pocket = POCKET, inward = 5) =
    let(e = [pitch, 0, blade + inward])
    [pocket - rh_mv(rh_m(e), [0, STOCK, 0]), e];

READY_BLADE = 20;
AIM_BLADE   = 30;
HOLD_READY  = nd_shoulder_hold(READY_BLADE, 14);
HOLD_AIM    = nd_shoulder_hold(AIM_BLADE, 0, [-0.13, -0.12, 0.47]);
HOLD_UP     = nd_shoulder_hold(AIM_BLADE, -38, [-0.13, -0.11, 0.48]);
HOLD_DOWN   = nd_shoulder_hold(AIM_BLADE, 38, [-0.13, -0.14, 0.44]);
// Sprint: rifle across the chest, muzzle up toward the support shoulder.
HOLD_SPRINT = [[0.0, -0.30, 0.30], [-50, 0, 45]];
// Lowered to the firing side, muzzle down (switching, traversal, looting).
HOLD_LOW    = [[-0.24, -0.22, 0.14], [68, 0, -18]];

RIG = [
    ["weapon_bind", HOLD_READY],
    ["grip_r", GRIP_R],
    ["grip_l", GRIP_L],
    ["pole_r", [-0.50, 0.08, 0.12]],
    ["pole_l", [0.45, -0.15, 0.08]]
];

// --- Parts -------------------------------------------------------------------

module part_pelvis()
{
    // The only permanent garment. Clothing hides covered body render parts,
    // never their bones, so removing trousers restores these white shorts.
    color(SHORTS) cube([0.35, 0.215, 0.22], center = true);
    color([0.65, 0.65, 0.63]) translate([0, 0, 0.085]) cube([0.355, 0.22, 0.025], center = true);
}

module part_torso()
{
    color(SKIN) hull()
    {
        translate([0, 0, 0.08]) cube([0.31, 0.19, 0.16], center = true);
        translate([0, 0, 0.38]) cube([0.39, 0.225, 0.22], center = true);
    }
}

module part_head()
{
    color(SKIN) translate([0, -0.005, 0.12]) cube([0.22, 0.22, 0.24], center = true);
    // Neck belongs to the head, so hiding the torso under a coat keeps it.
    color(SKIN) translate([0, 0, -0.10]) cylinder(h = 0.135, r = 0.065);
    color(SKIN) translate([0, -0.127, 0.11]) cube([0.045, 0.035, 0.055], center = true);
    color(HAIR) translate([0, 0.005, 0.23]) cube([0.225, 0.225, 0.04], center = true);
    for (s = [-1, 1])
        color([0.035, 0.035, 0.03]) translate([s * 0.052, -0.118, 0.155]) cube([0.025, 0.008, 0.015], center = true);
}

module part_upperarm()
{
    color(SKIN) translate([0, 0, -0.155]) cube([0.12, 0.13, 0.31], center = true);
}

module part_forearm()
{
    color(SKIN) translate([0, 0, -0.145]) cube([0.105, 0.115, 0.29], center = true);
}

module part_hand()
{
    color(SKIN) translate([0, -0.01, -0.06]) cube([0.105, 0.11, 0.12], center = true);
}

module part_thigh()
{
    color(SKIN) translate([0, 0, -0.22]) cube([0.16, 0.17, 0.44], center = true);
    color(SHORTS) translate([0, 0, -0.05]) cube([0.175, 0.185, 0.10], center = true);
}

module part_calf()
{
    color(SKIN) translate([0, 0, -0.21]) cube([0.135, 0.145, 0.42], center = true);
}

module part_foot()
{
    color(SKIN) translate([0, -0.07, 0.06]) cube([0.17, 0.31, 0.12], center = true);
}

// --- Bones -------------------------------------------------------------------

module bone_weapon_socket()
{
    // Empty on purpose: the runtime weapon hangs here. Local -Y is the muzzle.
}

module bone_ik_hand_r() {}
module bone_ik_hand_l() {}

module bone_ik_weapon()
{
    translate(GRIP_R[0]) rotate(GRIP_R[1]) bone_ik_hand_r();
    translate(GRIP_L[0]) rotate(GRIP_L[1]) bone_ik_hand_l();
}

module bone_hand_l() { part_hand(); }
module bone_hand_r()
{
    mirror([1, 0, 0]) part_hand();
    translate([0, -0.06, -0.08]) rotate([20, 0, 0]) bone_weapon_socket();
}

module bone_forearm_l()
{
    part_forearm();
    translate([0, 0, -0.29]) bone_hand_l();
}
module bone_forearm_r()
{
    mirror([1, 0, 0]) part_forearm();
    translate([0, 0, -0.29]) bone_hand_r();
}

module bone_upperarm_l()
{
    part_upperarm();
    translate([0, 0, -0.31]) bone_forearm_l();
}
module bone_upperarm_r()
{
    mirror([1, 0, 0]) part_upperarm();
    translate([0, 0, -0.31]) bone_forearm_r();
}

module bone_head() { part_head(); }

module bone_torso()
{
    part_torso();
    translate([0, 0, 0.58]) bone_head();
    translate([ 0.235, 0, 0.48]) bone_upperarm_l();
    translate([-0.235, 0, 0.48]) bone_upperarm_r();
    translate(HOLD_READY[0]) rotate(HOLD_READY[1]) bone_ik_weapon();
}

module bone_foot_l() { part_foot(); }
module bone_foot_r() { mirror([1, 0, 0]) part_foot(); }

module bone_calf_l()
{
    part_calf();
    translate([0, 0, -0.42]) bone_foot_l();
}
module bone_calf_r()
{
    mirror([1, 0, 0]) part_calf();
    translate([0, 0, -0.42]) bone_foot_r();
}

module bone_thigh_l()
{
    part_thigh();
    translate([0, 0, -0.44]) bone_calf_l();
}
module bone_thigh_r()
{
    mirror([1, 0, 0]) part_thigh();
    translate([0, 0, -0.44]) bone_calf_r();
}

module bone_pelvis()
{
    part_pelvis();
    translate([0, 0, 0.02]) bone_torso();
    translate([ 0.105, 0, -0.08]) bone_thigh_l();
    translate([-0.105, 0, -0.08]) bone_thigh_r();
}

module bone_root()
{
    translate([0, 0, 0.94]) bone_pelvis();
}

bone_root();

// --- Gaits ---------------------------------------------------------------------
// cycle/speed/duty fix the stride (stance sweep = speed * duty * cycle); the
// rest is body language. stride_bias shifts the sweep back so the boot lands
// under the knee and toes off far behind, as a real stride does.

GAIT_COMMON = [
    ["keys", 32], ["head_level", 0.85], ["gaze_pitch", -2]
];

GAIT_WALK = rh_gait_params(concat(GAIT_COMMON, [
    ["cycle", 0.84], ["speed", 1.8], ["duty", 0.60], ["stride_bias", 0.08],
    ["step_height", 0.09], ["lift_skew", 0.85], ["swing_tangent", 0.25], ["swing_out", 0.02],
    ["heel_strike", 14], ["heel_until", 0.18], ["toe_off", 42], ["toe_from", 0.55], ["swing_pitch", 14],
    ["width", 0.11], ["pelvis", [0, 0, -0.075]], ["bob", 0.016], ["bob_sign", 1], ["sway", 0.022],
    ["hip_pitch", 3], ["hip_yaw", 6], ["hip_roll", 3], ["strafe_turn", 35],
    ["torso_lean", 4], ["torso_bounce", 0.8], ["torso_counter", 1.3], ["strafe_lean", 3],
    ["arm_base", 6], ["arm_swing", 18], ["arm_out", 6], ["elbow_base", 20], ["elbow_swing", 15]
]));

GAIT_RUN = rh_gait_params(concat(GAIT_COMMON, [
    ["cycle", 0.68], ["speed", 4.2], ["duty", 0.33], ["stride_bias", 0.12],
    ["step_height", 0.17], ["lift_skew", 0.6], ["swing_tangent", 0.35], ["swing_out", 0.02],
    ["heel_strike", 6], ["heel_until", 0.10], ["toe_off", 58], ["toe_from", 0.45], ["swing_pitch", 35],
    ["width", 0.09], ["pelvis", [0, -0.02, -0.10]], ["bob", 0.032], ["bob_sign", -1], ["sway", 0.012],
    ["hip_pitch", 6], ["hip_yaw", 9], ["hip_roll", 4], ["strafe_turn", 45],
    ["torso_lean", 7], ["torso_bounce", 2], ["torso_counter", 1.3], ["strafe_lean", 6],
    ["arm_base", 10], ["arm_swing", 35], ["arm_out", 8], ["elbow_base", 75], ["elbow_swing", 25]
]));

GAIT_SPRINT = rh_gait_params(concat(GAIT_COMMON, [
    ["cycle", 0.58], ["speed", 7.6], ["duty", 0.24], ["stride_bias", 0.15],
    ["step_height", 0.24], ["lift_skew", 0.55], ["swing_tangent", 0.40], ["swing_out", 0.01],
    ["heel_strike", 0], ["heel_until", 0], ["toe_off", 62], ["toe_from", 0.40], ["swing_pitch", 45],
    ["width", 0.07], ["pelvis", [0, -0.04, -0.11]], ["bob", 0.04], ["bob_sign", -1], ["sway", 0.008],
    ["hip_pitch", 10], ["hip_yaw", 12], ["hip_roll", 3], ["strafe_turn", 50],
    ["torso_lean", 14], ["torso_bounce", 2.5], ["torso_counter", 1.3], ["strafe_lean", 8],
    ["arm_base", 12], ["arm_swing", 55], ["arm_out", 6], ["elbow_base", 90], ["elbow_swing", 20]
]));

GAIT_CROUCH = rh_gait_params(concat(GAIT_COMMON, [
    ["cycle", 0.80], ["speed", 1.55], ["duty", 0.62], ["stride_bias", 0.05],
    ["step_height", 0.07], ["lift_skew", 0.9], ["swing_tangent", 0.2], ["swing_out", 0.03],
    ["heel_strike", 8], ["heel_until", 0.15], ["toe_off", 35], ["toe_from", 0.6], ["swing_pitch", 10],
    ["width", 0.14], ["pelvis", [0, 0.08, -0.33]], ["bob", 0.012], ["bob_sign", 1], ["sway", 0.03],
    ["hip_pitch", 12], ["hip_yaw", 5], ["hip_roll", 2], ["strafe_turn", 35],
    ["torso_lean", 14], ["torso_bounce", 0.6], ["torso_counter", 1.3], ["strafe_lean", 3],
    ["arm_base", 18], ["arm_swing", 10], ["arm_out", 10], ["elbow_base", 45], ["elbow_swing", 10]
]));

anim_stand_walk_f = rh_gait_clip(SKEL, GAIT_WALK, 0);
anim_stand_walk_b = rh_gait_clip(SKEL, GAIT_WALK, 180);
anim_stand_walk_l = rh_gait_clip(SKEL, GAIT_WALK, 90);
anim_stand_walk_r = rh_gait_clip(SKEL, GAIT_WALK, -90);

anim_stand_run_f = rh_gait_clip(SKEL, GAIT_RUN, 0);
anim_stand_run_b = rh_gait_clip(SKEL, GAIT_RUN, 180);
anim_stand_run_l = rh_gait_clip(SKEL, GAIT_RUN, 90);
anim_stand_run_r = rh_gait_clip(SKEL, GAIT_RUN, -90);

anim_stand_sprint_f = rh_gait_clip(SKEL, GAIT_SPRINT, 0);
anim_stand_sprint_b = rh_gait_clip(SKEL, GAIT_SPRINT, 180);
anim_stand_sprint_l = rh_gait_clip(SKEL, GAIT_SPRINT, 90);
anim_stand_sprint_r = rh_gait_clip(SKEL, GAIT_SPRINT, -90);

anim_crouch_walk_f = rh_gait_clip(SKEL, GAIT_CROUCH, 0);
anim_crouch_walk_b = rh_gait_clip(SKEL, GAIT_CROUCH, 180);
anim_crouch_walk_l = rh_gait_clip(SKEL, GAIT_CROUCH, 90);
anim_crouch_walk_r = rh_gait_clip(SKEL, GAIT_CROUCH, -90);

// --- Stances -------------------------------------------------------------------
// Staggered fighting stance: support foot forward, firing foot back and turned
// out, knees soft, weight forward. A slow breath keeps it alive.

function nd_level_head(pelvisRot, torsoRot, gaze = [-2, 0, 0]) =
    [gaze[0] - (pelvisRot[0] + torsoRot[0]) * 0.85,
     gaze[1] - (pelvisRot[1] + torsoRot[1]) * 0.85,
     gaze[2] - (pelvisRot[2] + torsoRot[2]) * 0.85];

function nd_breath_key(base, phase, depth) =
    let(b = sin(360 * phase),
        pelvisPos = rh_get(base, "pelvis") + [0, 0, -0.006 * b * depth],
        pelvisRot = rh_get(base, "pelvis_rot"),
        torsoRot = rh_get(base, "torso") + [1.2 * b * depth, 0, 0.4 * b * depth])
    concat([["pelvis", pelvisPos], ["pelvis_rot", pelvisRot], ["torso", torsoRot],
            ["head", nd_level_head(pelvisRot, torsoRot)]], base);

function nd_breath_clip(base, cycle, depth) =
    rh_clip_from_poses(concat(rh_lower_bones(), [["bone_torso", "rot"], ["bone_head", "rot"]],
                              [["bone_upperarm_l", "rot"], ["bone_forearm_l", "rot"],
                               ["bone_upperarm_r", "rot"], ["bone_forearm_r", "rot"]]),
                       [for (i = [0 : 8]) cycle * i / 8],
                       [for (i = [0 : 8])
                           let(key = nd_breath_key(base, i / 8, depth))
                           concat(rh_lower_pose(SKEL, key), [rh_get(key, "torso"), rh_get(key, "head")],
                                  rh_get(base, "arms"))],
                       true);

STAND_BASE = [
    ["pelvis", [0, 0.02, -0.06]], ["pelvis_rot", [3, 0, -10]], ["torso", [5, 0, 8]],
    ["foot_l", [0.13, -0.08, 12, 0]], ["foot_r", [-0.15, 0.17, -28, 0]],
    ["arms", [[-8, -6, 0], [-22, 0, 0], [-6, 6, 0], [-18, 0, 0]]]
];

CROUCH_BASE = [
    ["pelvis", [0, 0.10, -0.40]], ["pelvis_rot", [10, 0, -12]], ["torso", [20, 0, 10]],
    ["foot_l", [0.14, -0.22, 14, 0]], ["foot_r", [-0.16, 0.20, -26, 42]],
    ["arms", [[-24, -10, 0], [-48, 0, 0], [-20, 10, 0], [-46, 0, 0]]]
];

anim_stand_idle  = nd_breath_clip(STAND_BASE, 3.2, 1.0);
anim_crouch_idle = nd_breath_clip(CROUCH_BASE, 2.8, 0.8);

// --- Weapon holds (upper body) -------------------------------------------------
// Torso/head carry the blade; layered additively over locomotion at runtime.

function nd_hold(weapon, blade, extra = []) =
    concat(extra, [["weapon", weapon], ["torso", [0, 0, -blade]], ["head", [0, 0, blade * 0.9]]]);

anim_weapon_ready     = rh_upper_clip(SKEL, RIG, [[0, nd_hold(HOLD_READY, READY_BLADE)]], true);
anim_aim_rifle_center = rh_upper_clip(SKEL, RIG, [[0, nd_hold(HOLD_AIM, AIM_BLADE,
                                                       [["head", [6, -8, AIM_BLADE * 0.9]]])]], true);
anim_aim_rifle_up     = rh_upper_clip(SKEL, RIG, [[0, nd_hold(HOLD_UP, AIM_BLADE,
                                                       [["torso", [-10, 0, -AIM_BLADE]],
                                                        ["head", [-14, -8, AIM_BLADE * 0.9]]])]], true);
anim_aim_rifle_down   = rh_upper_clip(SKEL, RIG, [[0, nd_hold(HOLD_DOWN, AIM_BLADE,
                                                       [["torso", [12, 0, -AIM_BLADE]],
                                                        ["head", [22, -8, AIM_BLADE * 0.9]]])]], true);
anim_weapon_sprint    = rh_upper_clip(SKEL, RIG, [[0, [["weapon", HOLD_SPRINT], ["torso", [0, 0, 6]],
                                                       ["head", [0, 0, -5]]]]], true);
anim_weapon_low       = rh_upper_clip(SKEL, RIG, [[0, [["weapon", HOLD_LOW], ["torso", [0, 0, -6]],
                                                       ["head", [0, 0, 5]]]]], true);

// Melee has its own relaxed carry, raised guard and committed attack. The
// support hand guards the chest for one-handed weapons; the axe uses both
// hands on its haft. Contact times are normalized (WeaponDefs.hpp).
function nd_melee_key(weapon, body = [0, 0, 0], twoHands = false) =
    let(guard = [[0.20, -0.23, 0.34], [-25, 0, -15]],
        guardLocal = rh_fx(rh_finv(rh_frame(weapon[0], weapon[1])), rh_frame(guard[0], guard[1])),
        support = twoHands ? [[0, -0.035, 0.015], [-160, 0, 0]] : [guardLocal[0], rh_e(guardLocal[1])])
    [["weapon", weapon], ["torso", body],
     ["head", [-body[0] * 0.6, -body[1] * 0.6, -body[2] * 0.8]],
     ["hand_l", support]];

KNIFE_LOW = [[-0.28, -0.18, 0.12], [55, 0, -12]];
KNIFE_GUARD = [[-0.27, -0.28, 0.34], [-12, 0, -15]];
BAR_LOW = [[-0.29, -0.18, 0.15], [60, 0, -12]];
BAR_GUARD = [[-0.28, -0.26, 0.34], [-65, 0, -25]];
AXE_LOW = [[-0.22, -0.26, 0.17], [45, 0, -12]];
AXE_GUARD = [[-0.22, -0.29, 0.36], [-55, 0, -15]];

anim_melee_knife_low = rh_upper_clip(SKEL, RIG, [[0, nd_melee_key(KNIFE_LOW)]], true);
anim_melee_knife_ready = rh_upper_clip(SKEL, RIG, [[0, nd_melee_key(KNIFE_GUARD, [0, 0, -12])]], true);
anim_melee_crowbar_low = rh_upper_clip(SKEL, RIG, [[0, nd_melee_key(BAR_LOW)]], true);
anim_melee_crowbar_ready = rh_upper_clip(SKEL, RIG, [[0, nd_melee_key(BAR_GUARD, [0, 0, -16])]], true);
anim_melee_axe_low = rh_upper_clip(SKEL, RIG, [[0, nd_melee_key(AXE_LOW, [0, 0, 0], true)]], true);
anim_melee_axe_ready = rh_upper_clip(SKEL, RIG, [[0, nd_melee_key(AXE_GUARD, [0, 0, -12], true)]], true);

// Knife: pull the elbow back, thrust forward, withdraw to guard.
anim_melee_knife_attack = rh_upper_clip(SKEL, RIG, [
    [0.00, nd_melee_key(KNIFE_GUARD, [0, 0, -12])],
    [0.23, nd_melee_key([[-0.32, -0.16, 0.34], [-5, 0, -28]], [-3, 0, -22])],
    [0.38, nd_melee_key([[-0.15, -0.50, 0.35], [0, 0, 8]], [8, 0, 12])],
    [0.54, nd_melee_key([[-0.12, -0.45, 0.28], [10, 0, 12]], [6, 0, 8])],
    [1.00, nd_melee_key(KNIFE_GUARD, [0, 0, -12])]
], false);

// Crowbar: shoulder-led horizontal sweep, with a visible follow-through.
anim_melee_crowbar_attack = rh_upper_clip(SKEL, RIG, [
    [0.00, nd_melee_key(BAR_GUARD, [0, 0, -16])],
    [0.25, nd_melee_key([[-0.34, -0.14, 0.40], [-85, 0, -55]], [-5, 0, -30])],
    [0.42, nd_melee_key([[-0.08, -0.43, 0.34], [-5, 0, 12]], [6, 0, 16])],
    [0.58, nd_melee_key([[0.06, -0.32, 0.25], [18, 0, 65]], [10, 0, 28])],
    [1.00, nd_melee_key(BAR_GUARD, [0, 0, -16])]
], false);

// Axe: lift above the shoulder, drive down, recover the heavy head.
anim_melee_axe_attack = rh_upper_clip(SKEL, RIG, [
    [0.00, nd_melee_key(AXE_GUARD, [0, 0, -12], true)],
    [0.26, nd_melee_key([[-0.24, -0.17, 0.51], [-115, 0, -25]], [-10, 0, -24], true)],
    [0.43, nd_melee_key([[-0.13, -0.45, 0.29], [15, 0, 10]], [12, 0, 12], true)],
    [0.59, nd_melee_key([[-0.04, -0.35, 0.16], [60, 0, 30]], [18, 0, 22], true)],
    [1.00, nd_melee_key(AXE_GUARD, [0, 0, -12], true)]
], false);

// Reload: cant the rifle, strip the magazine, fetch a fresh one from the
// support-side pouch, seat it, rack the bolt. Left wrist targets are in weapon
// space so the hand rides the rifle as it moves.
HOLD_RELOAD = [[-0.06, -0.40, 0.30], [-6, -32, 20]];
anim_reload_rifle = rh_upper_clip(SKEL, RIG, [
    [0.00, nd_hold(HOLD_READY, READY_BLADE)],
    [0.25, nd_hold(HOLD_RELOAD, 12, [["hand_l", [[0.06, -0.07, -0.20], [-150, -20, 0]]], ["head", [16, 0, 10]]])],
    [0.55, nd_hold(HOLD_RELOAD, 12, [["hand_l", [[0.10, -0.02, -0.40], [-170, -10, 0]]], ["head", [18, 0, 10]]])],
    [0.85, nd_hold(HOLD_RELOAD, 12, [["hand_l", [[0.22, 0.10, -0.32], [-170, 0, 20]]], ["head", [14, 0, 12]]])],
    [1.25, nd_hold(HOLD_RELOAD, 12, [["hand_l", [[0.08, -0.04, -0.34], [-160, -15, 0]]], ["head", [18, 0, 10]]])],
    [1.55, nd_hold([[-0.06, -0.40, 0.31], [-8, -32, 20]], 12,
                   [["hand_l", [[0.06, -0.06, -0.19], [-150, -20, 0]]], ["head", [16, 0, 10]]])],

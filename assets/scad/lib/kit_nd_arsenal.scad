// ---------------- SVT-40 托卡列夫半自动步枪 ----------------
// 辨识点：浅色桦木两截式枪托 + 带一排散热孔的上木护木 + 前段钢皮护罩（大方孔）+ 两道枪箍 +
// 枪管上方的导气筒 + 带护圈的高准星 + 六槽枪口制退器 + 右侧通条 + 10 发可拆弹匣 + 枪管上的弧形表尺。
function nd_SVT_BIRCH() = [0.50, 0.31, 0.15];

module nd_wpn_svt40_held()
{
    BZ = 0.066;
    nd_m_birch(nd_SVT_BIRCH())
    {
        // 半手枪式托颈 + 机匣座
        cw_wpn_slab(0.030, [[-0.076, 0.054], [-0.030, 0.060], [-0.012, 0.064], [0.046, 0.064], [0.046, 0.022],
                            [-0.020, 0.002], [-0.050, -0.006], [-0.076, -0.004]], 0.005);
        cw_wpn_slab(0.034, [[0.030, 0.064], [0.200, 0.066], [0.200, 0.036], [0.130, 0.030], [0.030, 0.022]], 0.004);
        // 托身：细托颈之后托底线陡降，托踵放宽
        difference()
        {
            hull()
            {
                cw_wpn_slab(0.030, [[-0.076, 0.054], [-0.064, 0.054], [-0.064, -0.004], [-0.076, -0.004]], 0.005);
                cw_wpn_slab(0.045, [[-0.438, 0.036], [-0.428, 0.037], [-0.428, -0.100], [-0.440, -0.102]], 0.007);
            }
            cw_blk(-0.260, -0.030, [0.060, 0.032, 0.010], 0, 0.004);   // 贯通背带孔
        }
        // 前托（圆底，到第一道枪箍）
        hull()
        {
            cw_wpn_slab(0.036, [[0.196, 0.066], [0.470, 0.068], [0.470, 0.050], [0.400, 0.046], [0.196, 0.034]], 0.004);
            cw_bore(0.200, 0.270, 0.0150, 0.050, 0, 0.0128, 20);
        }
        // 上木护木：盖住导气活塞杆
        hull()
        {
            cw_bore(0.205, 0.265, 0.0150, BZ + 0.006, 0, -1, 20);
            cw_blk(0.3375, 0.068, [0.033, 0.265, 0.004], 0, 0.001);
        }
    }
    // 上护木两侧的一排散热孔
    cw_m_hole() for (f = [0.240, 0.285, 0.330, 0.375, 0.420]) for (s = [-1, 1])
        cw_wf(f, BZ + 0.008, s * 0.0150) rotate([0, 90, 0]) cw_cyl(0.004, 0.0040, 10, -1, true);
    cw_m_blued()
    {
        // 短机匣 + 机匣尾 + 机匣顶的枪机盖导轨
        cw_side(0.030, [[-0.074, 0.040], [0.132, 0.040], [0.132, 0.084], [-0.040, 0.084], [-0.074, 0.074]]);
        cw_blk(-0.080, 0.064, [0.020, 0.012, 0.018], 0, 0.002);
        // 枪管（护罩之前露出的一段 + 全长）
        cw_bore(0.132, 0.640, 0.0096, BZ, 0, 0.0082, 20);
        // 枪管上的弧形表尺：座 + 表尺板 + 缺口（缺口底 z = 0.091，位于 f = 0.150）
        cw_side(0.024, [[0.138, BZ + 0.008], [0.200, BZ + 0.008], [0.200, 0.082], [0.150, 0.086], [0.138, 0.084]]);
        cw_side(0.014, [[0.144, 0.0855], [0.196, 0.083], [0.196, 0.0860], [0.146, 0.0895]]);
        for (s = [-1, 1]) cw_blk(0.150, 0.0925, [0.0040, 0.005, 0.005], s * 0.0040, 0.0005);
        // 两道枪箍
        for (f = [0.470, 0.600])
            hull()
            {
                cw_blk(f, 0.058, [0.040, 0.012, 0.040], 0, 0.003);
                cw_bore(f - 0.006, 0.012, 0.0190, BZ + 0.010, 0, -1, 20);
            }
        // 导气筒 + 调节器
        cw_bore(0.600, 0.100, 0.0085, 0.087, 0, -1, 16);
        cw_bore(0.690, 0.018, 0.0105, 0.087, 0, -1, 6);
        hull()
        {
            cw_bore(0.690, 0.020, 0.0115, BZ, 0, -1, 18);
            cw_bore(0.692, 0.016, 0.0090, 0.087, 0, -1, 16);
        }
        // 高准星座 + 护圈（准星尖 z = 0.091，f = 0.755）
        cw_bore(0.740, 0.026, 0.0110, BZ, 0, -1, 20);
        cw_side(0.010, [[0.742, BZ], [0.766, BZ], [0.763, 0.084], [0.746, 0.084]]);
        cw_lathe([[0.0098, 0.744], [0.0118, 0.744], [0.0118, 0.762], [0.0098, 0.762]], 0.090, 0, 20);
        // 六槽枪口制退器（尖端 f = 0.805）
        difference()
        {
            cw_bore(0.766, 0.039, 0.0125, BZ, 0, -1, 22);
            cw_bore(0.760, 0.060, 0.0050, BZ, 0, -1, 12);
            for (i = [0 : 2]) for (s = [-1, 1]) cw_blk(0.773 + i * 0.011, BZ, [0.012, 0.0048, 0.0090], s * 0.010, 0.0004);
        }
        // 10 发可拆弹匣 + 底板 + 扳机护圈
        cw_side(0.022, [[0.030, 0.040], [0.118, 0.040], [0.112, -0.050], [0.040, -0.054]]);
        for (z = [-0.030, -0.006, 0.018]) cw_side(0.0234, [[0.034, z + 0.004], [0.114, z + 0.004], [0.114, z], [0.034, z]]);
        cw_blk(0.076, -0.056, [0.025, 0.080, 0.006], 0, 0.0015);
        cw_side_hole(0.009, [[-0.034, -0.006], [0.030, 0.024], [0.032, -0.030], [0.004, -0.036], [-0.026, -0.022]],
                     [[-0.020, -0.008], [0.024, 0.014], [0.024, -0.023], [0.004, -0.027], [-0.015, -0.018]]);
        // 钢托底板
        cw_side(0.046, [[-0.439, 0.037], [-0.448, 0.036], [-0.450, -0.103], [-0.441, -0.103]]);
        // 背带环：挂在第一道枪箍下
        cw_wf(0.470, 0.031) rotate([0, 90, 0]) cw_torus(0.009, 0.0016, 12);
    }
    // 前段钢皮护罩：包住枪管与活塞，两侧大方孔
    cw_m_park() difference()
    {
        hull()
        {
            cw_bore(0.476, 0.124, 0.0170, BZ + 0.010, 0, -1, 20);
            cw_blk(0.538, 0.055, [0.030, 0.124, 0.004], 0, 0.001);
        }
        for (f = [0.500, 0.538, 0.576]) cw_blk(f, BZ + 0.006, [0.040, 0.024, 0.014], 0, 0.002);
        cw_bore(0.470, 0.140, 0.0110, BZ, 0, -1, 16);
    }
    cw_m_bright()
    {
        cw_wf(0.755, 0.080) cw_cyl(0.011, 0.0014, 8);                                 // 准星柱
        cw_bore(-0.050, 0.170, 0.0060, 0.080, 0, -1, 14);                            // 机匣顶露出的枪机框
        cw_rod_r(0.040, 0.074, -0.014, 0.032, 0.0040);                               // 右侧拉机柄
        cw_wf(0.040, 0.074, -0.048) cw_sph(0.0070, 14);
        cw_side(0.005, [[0.010, 0.010], [0.015, 0.010], [0.012, -0.012], [0.006, -0.018], [0.008, -0.004]]);   // 扳机
        cw_bore(0.210, 0.520, 0.0026, 0.046, -0.0190, -1, 8);                       // 右侧通条
        cw_bore(0.728, 0.008, 0.0040, 0.046, -0.0190, -1, 10);
    }
    cw_m_hole() cw_bore(0.796, 0.010, 0.0051, BZ, 0, -1, 12);
}

module nd_wpn_svt40(seed = 0) gk_flatten() cw_lay(0.1775, 0.0236) nd_wpn_svt40_held();

// ---------------- TOZ-34 上下双管猎枪 ----------------
// 辨识点：上下叠放的双管 + 两管之间的侧肋 + 通风瞄准肋（立柱 + 平条）+ 黄铜准星珠 + 高机匣（侧面压暗雕花面）
// + 尾部开闩扳手 + 两个击发指示销 + 双扳机 + 网纹半手枪握把胡桃木托 + 包住下管的网纹前托。
function nd_TOZ_WALNUT() = [0.33, 0.17, 0.075];

module nd_wpn_toz34_held()
{
    BL = 0.036;   // 下管
    BU = 0.060;   // 上管
    BR = 0.0118;
    cw_m_blued()
    {
        for (z = [BL, BU]) difference()
        {
            cw_bore(0.115, 0.670, BR, z, 0, BR * 0.92, 22);
            cw_bore(0.700, 0.100, 0.0093, z, 0, -1, 18);
        }
        for (s = [-1, 1]) cw_blk(0.450, (BL + BU) / 2, [0.004, 0.670, 0.012], s * 0.0080, 0.0008);   // 侧肋
        cw_blk(0.135, (BL + BU) / 2, [0.046, 0.040, 0.054], 0, 0.004);                 // 枪管后段（单体）
        // 通风瞄准肋：立柱 + 顶条（顶面 z = 0.0778）
        for (i = [0 : 12]) cw_blk(0.150 + i * 0.050, BU + BR + 0.0025, [0.005, 0.008, 0.005], 0, 0.0005);
        cw_blk(0.445, BU + BR + 0.0045, [0.0085, 0.660, 0.0030], 0, 0.0006);
        // 前托铁 + 扳机护圈
        cw_blk(0.160, 0.016, [0.036, 0.024, 0.010], 0, 0.002);
        cw_side(0.008, [[0.084, 0.014], [0.090, 0.014], [0.078, -0.018], [0.040, -0.026], [0.000, -0.021],
                        [-0.020, -0.004], [-0.014, 0.000], [0.002, -0.014], [0.040, -0.019], [0.072, -0.012]]);
        // 尾部开闩扳手（贴着机匣尾向右后偏，低于视线）+ 保险滑钮
        cw_wf(-0.004, 0.0760) rotate([0, 0, 28]) translate([-0.004, 0.014, 0]) cube([0.008, 0.026, 0.004], center = true);
        cw_blk(-0.034, 0.0745, [0.008, 0.014, 0.004], 0, 0.001);
    }
    // 机匣：高方盒，侧面压一圈边框，框内是压暗的雕花面
    cw_m_park() difference()
    {
        cw_side(0.046, [[0.000, 0.074], [0.115, 0.074], [0.115, 0.016], [0.030, 0.010], [0.000, 0.026]]);
        for (s = [-1, 1]) cw_side(0.004, [[0.018, 0.022], [0.104, 0.022], [0.104, 0.064], [0.018, 0.064]], s * 0.0242);
    }
    cw_m_etch() for (s = [-1, 1])
        cw_side(0.0012, [[0.020, 0.024], [0.102, 0.024], [0.102, 0.062], [0.020, 0.062]], s * 0.0224);
    cw_m_hole() for (z = [BL, BU]) cw_bore(0.700, 0.010, 0.0094, z, 0, -1, 18);
    cw_m_brass() cw_wf(0.772, BU + BR + 0.0080) cw_sph(0.0024, 12);                   // 黄铜准星珠
    cw_m_bright()
    {
        for (f = [0.036, 0.058])                                                       // 双扳机
            cw_side(0.0045, [[f, 0.012], [f + 0.005, 0.012], [f + 0.002, -0.006], [f - 0.004, -0.012], [f - 0.002, 0.000]]);
        for (s = [-1, 1]) cw_wf(-0.018, 0.0745, s * 0.007) cw_cyl(0.0035, 0.0018, 8);  // 击发指示销
    }
    nd_m_walnut(nd_TOZ_WALNUT())
    {
        // 半手枪握把段：凹形轮廓直接拉伸（hull 会把握把弧线填平）
        cw_side(0.038, [[0.004, 0.074], [-0.030, 0.066], [-0.070, 0.058], [-0.110, 0.054], [-0.110, -0.030], [-0.082, -0.040],
                        [-0.058, -0.066], [-0.036, -0.068], [-0.020, -0.046], [-0.008, -0.016], [0.004, 0.006]]);
        // 托身：托腮顺着视线向后下斜，托踵到托底明显放宽
        hull()
        {
            cw_wpn_slab(0.038, [[-0.108, 0.054], [-0.100, 0.0545], [-0.100, -0.030], [-0.108, -0.032]], 0.006);
            cw_wpn_slab(0.046, [[-0.400, 0.030], [-0.392, 0.031], [-0.392, -0.106], [-0.400, -0.108]], 0.007);
        }
        // 前托：包住下管，前端圆收
        hull()
        {
            cw_wpn_slab(0.044, [[0.140, 0.044], [0.352, 0.044], [0.360, 0.036], [0.352, 0.012], [0.140, 0.010]], 0.005);
            cw_bore(0.142, 0.212, 0.0190, BL - 0.006, 0, 0.0170, 20);
        }
    }
    cw_m_check([0.20, 0.10, 0.045])
    {
        for (s = [-1, 1])
        {
            cw_side(0.0012, [[-0.014, 0.030], [-0.050, 0.040], [-0.066, -0.028], [-0.030, -0.042]], s * 0.0201);   // 握把网纹
            cw_side(0.0012, [[0.190, 0.038], [0.320, 0.038], [0.320, 0.014], [0.190, 0.014]], s * 0.0221);        // 前托网纹
        }
    }
    cw_m_rubber([0.05, 0.045, 0.04]) cw_wpn_slab(0.0466, [[-0.400, 0.0265], [-0.418, 0.026], [-0.420, -0.110], [-0.400, -0.1125]], 0.0068);
}


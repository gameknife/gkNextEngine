// ---------------- APS 斯捷奇金 ----------------
// 与 PM 一样按真实尺寸建模再放大 1.5 倍。辨识点：比 PM 更长的方肩套筒 + 尾部鼓形可调照门 +
// 套筒左侧三位快慢机（保险 / 单发 / 连发）+ 加高握把（20 发双排弹匣）+ 握把后背的枪托卡槽 +
// 褐色胶木大网纹握片。
module nd_wpn_aps_held()
{
    scale(cw_PM_SCALE())
    {
        cw_m_blued() difference()
        {
            hull()
            {
                cw_bore(-0.046, 0.214, 0.0135, 0.036, 0, -1, 24);
                cw_wf(0.166, 0.036) cw_sph(0.0135, 24);
                cw_side(0.030, [[-0.046, 0.022], [0.176, 0.022], [0.176, 0.040], [-0.046, 0.040]]);
            }
            for (i = [0 : 11]) for (s = [-1, 1]) cw_blk(-0.042 + i * 0.0026, 0.036, [0.003, 0.0011, 0.022], s * 0.0152, 0);
            cw_blk(0.034, 0.041, [0.010, 0.034, 0.013], -0.0150, 0.001);   // 右侧抛壳窗
            cw_bore(0.168, 0.030, 0.0064, 0.036, 0, -1, 16);
        }
        cw_m_bright() cw_blk(0.034, 0.041, [0.004, 0.032, 0.011], -0.0110, 0.001);
        cw_m_blued() difference()
        {
            cw_bore(0.166, 0.016, 0.0062, 0.036, 0, -1, 16);
            cw_bore(0.160, 0.030, 0.0046, 0.036, 0, -1, 14);
        }
        cw_m_hole() cw_bore(0.177, 0.004, 0.0047, 0.036, 0, -1, 14);
        cw_m_blued()
        {
            // 准星片（尖 z = 0.054）+ 尾部鼓形照门（缺口底 z = 0.054，位于 f = -0.034）
            cw_side(0.0032, [[0.160, 0.047], [0.172, 0.047], [0.171, 0.054], [0.163, 0.054]]);
            cw_blk(-0.030, 0.0492, [0.018, 0.014, 0.004], 0, 0.001);
            cw_pin(-0.034, 0.0485, 0.0048, 0.020);
            for (s = [-1, 1]) cw_blk(-0.034, 0.0548, [0.0048, 0.006, 0.0040], s * 0.0045, 0.0005);
            // 枪身 + 扳机护圈
            cw_side(0.027, [[-0.048, 0.022], [0.176, 0.022], [0.176, 0.012], [0.080, 0.010], [0.004, 0.012], [-0.048, 0.014]]);
            cw_side_hole(0.008, [[0.066, 0.014], [0.068, 0.000], [0.060, -0.015], [0.042, -0.022], [0.012, -0.021],
                                 [0.004, -0.010], [0.004, 0.014]],
                         [[0.059, 0.008], [0.060, -0.002], [0.054, -0.012], [0.042, -0.016], [0.016, -0.015],
                          [0.011, -0.006], [0.011, 0.008]]);
            // 加高握把骨架（20 发双排弹匣）+ 枪托卡槽
            cw_side(0.024, [[0.004, 0.014], [-0.016, -0.086], [-0.048, -0.090], [-0.050, 0.022]]);
            cw_blk(-0.050, -0.040, [0.012, 0.006, 0.070], 0, 0.001);
            // 外露击锤
            hull()
            {
                cw_side(0.008, [[-0.046, 0.028], [-0.046, 0.040], [-0.051, 0.040], [-0.051, 0.028]]);
                cw_pin(-0.0525, 0.046, 0.0054, 0.008, 0, 16);
            }
            // 套筒左侧三位快慢机 + 空仓挂机柄
            cw_side(0.0022, [[-0.044, 0.042], [-0.020, 0.048], [-0.018, 0.044], [-0.042, 0.037]], 0.0162);
            cw_pin(-0.040, 0.040, 0.0040, 0.0334);
            cw_side(0.0022, [[0.038, 0.019], [0.062, 0.020], [0.062, 0.024], [0.040, 0.025]], 0.0146);
            cw_blk(-0.032, -0.0905, [0.026, 0.036, 0.006], 0, 0.0015);              // 弹匣底板
        }
        // 快慢机刻度点：白（保险）/ 红（单发 / 连发）
        cw_m_paint([0.80, 0.78, 0.72]) cw_pin(-0.030, 0.0465, 0.0012, 0.0012, 0.0158);
        cw_m_paint([0.72, 0.06, 0.04]) for (f = [-0.024, -0.018]) cw_pin(f, 0.0455, 0.0012, 0.0012, 0.0158);
        cw_m_bright() cw_side(0.0045, [[0.032, 0.010], [0.037, 0.010], [0.035, -0.004], [0.029, -0.010], [0.031, 0.000]]);
        // 褐色胶木握片 + 大面积方格网纹
        cw_m_bake([0.27, 0.10, 0.05]) hull()
        {
            cw_side(0.026, [[0.000, 0.012], [-0.017, -0.084], [-0.045, -0.087], [-0.044, 0.016]]);
            cw_side(0.031, [[-0.004, 0.006], [-0.019, -0.078], [-0.041, -0.081], [-0.040, 0.010]]);
        }
        cw_m_check([0.19, 0.07, 0.035]) for (s = [-1, 1])
            cw_side(0.0012, [[-0.010, -0.010], [-0.036, -0.010], [-0.042, -0.074], [-0.022, -0.074]], s * 0.0155);
        cw_m_bake([0.27, 0.10, 0.05]) for (s = [-1, 1]) cw_wf(-0.027, -0.042, s * 0.0161)
            rotate([0, 90, 0]) cw_cyl(0.0012, 0.0042, 14, -1, true);                  // 握片螺钉
        cw_m_bright() cw_wf(-0.049, -0.084) rotate([0, 90, 0]) cw_torus(0.0055, 0.0013, 12);   // 挂绳环
    }
}


// kit_nd_arsenal.scad —— NextDayz 有史可考的武器（参考 innawoods.net 的手绘图鉴挑选）
// AKS-74U / PP-19 野牛 / APS 斯捷奇金 / SVT-40 / TOZ-34。
//
// 坐标约定与 kit_coldwar.scad 的武器完全一致（这里直接复用它的材质与几何工具）：
//   nd_wpn_<id>_held()  手持坐标：原点 = 右手握把中心；枪口朝 -Y，顶面 +Z，+X 为武器左侧。
//                       侧视坐标写成 [f, z]：f = 朝枪口的前向距离（= -Y），z = 高度。
//   nd_wpn_<id>(seed)   地面 loot：右侧朝上平躺，枪口朝 +X，沿长度居中，贴 z = 0。
// 枪口 / 枪管轴 / 瞄准线 / 照门位置写在 WeaponDefs.hpp 的 WeaponModelPoints，改模型时同步；
// 每把枪必须是一个部件、不超过 16 种材质（gk_material 颜色 + 粗糙度 + 金属度各算一种）。
use <kit_coldwar.scad>

// ---- 额外材质 ----
module nd_m_poly(c = [0.065, 0.066, 0.07]) { gk_material(c, roughness = 0.78, metalness = 0) children(); }   // 黑色哑光聚合物
module nd_m_birch(c) { gk_material(c, roughness = 0.64, metalness = 0) gk_texture("woodgrain", scale = 0.22, seed = 2) children(); }                         // 油浸桦木（战时木托，缎面）
module nd_m_walnut(c) { gk_material(c, roughness = 0.40, metalness = 0) gk_texture("woodgrain", scale = 0.28, seed = 3) children(); }                        // 清漆胡桃木（民用猎枪）
module nd_m_worn() { gk_material([0.36, 0.36, 0.37], roughness = 0.38, metalness = 0.95) children(); }       // 磨掉发蓝的棱边

// 两点之间的倒角方杆（冲压钢折叠托的托杆）
module nd_strut(a, b, w, h) hull() { cw_blk(a[0], a[1], [w, 0.004, h], 0, 0.001); cw_blk(b[0], b[1], [w, 0.004, h], 0, 0.001); }

// AK 系冲压机匣 + 防尘盖 + 前机匣座（AKS-74U / 野牛共用）。coverEnd = 防尘盖前端。
module nd_ak_receiver(coverEnd = 0.150)
{
    cw_m_park() difference()
    {
        cw_wpn_slab(0.034, [[-0.086, 0.031], [0.205, 0.031], [0.205, 0.084], [-0.086, 0.084]], 0.0025);
        cw_blk(0.085, 0.072, [0.012, 0.070, 0.015], -0.017, 0.001);   // 右侧抛壳窗
    }
    cw_m_bright() cw_blk(0.085, 0.072, [0.004, 0.068, 0.012], -0.0118, 0.001);   // 窗内枪机框
    cw_m_blued()
    {
        cw_blk(0.189, 0.058, [0.037, 0.034, 0.054], 0, 0.004);                    // 前机匣座
        for (p = [[0.008, 0.037], [0.034, 0.037], [0.060, 0.037], [-0.040, 0.040], [-0.068, 0.040],
                  [0.176, 0.040]])
            cw_pin(p[0], p[1], 0.0024, 0.0364);
        hull()
        {
            cw_bore(-0.084, coverEnd + 0.084, 0.0168, 0.0815, 0, -1, 24);
            cw_blk((coverEnd - 0.084) / 2, 0.0835, [0.035, coverEnd + 0.084, 0.004], 0, 0.001);
        }
        for (f = [-0.060, -0.034, -0.008, 0.018]) cw_bore(f, 0.006, 0.0177, 0.0815, 0, -1, 24);
        cw_blk(-0.090, 0.082, [0.020, 0.010, 0.010], 0, 0.002);
        // 扳机护圈 + 弹匣卡笋
        cw_side(0.008, [[0.072, 0.031], [0.078, 0.031], [0.068, 0.006], [0.024, 0.003], [0.019, 0.010],
                        [0.064, 0.011]]);
        cw_blk(0.079, 0.025, [0.012, 0.007, 0.010], 0, 0.001);
        // 快慢机大拨片（右侧）
        cw_side(0.0022, [[-0.074, 0.074], [-0.064, 0.080], [0.070, 0.066], [0.073, 0.057], [0.063, 0.056],
                         [-0.066, 0.068]], -0.0182);
        cw_pin(-0.069, 0.073, 0.0055, 0.040);
    }
    cw_m_bright()
    {
        cw_side(0.005, [[0.046, 0.031], [0.051, 0.031], [0.047, 0.017], [0.040, 0.011], [0.042, 0.021]]);   // 扳机
        cw_rod_r(0.136, 0.074, -0.016, 0.022, 0.0042);                                                       // 拉机柄
        cw_wf(0.137, 0.074, -0.040) scale([1, 1.5, 1]) cw_sph(0.0062, 14);
    }
}

// AKS-74 系三角折叠托（展开）：上下两根冲压托杆 + 托底板 + 机匣尾铰链座
module nd_ak_folding_stock(butt = -0.392)
{
    cw_m_park()
    {
        cw_blk(-0.096, 0.056, [0.030, 0.020, 0.052], 0, 0.003);                   // 铰链座
        cw_pin(-0.100, 0.072, 0.0052, 0.036);                                     // 铰链轴（左侧凸起）
        nd_strut([-0.104, 0.074], [butt + 0.010, 0.050], 0.012, 0.010);           // 上托杆
        nd_strut([-0.104, 0.036], [butt + 0.010, -0.052], 0.012, 0.010);          // 下托杆
        cw_wpn_slab(0.036, [[butt + 0.012, 0.060], [butt, 0.060], [butt, -0.064], [butt + 0.012, -0.064]], 0.004);   // 托底板
    }
}

// ---------------- AKS-74U "克休哈" ----------------
// 辨识点：短枪管 + 锥形助推器（前端大圆筒 + 斜切）+ 导气箍与准星座合一 + 防尘盖前端铰链上的
// L 形翻转照门 + 短木护木 + 三角折叠托 + 胶木弧形弹匣。
module nd_wpn_aks74u_held()
{
    BZ = 0.068;
    MAG = cw_arc(7, 6, 4.6, 0.027, [0.115, 0.030]);
    nd_ak_receiver(0.152);
    nd_ak_folding_stock(-0.392);
    cw_m_blued()
    {
        // 防尘盖铰链座 + L 形翻转照门（两个照门片，竖起的一片带缺口）
        cw_blk(0.176, 0.091, [0.030, 0.034, 0.018], 0, 0.003);
        cw_blk(0.175, 0.1035, [0.016, 0.003, 0.0080], 0, 0.0004);
        for (s = [-1, 1]) cw_blk(0.175, 0.1095, [0.0045, 0.003, 0.0040], s * 0.0055, 0.0004);
        cw_blk(0.190, 0.1010, [0.016, 0.012, 0.0025], 0, 0.0004);                  // 放倒的远距照门片
        // 短枪管
        cw_bore(0.205, 0.215, 0.0102, BZ, 0, 0.0096, 20);
        // 导气箍与准星座合一：枪管箍 + 上方导气室 + 准星塔 + 护翼
        hull()
        {
            cw_bore(0.344, 0.052, 0.0135, BZ, 0, -1, 20);
            cw_bore(0.348, 0.044, 0.0112, 0.0885, 0, -1, 16);
        }
        cw_side(0.013, [[0.356, 0.096], [0.392, 0.096], [0.387, 0.1005], [0.361, 0.1005]]);
        for (s = [-1, 1]) cw_side(0.0026, [[0.363, 0.098], [0.384, 0.098], [0.382, 0.1135], [0.366, 0.1135]], s * 0.0066);
        cw_bore(0.208, 0.140, 0.0092, 0.0885, 0, -1, 16);                         // 导气管
        cw_bore(0.326, 0.014, 0.0236, 0.057, 0, -1, 22);                           // 护木前箍
        // 钢托底与机匣尾托板
        cw_blk(-0.094, 0.0815, [0.022, 0.020, 0.006], 0, 0.001);
    }
    cw_m_bright() cw_wf(0.372, 0.0995) cw_cyl(0.0080, 0.0015, 8);                // 准星柱，尖端 z = 0.1075
    // 锥形助推器：螺接段 + 扩张室（圆筒）+ 前端锥形收口
    cw_m_blued()
    {
        cw_lathe([[0.0085, 0.402], [0.0128, 0.402], [0.0128, 0.420], [0.0162, 0.428], [0.0162, 0.466],
                  [0.0128, 0.485], [0.0072, 0.485], [0.0072, 0.470], [0.0085, 0.470]], BZ, 0, 26);
        for (f = [0.436, 0.448]) cw_bore(f, 0.003, 0.0168, BZ, 0, -1, 26);      // 扩张室加强环
    }
    cw_m_hole() cw_bore(0.476, 0.010, 0.0070, BZ, 0, -1, 16);
    // 短木护木（层压木）：下护木 + 上护木
    cw_m_wood(cw_AK_WOOD())
    {
        difference()
        {
            hull()
            {
                cw_side(0.044, [[0.210, 0.078], [0.326, 0.078], [0.330, 0.060], [0.324, 0.046], [0.270, 0.039],
                                [0.222, 0.044], [0.210, 0.058]]);
                cw_bore(0.214, 0.112, 0.0195, 0.056, 0, -1, 20);
            }
            for (s = [-1, 1]) cw_blk(0.252, 0.059, [0.008, 0.040, 0.010], s * 0.0245, 0.002);
        }
        hull()
        {
            cw_bore(0.212, 0.120, 0.0150, 0.0895, 0, -1, 20);
            cw_blk(0.272, 0.081, [0.031, 0.120, 0.004], 0, 0.001);
        }
    }
    cw_m_bake(cw_AK_GRIP()) hull()
    {
        cw_side(0.025, [[0.018, 0.031], [-0.011, -0.066], [-0.040, -0.070], [-0.024, 0.031]]);
        cw_side(0.031, [[0.012, 0.024], [-0.010, -0.054], [-0.031, -0.057], [-0.018, 0.024]]);
    }
    cw_m_bake(cw_AK_PLUM())
    {
        for (i = [0 : 6]) hull() { cw_mag_slab(MAG[i], 0.062 + 0.0014 * i, 0.025); cw_mag_slab(MAG[i + 1], 0.0634 + 0.0014 * i, 0.025); }
        for (i = [1 : 2 : 5]) cw_mag_slab(MAG[i], 0.052, 0.0274, 0.004, 0.003);
    }
    cw_m_blued()
    {
        cw_mag_slab(MAG[0], 0.064, 0.0262, 0.006);
        cw_mag_slab(MAG[7], 0.074, 0.0268, 0.006);
    }
}

module nd_wpn_aks74u(seed = 0) gk_flatten() cw_lay(0.0465, 0.0236) nd_wpn_aks74u_held();

// ---------------- PP-19 "野牛-2" ----------------
// 辨识点：AKS-74 机匣 + 枪管下方的 64 发螺旋弹匣（同时当护木）+ 开孔枪管护罩 + 带护翼的高准星 +
// 开槽枪口 + 三角折叠托 + 黑色聚合物握把。
module nd_wpn_bizon_held()
{
    BZ = 0.068;
    MZ = 0.0275;   // 螺旋弹匣轴高
    nd_ak_receiver(0.150);
    nd_ak_folding_stock(-0.392);
    cw_m_blued()
    {
        // AK 式表尺座 + 表尺板 + 缺口（缺口底 z ≈ 0.106）
        cw_side(0.026, [[0.150, 0.084], [0.206, 0.084], [0.206, 0.097], [0.168, 0.099], [0.150, 0.097]]);
        cw_side(0.017, [[0.156, 0.098], [0.202, 0.099], [0.202, 0.102], [0.156, 0.104]]);
        for (s = [-1, 1]) cw_blk(0.165, 0.1075, [0.0048, 0.006, 0.006], s * 0.0046, 0.001);
        // 枪管 + 前端准星座（护翼）+ 开槽枪口
        cw_bore(0.205, 0.236, 0.0095, BZ, 0, 0.0090, 20);
        cw_bore(0.406, 0.034, 0.0125, BZ, 0, -1, 20);
        cw_side(0.012, [[0.410, BZ], [0.438, BZ], [0.434, 0.0965], [0.414, 0.0965]]);
        for (s = [-1, 1]) cw_side(0.0026, [[0.414, 0.090], [0.434, 0.090], [0.432, 0.1105], [0.416, 0.1105]], s * 0.0064);
        difference()
        {
            cw_bore(0.440, 0.030, 0.0118, BZ, 0, -1, 20);
            cw_bore(0.430, 0.050, 0.0050, BZ, 0, -1, 12);
            for (s = [-1, 1]) cw_blk(0.458, BZ, [0.010, 0.016, 0.0040], s * 0.011, 0.0005);
        }
        // 弹匣卡锁 + 前机匣下的弹匣座
        cw_blk(0.118, 0.040, [0.030, 0.016, 0.022], 0, 0.003);
    }
    cw_m_bright() cw_wf(0.425, 0.0955) cw_cyl(0.0105, 0.0015, 8);                // 准星柱，尖端 z = 0.106
    cw_m_hole() cw_bore(0.462, 0.010, 0.0050, BZ, 0, -1, 12);
    // 开孔冲压枪管护罩
    cw_m_park() difference()
    {
        hull()
        {
            cw_bore(0.205, 0.172, 0.0150, BZ + 0.004, 0, -1, 20);
            cw_blk(0.291, 0.064, [0.030, 0.172, 0.004], 0, 0.001);
        }
        for (f = [0.235, 0.275, 0.315, 0.350]) cw_blk(f, BZ + 0.006, [0.040, 0.020, 0.0085], 0, 0.002);
        cw_bore(0.200, 0.190, 0.0105, BZ, 0, -1, 16);
    }
    // 64 发螺旋弹匣：聚合物圆筒 + 螺旋筋 + 前端大端盖 + 后端卡榫座
    nd_m_poly()
    {
        cw_bore(0.122, 0.296, 0.0262, MZ, 0, -1, 28);
        for (i = [0 : 10]) cw_wf(0.140 + i * 0.024, MZ) rotate([90, 0, 0]) rotate([0, 10, 0]) cw_cyl(0.004, 0.0274, 28, -1, true);
        cw_lathe([[0, 0.412], [0.0282, 0.412], [0.0282, 0.436], [0.0240, 0.441], [0, 0.441]], MZ, 0, 28);
        cw_blk(0.130, 0.050, [0.026, 0.020, 0.012], 0, 0.003);
    }
    nd_m_poly([0.11, 0.11, 0.115]) for (i = [0 : 7]) cw_wf(0.414 + i * 0.003, MZ) rotate([90, 0, 0]) cw_cyl(0.0015, 0.0284, 28, -1, true);
    // 黑色聚合物握把
    nd_m_poly() hull()
    {
        cw_side(0.025, [[0.018, 0.031], [-0.011, -0.066], [-0.040, -0.070], [-0.024, 0.031]]);
        cw_side(0.031, [[0.012, 0.024], [-0.010, -0.054], [-0.031, -0.057], [-0.018, 0.024]]);
    }
}


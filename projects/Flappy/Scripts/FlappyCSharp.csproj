<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The C# half of the Flappy parity pair. Its job is to be a faithful translation of FlappyCpp,
    not idiomatic C#: where the two could differ, follow the C++.
  -->

  <PropertyGroup>
    <RootNamespace>Flappy</RootNamespace>
    <AssemblyName>FlappyCSharp</AssemblyName>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(GkEngineManagedRoot)GkNext.SourceGen\GkNext.SourceGen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(GkEngineManagedRoot)GkNext.Engine\GkNext.Engine.csproj">
      <!-- GkNext.Engine always resolves from the host's load context; copying it beside a
           reloadable assembly would risk a second copy and break type identity. -->
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

</Project>
